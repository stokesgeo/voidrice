[Default Applications]

# xdg-open will use these settings to determine how to open filetypes.
# These .desktop entries can also be seen and changed in ~/.local/share/applications/
# On OpenBSD, xdg-open (xdg-utils 1.2.1, a chromium dependency) finds each
# Exec program on PATH, so the entries name programs, not paths; it ignores
# Terminal=, so terminal programs go through xdg-terminal-exec ($TERMINAL).

text/x-shellscript=text.desktop;
x-scheme-handler/magnet=torrent.desktop;
application/x-bittorrent=torrent.desktop;
x-scheme-handler/mailto=mail.desktop;
text/plain=text.desktop;
application/postscript=pdf.desktop;
application/pdf=pdf.desktop;
image/png=img.desktop;
image/jpeg=img.desktop;
image/gif=img.desktop;
application/rss+xml=rss.desktop
video/x-matroska=video.desktop
video/mp4=video.desktop
inode/directory=file.desktop
