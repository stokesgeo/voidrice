# kshrc: interactive ksh(1), in place of voidrice's .zshrc. The profile sets ENV to it.

# [user@host dir]$ in the voidrice colours; \[ \] mark the escapes as zero-width.
PS1='\[\e[1;31m\][\[\e[33m\]\u\[\e[32m\]@\[\e[34m\]\h \[\e[35m\]\w\[\e[31m\]]\[\e[0m\]\$ '

set -o vi		# vi line editing; v in command mode opens $VISUAL
set -o vi-tabcomplete	# Tab completes in insert mode too
stty stop undef		# free ctrl-s from freezing the terminal
HISTSIZE=10000		# the profile exports HISTFILE

for f in shortcutrc shortcutenvrc aliasrc; do
	[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/$f" ] &&
		. "${XDG_CONFIG_HOME:-$HOME/.config}/shell/$f"
done
unset f

# lfcd: browse with lf, and cd to the directory lf was in when it quit.
lfcd() {
	typeset tmp dir
	tmp=$(mktemp) || return
	lf -last-dir-path="$tmp" "$@"
	dir=$(<"$tmp")
	rm -f "$tmp"
	[ -d "$dir" ] && [ "$dir" != "$PWD" ] && cd "$dir"
}

# config: git for the dotfiles, a bare repo with $HOME as the work tree.
# The bare clone has no fetch refspec: update with `config pull origin master`.
# Add files by name, never `config add .` from $HOME.
config() { git --git-dir="$HOME/.local/share/vertrice.git" --work-tree="$HOME" "$@"; }

