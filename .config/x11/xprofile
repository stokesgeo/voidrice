#!/bin/sh

# This file runs when a DM logs you into a graphical session.
# If you use startx/xinit like a Chad, this file will also be sourced.

xrandr --dpi 96		# Set DPI. User may want to use a larger number for larger screens.
setbg &			# set the background with the `setbg` script
xrdb ${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources & xrdbpid=$!	# xterm, the default terminal, reads its font and colors from here

# Sound is sndiod(8), a system daemon started by rc(8), so nothing to start here.
autostart="mpd xcompmgr dunst unclutter"

for program in $autostart; do
	pgrep -x "$program" >/dev/null || "$program" &
done >/dev/null 2>&1

# Key remaps, once. Linux used remapd to redo them when a USB keyboard was
# plugged in (via udevadm); OpenBSD has no udev. Run `remaps` again by hand.
remaps &

# Lock after 10 idle minutes: xidle(1), from base, runs xlock (mode blank,
# set in xresources).
pgrep -x xidle >/dev/null || xidle -timeout 600 &

# USB drives: turn the root-side hotplugd note into a notification.
hotplug-watch &

# Backups: a notice when the newest dump of /home is older than BK_DAYS
# (7) days. It reads one small file; no daemon. See `bk` and OPENBSD.md.
bk remind &

# Ensure that xrdb has finished running before moving on to start the WM/DE.
[ -n "$xrdbpid" ] && wait "$xrdbpid"

# Day/night palette, after xresources is loaded so the palette merges on
# top: day from 07:00, night from 19:00; Super+F8 flips it by hand.
theme clock &

# A new session starts with a neutral screen, so nightlight's toggle state
# starts off as well.
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/nightlight"
