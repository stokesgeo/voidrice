#!/bin/sh

# This file runs when a DM logs you into a graphical session.
# If you use startx/xinit like a Chad, this file will also be sourced.

xrandr --dpi 96		# Set DPI. User may want to use a larger number for larger screens.
# Load the base first: setbg's wal path may merge its palette afterwards.
xrdb "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources"
setbg &			# set the background with the `setbg` script

autostart="mpd dunst unclutter"	# sound is sndiod, started by rc(8); no compositor, no transparency

for program in $autostart; do
	pgrep -x "$program" >/dev/null || "$program" &
done >/dev/null 2>&1

remaps &			# once: OpenBSD has no udev to redo it on a new keyboard
pgrep -x xidle >/dev/null || xidle -timeout 600 &	# lock after 10 idle minutes
hotplug-watch & hotplugpid=$!	# a notice when a USB drive is attached
# Backup reminder: dump(8) -w lists file systems due for a dump.
dump -w 2>/dev/null | grep -q /home && notify-send "💾 Backup due." "Mount the backup disk (Super+F9), then bk incr." &
rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/nightlight"	# the screen starts neutral

# Set the palette before the first terminal; the clock handles later changes.
[ "$PALETTE" = wal ] || theme auto
theme clock & themepid=$!
