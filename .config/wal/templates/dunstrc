# Colours only; `theme wal` puts this after dunstrc (dunstrc.d/theme.conf).
[urgency_low]
    background = "{color0}"
    foreground = "{color8}"

[urgency_normal]
    background = "{color4}"
    foreground = "{color15}"

[urgency_critical]
    background = "{color1}"
    foreground = "{color15}"
    frame_color = "{color11}"
