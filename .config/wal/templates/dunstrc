# pywal fills this in as ~/.cache/wal/dunstrc; `theme wal` copies it to
# ~/.config/dunst/dunstrc.d/theme.conf, which dunst reads after dunstrc.
# Only the colours: size, font and frames stay in dunstrc.
[urgency_low]
    background = "{color0}"
    foreground = "{color8}"

[urgency_normal]
    background = "{color4}"
    foreground = "{color15}"

[urgency_critical]
    background = "{color1}"
    foreground = "{color15}"
    frame_color = "{color11}"
