[global]
    monitor = 0
    follow = keyboard
    width = 370
    height = (0,350)
    offset = (0,19)
    padding = 6
    horizontal_padding = 8
    transparency = 0
    frame_width = 3
    font = IBM Plex Mono 10
    format = "<b>%s</b>\n%b"

# Framed in cwm's border colours. `theme` puts the current palette's
# colours in dunstrc.d/theme.conf, read after this file.
[urgency_low]
    background = "#24232e"
    foreground = "#c7c0b4"
    frame_color = "#4a64b0"
    timeout = 3

[urgency_normal]
    background = "#24232e"
    foreground = "#dcd6ca"
    frame_color = "#8b0000"
    timeout = 5

[urgency_critical]
    background = "#24232e"
    foreground = "#f1ece2"
    frame_color = "#e3c98d"
    timeout = 10
