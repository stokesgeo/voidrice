#!/bin/sh

# run COMMAND...: run COMMAND, a line of shell, after the login profile.
# aerospace.toml's keys and the bar start programs through this: macOS
# starts AeroSpace, not a login shell, so without it they would lack the
# profile's PATH and default programs ($TERMINAL, $BROWSER).

. "$HOME/.profile" >/dev/null 2>&1
eval "$*"
