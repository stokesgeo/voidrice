bind-key 4-g		group-rcycle
bind-key 4-semicolon	group-cycle
bind-key 4-Prior	group-rcycle
bind-key 4-Next		group-cycle

# --- launchers ----------------------------------------------------------
bind-key 4-Return	"sh -c 'exec $TERMINAL'"
bind-key 4S-Return	"scratch term"
bind-key 4-apostrophe	"scratch calc"
bind-key 4-d		menu-exec
bind-key 4S-d		passmenu
bind-key 4-w		"sh -c 'exec $BROWSER'"
bind-key 4S-w		chromium
bind-key 4-e		"sh -c '$TERMINAL -e neomutt; sb-refresh'"
bind-key 4S-e		"sh -c 'exec $TERMINAL -e abook'"
bind-key 4-r		"sh -c 'exec $TERMINAL -e lfub'"
bind-key 4S-r		"sh -c 'exec $TERMINAL -e top'"
bind-key 4-c		"sh -c 'exec $TERMINAL -e profanity'"
bind-key 4-n		"sh -c 'exec $TERMINAL -e nvim -c VimwikiIndex'"
bind-key 4S-n		"sh -c '$TERMINAL -e newsboat; sb-refresh'"
bind-key 4-m		"sh -c 'exec $TERMINAL -e ncmpcpp'"
