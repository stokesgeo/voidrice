bind-key 4-BackSpace	sysact
bind-key 4S-q		sysact
bind-key 4S-BackSpace	sysact

# --- music and volume (mpd, sndio) ---------------------------------------
bind-key 4-p		"mpc toggle"
bind-key 4S-p		"sh -c 'mpc pause; pauseallmpv'"
bind-key 4-bracketleft	"mpc seek -10"
bind-key 4S-bracketleft	"mpc seek -60"
bind-key 4-bracketright	"mpc seek +10"
bind-key 4S-bracketright "mpc seek +60"
bind-key 4-comma	"mpc prev"
bind-key 4S-comma	"mpc seek 0%"
bind-key 4-period	"mpc next"
bind-key 4S-period	"mpc repeat"
bind-key 4-minus	"sh -c 'sndioctl -q output.level=-0.05; sb-refresh'"
bind-key 4S-minus	"sh -c 'sndioctl -q output.level=-0.15; sb-refresh'"
bind-key 4-equal	"sh -c 'sndioctl -q output.level=+0.05; sb-refresh'"
bind-key 4S-equal	"sh -c 'sndioctl -q output.level=+0.15; sb-refresh'"
bind-key 4S-m		"sh -c 'sndioctl -q output.mute=!; sb-refresh'"

# --- function keys, screenshots, recording ----------------------------------
