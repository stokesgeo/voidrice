# cwmrc: voidrice's dwm keys on cwm(1), OpenBSD's window manager in base.
# xinitrc starts `cwm -c` on this file. See cwmrc(5); OPENBSD.md has the
# table of dwm keys and what each became here.
#
# How the dwm habits carry over:
# - Tags are cwm groups. sticky mode puts each new window in the group
#   you are looking at, as dwm puts it on the current tag.
# - cwm floats by default and tiles on request: window-vtile makes the
#   focused window the master on the left and stacks the others in its
#   group on the right (dwm's tile); window-htile puts the master on top
#   (bstack). Press it again after opening or closing a window.
# - Super is the only modifier used, so application shortcuts on Alt and
#   Control stay free (cwm's defaults use both).

sticky yes
vtile 55			# dwm mfact 0.55
htile 55
# fvwm's look, as OpenBSD ships it (xenocara system.fvwmrc): thick 7-pixel
# frames, dark red and blue, grey menus. Here the focused window is red and
# the rest blue (fvwm itself has it the other way round). The blue is fvwm's
# pure X11 blue, softened. Borders are fixed: they read in day and night.
borderwidth 7
color activeborder "#8b0000"
color inactiveborder "#4a64b0"
color groupborder "#e3c98d"
color ungroupborder "#908b9f"
color urgencyborder "#e89c9c"
color menubg "#bebebe"
color menufg "#8b0000"
color font "#1c1c1c"
color selfont "#f5f1e8"
fontname "IBM Plex Mono:size=10"
snapdist 4

# Scratchpads belong to no group, so they show on every group.
# autogroup matches the class, or "instance,class": xterm's class is XTerm,
# st's is St.
autogroup 0 "spterm,XTerm"
autogroup 0 "spcalc,XTerm"
autogroup 0 "spterm,St"
autogroup 0 "spcalc,St"

unbind-key all

# --- windows: focus, close, tile ---------------------------------------
bind-key 4-j		window-cycle-ingroup
bind-key 4-k		window-rcycle-ingroup
bind-key 4-q		window-close
bind-key 4-t		window-vtile
bind-key 4S-t		window-htile
bind-key 4-space	window-vtile		# dwm zoom: focused window to master
bind-key 4-f		window-fullscreen
bind-key 4S-u		window-maximize		# dwm monocle, one window
bind-key 4-h		window-resize-left-big	# dwm mfact: master narrower
bind-key 4-l		window-resize-right-big	# dwm mfact: master wider
bind-key 4S-h		window-move-left-big
bind-key 4S-j		window-move-down-big
bind-key 4S-k		window-move-up-big
bind-key 4S-l		window-move-right-big
bind-key 4C-h		window-resize-left
bind-key 4C-j		window-resize-down
bind-key 4C-k		window-resize-up
bind-key 4C-l		window-resize-right
bind-key 4-s		window-stick		# dwm togglesticky
bind-key 4S-0		window-stick		# dwm tag all: on every group

