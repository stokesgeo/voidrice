# cwmrc(5): appearance, then the key map. Key names: 4 = Super, S = Shift,
# C = Control. Super+F1 lists every bind. Super+F5 rereads this file.
#
# Pattern: Super+key acts; Super+Shift+key is its bigger or opposite form;
# Super+Control+key adjusts finely or toggles. Windows float; Super+t tiles.

# --- appearance ---------------------------------------------------------

sticky yes
vtile 55			# master window takes 55% of the screen
htile 55
borderwidth 7			# thick frames: red focused, blue not
color activeborder "#8b0000"
color inactiveborder "#4a64b0"
color groupborder "#e3c98d"
color ungroupborder "#908b9f"
color urgencyborder "#e89c9c"
color menubg "#bebebe"
color menufg "#8b0000"
color font "#1c1c1c"
color selfont "#f5f1e8"
fontname "IBM Plex Mono:size=10"
snapdist 4

autogroup 0 "spterm,XTerm"	# scratchpads (`scratch`) show on every group
autogroup 0 "spcalc,XTerm"

# Clear cwm's default keys: every key below is set here.
unbind-key all

# --- windows: j k focus, q close, t tile, h l resize, S+hjkl move --------
bind-key 4-j		window-cycle-ingroup
bind-key 4-k		window-rcycle-ingroup
bind-key 4-q		window-close
bind-key 4-t		window-vtile
bind-key 4S-t		window-htile
bind-key 4-space	window-vtile		# focused window becomes master
bind-key 4-f		window-fullscreen
bind-key 4S-u		window-maximize		# fill the screen, borders kept
bind-key 4-h		window-resize-left-big
bind-key 4-l		window-resize-right-big
bind-key 4S-h		window-move-left-big
bind-key 4S-j		window-move-down-big
bind-key 4S-k		window-move-up-big
bind-key 4S-l		window-move-right-big
bind-key 4C-h		window-resize-left
bind-key 4C-j		window-resize-down
bind-key 4C-k		window-resize-up
bind-key 4C-l		window-resize-right
bind-key 4-s		window-stick		# show on every group
bind-key 4S-0		window-stick

# --- groups: 1-9 show one, S+1-9 send window there, C+1-9 add or drop ----
# 0 shows all groups. Tab and \ go to the last group; g ; PgUp PgDn cycle.
bind-key 4-1		group-only-1
bind-key 4-2		group-only-2
bind-key 4-3		group-only-3
bind-key 4-4		group-only-4
bind-key 4-5		group-only-5
bind-key 4-6		group-only-6
bind-key 4-7		group-only-7
bind-key 4-8		group-only-8
bind-key 4-9		group-only-9
bind-key 4S-1		window-movetogroup-1
bind-key 4S-2		window-movetogroup-2
bind-key 4S-3		window-movetogroup-3
bind-key 4S-4		window-movetogroup-4
bind-key 4S-5		window-movetogroup-5
bind-key 4S-6		window-movetogroup-6
bind-key 4S-7		window-movetogroup-7
bind-key 4S-8		window-movetogroup-8
bind-key 4S-9		window-movetogroup-9
bind-key 4C-1		group-toggle-1
bind-key 4C-2		group-toggle-2
bind-key 4C-3		group-toggle-3
bind-key 4C-4		group-toggle-4
bind-key 4C-5		group-toggle-5
bind-key 4C-6		group-toggle-6
bind-key 4C-7		group-toggle-7
bind-key 4C-8		group-toggle-8
bind-key 4C-9		group-toggle-9
bind-key 4-0		group-toggle-all
bind-key 4-Tab		group-last
bind-key 4-backslash	group-last
bind-key 4-g		group-rcycle
bind-key 4-semicolon	group-cycle
bind-key 4-Prior	group-rcycle
bind-key 4-Next		group-cycle

# --- launchers: Return terminal, w web, e mail, r files, d run menu ------
# BackSpace and S+q open the power menu (sysact). Shifted keys are variants.
bind-key 4-Return	sd	# a terminal in the focused window's folder
bind-key 4S-Return	"scratch term"
bind-key 4-apostrophe	"scratch calc"
bind-key 4-d		menu-exec
bind-key 4S-d		passmenu
bind-key 4-w		"sh -c 'exec $BROWSER'"
bind-key 4S-w		chromium
bind-key 4-e		"sh -c '$TERMINAL -e neomutt; sb-refresh'"
bind-key 4S-e		"sh -c 'exec $TERMINAL -e abook'"
bind-key 4-r		"sh -c 'exec $TERMINAL -e lfub'"
bind-key 4S-r		"sh -c 'exec $TERMINAL -e top'"
bind-key 4-c		"sh -c 'exec $TERMINAL -e profanity'"
bind-key 4-n		"sh -c 'exec $TERMINAL -e nvim -c VimwikiIndex'"
bind-key 4S-n		"sh -c '$TERMINAL -e newsboat; sb-refresh'"
bind-key 4-m		"sh -c 'exec $TERMINAL -e ncmpcpp'"
bind-key 4-b		sb-show			# cwm has no bar: show the status as a notice
bind-key 4-grave	dmenuunicode
bind-key 4-BackSpace	sysact
bind-key 4S-q		sysact
bind-key 4S-BackSpace	sysact

# --- music and volume: p pause, [ ] seek, , . track, - = volume, S+m mute ---
# mpd plays; sndio sets the volume. Shift takes the larger step.
bind-key 4-p		"mpc toggle"
bind-key 4S-p		"sh -c 'mpc pause; pauseallmpv'"
bind-key 4-bracketleft	"mpc seek -10"
bind-key 4S-bracketleft	"mpc seek -60"
bind-key 4-bracketright	"mpc seek +10"
bind-key 4S-bracketright "mpc seek +60"
bind-key 4-comma	"mpc prev"
bind-key 4S-comma	"mpc seek 0%"
bind-key 4-period	"mpc next"
bind-key 4S-period	"mpc repeat"
bind-key 4-minus	"sh -c 'sndioctl -q output.level=-0.05; sb-refresh'"
bind-key 4S-minus	"sh -c 'sndioctl -q output.level=-0.15; sb-refresh'"
bind-key 4-equal	"sh -c 'sndioctl -q output.level=+0.05; sb-refresh'"
bind-key 4S-equal	"sh -c 'sndioctl -q output.level=+0.15; sb-refresh'"
bind-key 4S-m		"sh -c 'sndioctl -q output.mute=!; sb-refresh'"

# --- function keys: help, display, theme, mounts, camera, then Print ----
# Print takes a screenshot; Super+Print records the screen.
bind-key 4-F1		"sh -c 'grep ^bind ~/.config/cwm/cwmrc | dmenu -i -l 40 -p Keys:'"
bind-key 4S-F1		manpick			# any manual page, picked in dmenu
bind-key 4-F2		tutorialvids
bind-key 4S-F2		writemode		# full-screen writing, nvim in Goyo
bind-key 4-F3		displayselect
bind-key 4-F4		nightlight		# warm screen on/off (sct)
bind-key 4-F5		restart			# reread this file
bind-key 4-F6		torwrap
bind-key 4-F7		td-toggle
bind-key 4-F8		"theme toggle"		# day / night palette
bind-key 4-F9		"sh -c 'exec $TERMINAL -e mounter'"
bind-key 4-F10		"sh -c 'exec $TERMINAL -e unmounter'"
bind-key 4-F11		video			# webcam view, base video(1)
bind-key 4C-F11		"sh -c 'exec $TERMINAL -e rectoggle'"	# microphone and camera on/off
bind-key 4S-F11		dmenuwifi		# join a wireless network
bind-key 4-F12		remaps			# key and TrackPoint settings again
bind-key Print		"sh -c 'maim pic-full-$(date +%y%m%d-%H%M-%S).png'"
bind-key S-Print	maimpick
bind-key 4-Print	dmenurecord
bind-key 4S-Print	"dmenurecord kill"
bind-key 4-Delete	"dmenurecord kill"

# Mouse: on the desktop, buttons 1 2 3 open the window, group and command
# menus. Super+drag moves a window; Super+right-drag resizes it.
unbind-mouse all
bind-mouse 1		menu-window
bind-mouse 2		menu-group
bind-mouse 3		menu-cmd
bind-mouse 4-1		window-move
bind-mouse 4-3		window-resize
