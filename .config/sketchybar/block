#!/bin/sh

# block: an item of the bar (sketchybarrc), named after its status block.
# SketchyBar runs this every 5 seconds and on a click or scroll: the
# block's line becomes the label, and an empty line hides the item.
# A click or scroll becomes $BLOCK_BUTTON as the blocks read it (see
# sbar): 1 left, 2 middle, 3 right, 4 and 5 scroll, 6 shift click.

case $SENDER in
mouse.clicked)
	case $BUTTON,$MODIFIER in
	left,*shift*)	BLOCK_BUTTON=6 ;;
	left,*)		BLOCK_BUTTON=1 ;;
	right,*)	BLOCK_BUTTON=3 ;;
	*)		BLOCK_BUTTON=2 ;;
	esac ;;
mouse.scrolled)
	[ "${SCROLL_DELTA:-0}" -gt 0 ] && BLOCK_BUTTON=4 || BLOCK_BUTTON=5 ;;
esac
export BLOCK_BUTTON

line=$("$NAME" 2>/dev/null | sed 1q)
if [ -n "$line" ]; then
	sketchybar --set "$NAME" drawing=on label="$line"
else
	sketchybar --set "$NAME" drawing=off
fi
