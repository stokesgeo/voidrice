#!/bin/sh

# This script is called on startup to remap keys.
# Decrease key repeat delay to 300ms and increase key repeat rate to 50 per second.
xset r rate 300 50
# Map the caps lock key to super, and map the menu key to right super.
setxkbmap -option caps:super,altwin:menu_win
# When caps lock is pressed only once, treat it as escape.
pkill -x xcape 2>/dev/null ; xcape -e 'Super_L=Escape'
# Turn off caps lock if on since there is no longer a key for it.
xset -q | grep -q "Caps Lock:[[:space:]]*on" && xdotool key Caps_Lock

# TrackPoint scrolling: hold the middle button and push the stick. X reads
# the TrackPoint through the wsmouse mux, "/dev/wsmouse" (a touchpad gets
# its own /dev/wsmouseN device). The ws(4) driver emulates
# a wheel: while button 2 is held, motion becomes buttons 4/5 (up/down)
# and 6/7 (left/right); the axes list is x-left x-right y-up y-down.
# A press shorter than the timeout (200 ms, the driver's default) is still
# a middle click, so paste keeps working. Property names are from xenocara's
# xf86-input-ws include/ws-properties.h. A USB mouse on the mux gets the
# same behaviour, which is harmless.
tp="/dev/wsmouse"
xinput set-prop "$tp" "WS Pointer Wheel Emulation" 1 &&
xinput set-prop "$tp" "WS Pointer Wheel Emulation Button" 2 &&
xinput set-prop "$tp" "WS Pointer Wheel Emulation Axes" 6 7 4 5 &&
xinput set-prop "$tp" "WS Pointer Wheel Emulation Timeout" 200
