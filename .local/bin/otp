#!/bin/sh

# Get a one-time password, or add a OTP secret to your pass-otp store.

# The assumption of this script is that all otp passwords are stored with the
# suffix `-otp`. This script automatically appends newly added otps as such.

# For OTP passwords to be generated properly, it is important for the local
# computer to have its time properly synced. On OpenBSD, ntpd(8) in base does
# this; the sync-time entry shows its status.

ifinstalled pass pass-otp || exit 1

dir="${PASSWORD_STORE_DIR}"

choice="$({ echo "🆕add" ; echo "🕙sync-time" ; find "$dir" -type f -iname '*-otp.gpg' ;} | sed "s|^$dir/||;s|-otp.gpg$||" | dmenu -p "Pick a 2FA:")"

case $choice in
	🆕add )
		ifinstalled maim zbar xclip || exit 1

		# BSD mktemp has no --suffix, and maim picks the format from the
		# extension, so make a private directory and name the file in it.
		# rm -P overwrites the files before unlinking (GNU shred's job).
		tmpd=$(mktemp -d) || exit 1
		temp="$tmpd/qr.png"
		otp="otp-test-script"
		trap 'rm -rfP "$tmpd"; pass rm -f $otp' HUP INT QUIT TERM EXIT

		notify-send "Scan the image." "Scan the OTP QR code."

		maim -s "$temp" || exit 1
		info="$(zbarimg -q "$temp")"
		info="${info#QR-Code:}"

		if echo "$info" | pass otp insert "$otp"; then
			while [ "${num:-0}" -lt 3 ] ; do
				export name="$(printf '' | dmenu -p "Give this One Time Password a one-word name:")"
				echo "$name" | grep -qE -- "^[A-Za-z0-9-]+$" && break
				num="$((num + 1))"
			done
			pass mv "$otp" "$name-otp"
			notify-send "Successfully added." "$name-otp has been created."
		else
			notify-send "No OTP data found." "Try to scan the image again more precisely."
		fi
		;;
	🕙sync-time )
		# OpenBSD runs ntpd(8) from base by default and keeps the clock
		# synced, so report its state instead of forcing a sync as root.
		notify-send -u low "🕙 Time sync" "$(ntpctl -s status)"
		;;
	*) pass otp -c ${choice}-otp ;;
esac
