#!/bin/sh

# getcomproot FILE: print the absolute path of the root file of FILE's project,
# for `compiler` and `opout`. Name the root in a comment in FILE:
# % root = mainfile.tex
# They then run on that file instead. Exit 1 when FILE names none.

texroot="$(sed -nE 's/^[[:space:]]*%.*root[[:space:]]*=[[:space:]]*([^[:space:]]+).*/\1/p' "${1}")"
[ -f "${texroot}" ] && readlink -f "${texroot}" || exit "1"
