#!/bin/sh

# Pause every mpv, through the socket each opens (mpv/scripts/mpvSockets.lua).
# Base nc(1) in place of socat: -U a Unix socket, -N close after sending.

for s in "${XDG_CACHE_HOME:-$HOME/.cache}"/mpvSockets/*; do
	[ -S "$s" ] || continue
	echo '{ "command": ["set_property", "pause", true] }' |
		nc -NU -w 1 "$s" >/dev/null 2>&1
done
