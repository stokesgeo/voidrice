#!/bin/sh

# podentr: run queueandnotify each time newsboat changes its queue file, with
# entr(1). Only one copy runs.

# A script runs as its interpreter, so match the command line, not the name.
[ "$(pgrep -f podentr | wc -l)" -gt 1 ] && exit

echo "${XDG_DATA_HOME:-$HOME/.local/share}"/newsboat/queue | entr -p queueandnotify 2>/dev/null
