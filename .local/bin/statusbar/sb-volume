#!/bin/sh

# Prints the current volume or 🔇 if muted.
# sndioctl(1): output.level runs from 0 to 1; output.mute is 0 or 1.

case $BLOCK_BUTTON in
	2) sndioctl -q output.mute=! ;;
	4) sndioctl -q output.level=+0.01 ;;
	5) sndioctl -q output.level=-0.01 ;;
	3) notify-send "📢 Volume module" "\- Shows volume 🔊, 🔇 if muted.
- Middle click to mute.
- Scroll to change." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

[ "$(sndioctl -n output.mute)" = 1 ] && { printf "🔇\n"; exit ;}

vol=$(sndioctl -n output.level | awk '{printf "%.0f", $1 * 100}')

# A true test expands to 1, so case 1 takes the first test that holds.
case 1 in
	$((vol >= 70)) ) icon="🔊" ;;
	$((vol >= 30)) ) icon="🔉" ;;
	$((vol >= 1)) ) icon="🔈" ;;
	* ) printf "🔇\n"; exit ;;
esac

printf "%s%d%%\n" "$icon" "$vol"
