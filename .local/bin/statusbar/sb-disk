#!/bin/sh

# Status bar module for disk space
# $1 should be drive mountpoint, otherwise assumed /.

location=${1:-/}

[ -d "$location" ] || exit

case $BLOCK_BUTTON in
	1) notify-send "💽 Disk space" "$(df -h)" ;;
	3) notify-send "💽 Disk module" "\- Shows used hard drive space.
- Click to show all disk info." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

case "$location" in
	/home* ) icon="🏠" ;;
	/mnt* ) icon="💾" ;;
	*) icon="🖥";;
esac

free="$(df -h "$location")"
# Cut df(1)'s header row: $2 is then the size and $3 the space used.
free="${free#*/}"

set -- $free

printf "%s: %s/%s\n" "$icon" "$3" "$2"
