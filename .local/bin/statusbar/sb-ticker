#!/bin/sh

# sb-ticker: percent change of stock quotes, one line per ticker:
# 	^DJI: 0.09%
# 	CL=F: -1.88%
# The tickers are the comma-separated list in $XDG_CONFIG_HOME/tickers; the
# default is ^GSPC (S&P 500), ^DJI (Dow Jones) and XIC. Prices come from
# terminal-stocks.dev and are kept in a cache file.

url="terminal-stocks.dev"
pricefile="${XDG_CACHE_HOME:-$HOME/.cache}/stock-prices"
tickerfile="${XDG_CONFIG_HOME:-$HOME/.config}/tickers"

[ -f "$tickerfile" ] && tickers="$(cat "$tickerfile")" || tickers="^GSPC,^DJI,^IXIC";

# True when the cache is not from this hour.
checkprice() {
    [ -s "$pricefile" ] && [ "$(stat -f %Sm -t '%Y-%m-%d %H' "$pricefile" 2>/dev/null)" != "$(date '+%Y-%m-%d %H')" ]
}

getchange() {	# the nth change after a colour escape goes with the nth ticker
    grep -Eo '[m-]+[0-9]+\.[0-9]+' "$pricefile" | tr -d m |
        awk -v t="$tickers" '{ c[NR] = $0 }
            END { n = split(t, tk, ","); for (i = 1; i <= n; i++) printf "%s: %s%%\n", tk[i], c[i] }'
}

updateprice() { ftp -MV -w 10 -U curl -o "$pricefile" "https://$url/$tickers" 2>/dev/null || rm -f "$pricefile" ; }

case $BLOCK_BUTTON in
    1) detach "$TERMINAL" -e less -Srf "$pricefile" ;;
    2) notify-send -u low "Updating..." "Updating prices" ; updateme="1" ;;
    3) notify-send "Current prices:" "Current stock prices:\n<b>$(getchange)</b>

LEFT MOUSE BUTTON: show price file
MIDDLE MOUSE BUTTON: update stock prices
RIGHT MOUSE BUTTON: Get stock overview" ;;
    6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

[ -n "$updateme" ] && updateprice

[ -f "$pricefile" ] && getchange

checkprice && updateprice
