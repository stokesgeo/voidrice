#!/bin/sh

# sb-memory: non-free physical RAM over total, then swap used over total.
# On OpenBSD total is hw.physmem (bytes, sysctl(2)); free is vmstat -s's
# free pages times bytes per page (vmstat(8), uvm_init(9)). Used = total -
# free: includes kernel and cache memory, not just top's active pages. This
# is not an estimate of unreclaimable memory or application headroom.
# Swap is separate backing storage, not extra RAM usage; pages can be in
# both RAM and swap. swapctl -s reports 512-byte blocks (swapctl(8)).

# The hogs: the Mac's ps gives comm as the program's path, spaces and all,
# so the figure comes first, and the name is what follows the last slash.
case $BLOCK_BUTTON in
	1) notify-send "🧠 Memory hogs" "$(ps -Ao %mem= -o comm= | awk '{m = $1; sub(/^ *[^ ]+ +/, ""); sub(/.*\//, ""); cmd[$0] += m} END {for (i in cmd) print cmd[i], i}' | sort -nr | head)" ;;
	2) detach "$TERMINAL" -e top ;;
	3) notify-send "🧠 Memory module" "\- Shows Memory Used/Total and swap in use.
- Click to show memory hogs.
- Middle click to open top." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# The Mac: in use is what Activity Monitor calls Memory Used, near enough,
# from vm_stat(1)'s pages: active, wired and held by the compressor. The
# total is hw.memsize.
if [ "$(uname)" = Darwin ]; then
	vm_stat | awk -v phys="$(sysctl -n hw.memsize)" '
		/page size of/ { size = $8 }
		/^Pages (active|wired down|occupied by compressor):/ { n += $NF }
		END { printf "🧠%.2fGiB/%.2fGiB\n", n * size / 1024 / 1024 / 1024, phys / 1024 / 1024 / 1024 }'
	exit
fi

swap=$(swapctl -s 2>/dev/null | awk 'NR == 1 { printf " 🐌 %.2f/%.2fGiB", $5 / 2048 / 1024, $2 / 2048 / 1024 }')

# Read exact counters, not top's rounded, unit-suffixed display values.
LC_ALL=C vmstat -s | awk -v phys="$(sysctl -n hw.physmem)" -v swap="$swap" '
	/^[[:space:]]*[0-9]+ bytes per page$/ { size = $1 }
	/^[[:space:]]*[0-9]+ pages free$/ { free = $1; seen = 1 }
	END {
		if (phys <= 0 || size <= 0 || !seen || free * size > phys) exit 1
		printf "🧠%.2fGiB/%.2fGiB%s\n", (phys - free * size) / 1024 / 1024 / 1024, phys / 1024 / 1024 / 1024, swap
	}'
