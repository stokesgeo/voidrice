#!/bin/sh

# sb-memory: memory in use over total, e.g. 1.20GiB/3.80GiB.
# In use is the "act" figure on top(1)'s Memory line, e.g. "Real: 450M/1466M
# act/tot"; the total is hw.physmem. OpenBSD has no free(1).

# The hogs: the Mac's ps gives comm as the program's path, spaces and all,
# so the figure comes first, and the name is what follows the last slash.
case $BLOCK_BUTTON in
	1) notify-send "🧠 Memory hogs" "$(ps -Ao %mem= -o comm= | awk '{m = $1; sub(/^ *[^ ]+ +/, ""); sub(/.*\//, ""); cmd[$0] += m} END {for (i in cmd) print cmd[i], i}' | sort -nr | head)" ;;
	2) detach "$TERMINAL" -e top ;;
	3) notify-send "🧠 Memory module" "\- Shows Memory Used/Total.
- Click to show memory hogs.
- Middle click to open top." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# The Mac: in use is what Activity Monitor calls Memory Used, near enough,
# from vm_stat(1)'s pages: active, wired and held by the compressor. The
# total is hw.memsize.
if [ "$(uname)" = Darwin ]; then
	vm_stat | awk -v phys="$(sysctl -n hw.memsize)" '
		/page size of/ { size = $8 }
		/^Pages (active|wired down|occupied by compressor):/ { n += $NF }
		END { printf "🧠%.2fGiB/%.2fGiB\n", n * size / 1024 / 1024 / 1024, phys / 1024 / 1024 / 1024 }'
	exit
fi

top -b -d 1 | awk -v phys="$(sysctl -n hw.physmem)" '
	/^Memory:/ {
		split($3, r, "/"); act = r[1]
		u = substr(act, length(act)); n = act + 0	# act ends in K, M or G: convert to GiB
		if (u == "K") n /= 1024 * 1024
		else if (u == "M") n /= 1024
		printf "🧠%.2fGiB/%.2fGiB\n", n, phys / 1024 / 1024 / 1024
		exit
	}'
