#!/bin/sh

# sb-battery: battery charge and state, as one figure for all batteries.
# apm(8) gives the percent (-l), AC line (-a) and state (-b).

if [ "$(uname)" = Darwin ]; then
	# The Mac: the same three from pmset(1), read only. Its lines are like
	# "Now drawing from 'AC Power'" and "...	85%; charging; 0:40 remaining".
	b=$(pmset -g batt)
	capacity=$(echo "$b" | sed -n 's/.*[^0-9]\([0-9]*\)%;.*/\1/p')
	case $b in *"'AC Power'"*) ac=1 ;; *) ac=0 ;; esac
	case $b in *"; charging;"*) state=3 ;; *%*) state=0 ;; *) state=4 ;; esac
else
	# Only click-capable callers send BLOCK_BUTTON; terminal sbar does not.
	scroll='
- Super+End/Home requests X brightness in cwm (25-100%; panel may quantize).
- Down leaves levels at/below 25% unchanged; up recovers toward the floor.
- Scroll changes it only in a click-capable bar, not terminal sbar.'
	case $BLOCK_BUTTON in
		4) sb-brightness up >/dev/null || exit 1 ;;
		5) sb-brightness down >/dev/null || exit 1 ;;
	esac
	capacity=$(apm -l)
	ac=$(apm -a)		# 0 off line, 1 on line, 2 backup, 255 unknown
	state=$(apm -b)		# 0 high, 1 low, 2 critical, 3 charging, 4 absent, 255 unknown
fi

case $BLOCK_BUTTON in
	3) notify-send "🔋 Battery module" "🔋: discharging
🛑: on AC, not charging
♻: state unknown
🔌: charging
⚡: charged
❗: battery very low!$scroll" ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# No battery fitted: print nothing.
[ "$state" = 4 ] && exit 1

if [ "$state" = 3 ]; then
	status="🔌"
elif [ "$ac" = 0 ]; then
	status="🔋"
elif [ "$ac" = 1 ] && [ "$capacity" -ge 99 ]; then
	status="⚡"
elif [ "$ac" = 1 ]; then
	status="🛑"
else
	status="♻️"
fi

# Warn when discharging and low.
[ "$status" = "🔋" ] && [ "$capacity" -le 25 ] && warn="❗"

printf "%s%s%d%%\n" "$status" "$warn" "$capacity"
