#!/bin/sh

# sb-battery: battery charge and state, as one figure for all batteries.
# apm(8) gives the percent (-l), AC line (-a) and state (-b).

case $BLOCK_BUTTON in
	3) notify-send "🔋 Battery module" "🔋: discharging
🛑: on AC, not charging
♻: state unknown
🔌: charging
⚡: charged
❗: battery very low!
- Scroll to change the backlight." ;;
	4) wsconsctl display.brightness+=10 >/dev/null ;;
	5) wsconsctl display.brightness-=10 >/dev/null ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

capacity=$(apm -l)
ac=$(apm -a)		# 0 off line, 1 on line, 2 backup, 255 unknown
state=$(apm -b)		# 0 high, 1 low, 2 critical, 3 charging, 4 absent, 255 unknown

# No battery fitted: print nothing.
[ "$state" = 4 ] && exit 1

if [ "$state" = 3 ]; then
	status="🔌"
elif [ "$ac" = 0 ]; then
	status="🔋"
elif [ "$ac" = 1 ] && [ "$capacity" -ge 99 ]; then
	status="⚡"
elif [ "$ac" = 1 ]; then
	status="🛑"
else
	status="♻️"
fi

# Warn when discharging and low.
[ "$status" = "🔋" ] && [ "$capacity" -le 25 ] && warn="❗"

printf "%s%s%d%%\n" "$status" "$warn" "$capacity"
