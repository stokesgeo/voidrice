#!/bin/ksh

# sbar: dwmblocks for OpenBSD. Sets the root window name, where dwm draws it,
# every 5 seconds or on SIGUSR1 (sb-refresh): OpenBSD has no real-time signals.
# sbar -1 prints the line once (sb-show). Edit $blocks to choose the modules.

trap : USR1
blocks="sb-music sb-news sb-mailbox sb-updates sb-cpu sb-memory sb-volume sb-battery sb-internet sb-words sb-clock"
line() { for b in $blocks; do $b; done 2>/dev/null | grep . | paste -sd ' ' -; }
[ "$1" = -1 ] && { line; exit; }
while xsetroot -name "$(line)"; do sleep 5 & wait $!; done
