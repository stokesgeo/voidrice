#!/bin/ksh

# sbar: the status line. Runs each block in $blocks, joins their output on
# one line and sets it as the root window name, where dwm draws it. It
# redraws every 5 seconds, or at once on SIGUSR1 (see sb-refresh).
#
# Usage: sbar [-1|-t]
# 	-1	print the line once and exit (sb-show does this)
# 	-t	draw in this terminal instead: the one-line terminal that is
# 		the bar under cwm (xinitrc starts it; cwmrc keeps windows off it)
#
# Edit $blocks to choose and order the blocks.
#
# Every block is a script sb-NAME that prints one item, or nothing to hide
# it. Its header names it; then a case on $BLOCK_BUTTON handles clicks:
# 1 left, 2 middle, 3 right (shows help), 4 and 5 scroll, 6 shift click
# (edits the block). Only a bar that sets $BLOCK_BUTTON, such as dwmblocks,
# sends clicks; sbar sets none.
#
# sb-forecast, sb-iplocate and sb-moonphase share one pattern; sb-price does
# too with a nonempty fourth argument (unless middle-clicked to update now).
# They fetch stale data in the background, one fetcher at a time (a mkdir
# lock), then call sb-refresh.

# A caught signal ends the wait below; the loop then redraws.
trap : USR1
self=$0
blocks="sb-group sb-music sb-news sb-mailbox sb-updates sb-cpu sb-memory sb-volume sb-battery sb-internet sb-words sb-clock"
line() { for b in $blocks; do $b; done 2>/dev/null | grep . | paste -sd '|' - | sed 's/|/ | /g'; }
[ "$1" = -1 ] && { line; exit; }
if [ "$1" = -t ]; then
	if [ -z "${SBAR_SUPERVISED-}" ]; then
		# Supervise the drawing child so a crash cannot leave the bar gone.
		logdir=${XDG_CACHE_HOME:-$HOME/.cache}
		# If the cache is unavailable, restart without logging. Never use
		# a predictable shared /tmp name for either the log or its trim.
		log=/dev/null
		if mkdir -p "$logdir" 2>/dev/null && [ -w "$logdir" ]; then
			log=$logdir/sbar-recovery.log
		fi
		trim_log() {
			[ -f "$log" ] || return 0
			[ "$(wc -c <"$log")" -gt 65536 ] || return 0
			tail -n 100 "$log" >"$log.tmp" && mv "$log.tmp" "$log"
		}
		trim_log
		child=
		trap 'if [ -n "$child" ]; then kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; fi; exit' HUP INT TERM
		backoff=1
		while :; do
			start=$(date +%s)
			SBAR_SUPERVISED=1 "$self" -t &
			child=$!
			while :; do
				wait "$child"
				rc=$?
				kill -0 "$child" 2>/dev/null || break
			done
			child=
			ran=$(( $(date +%s) - start ))
			[ "$ran" -ge 60 ] && backoff=1
			printf '%s sbar -t exited %s after %ss; restart in %ss\n' \
			    "$(date '+%Y-%m-%d %H:%M:%S')" "$rc" "$ran" "$backoff" 2>/dev/null >>"$log"
			trim_log
			sleep "$backoff" &
			child=$!
			while kill -0 "$child" 2>/dev/null; do wait "$child"; done
			child=
			backoff=$((backoff * 2))
			[ "$backoff" -gt 30 ] && backoff=30
		done
	fi
	# No line wrap, no cursor; theme recolours this terminal with the others.
	printf '\033[?7l\033[?25l'
	while printf '\r\033[K%s' "$(line)"; do sleep 5 & wait $!; done
	exit
fi
while xsetroot -name "$(line)"; do sleep 5 & wait $!; done
