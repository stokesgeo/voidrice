#!/bin/sh

# Displays today's precipication chance (☔), and daily low (🥶) and high (🌞).
# Usually intended for the statusbar.
# $LOCATION names the place and $WTTRURL the server.

url="${WTTRURL:-wttr.in}"
weatherreport="${XDG_CACHE_HOME:-$HOME/.cache}/weatherreport"

# Get a weather report from 'wttr.in' and save it locally.
# (Fails without a default route.)
getforecast() { route -n get default >/dev/null 2>&1 &&
	ftp -MV -U curl -o "$weatherreport" "https://$url/$LOCATION" 2>/dev/null &&
	touch "$weatherreport"
}

# Forecast should be updated only once a day.
checkforecast() {
	[ "$(stat -f %Sm -t %Y-%m-%d "$weatherreport" 2>/dev/null)" = "$(date '+%Y-%m-%d')" ]
}

# Line 16 of the report holds the chances of rain; show the highest.
getprecipchance() {
	echo "$weatherdata" | sed '16q;d' |    # Extract line 16 from file
		grep -wo "[0-9]*%" |           # Find a sequence of digits followed by '%'
		sort -rn |                     # Sort in descending order
		head -n 1                       # Extract first line
}

# Line 13 has the day's temperatures, each as m<signed number>; the "m" ends a
# colour escape. Print the lowest, then the highest.
getdailyhighlow() {
	echo "$weatherdata" | sed '13q;d' |      # Extract line 13 from file
		grep -Eo "m[-+]*[0-9]+" | # Find temperatures in the format "m<signed number>"
		sed 's/[+m]//g' |                # Remove '+' and 'm'
		sort -g |                        # Sort in ascending order
		sed -e 1b -e '$!d'               # Extract the first and last lines
}

readfile() { weatherdata="$(cat "$weatherreport")" ;}

showweather() {
	readfile
	# shellcheck disable=SC2046,SC2183
	printf "☔%s 🥶%s° 🌞%s°\n" "$(getprecipchance)" $(getdailyhighlow)
}

case $BLOCK_BUTTON in
	1) detach "$TERMINAL" -e less -Sf "$weatherreport" ;;
	2) getforecast && showweather ;;
	3) notify-send "🌈 Weather module" "\- Left click for full forecast.
- Middle click to update forecast.
☔: Chance of rain/snow
🥶: Daily low
🌞: Daily high" ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# Fresh cache: show it. Otherwise fetch in the background (see sbar). The
# fetcher lets go of stdout, which sbar reads.
# shellcheck disable=SC2015
checkforecast && showweather ||
	( ( exec >/dev/null 2>&1; lock=/tmp/sb-forecast-$(id -u).lock
		mkdir "$lock" || exit
		trap 'rmdir "$lock"' EXIT; tries=0; while [ $tries -ne 100 ]; do
			getforecast && break ||
				{ tries=$((tries+1)); sleep .1; }
		done
		! checkforecast &&
			until getforecast; do sleep 60; done
		sb-refresh
		) &
	echo )
