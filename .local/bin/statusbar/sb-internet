#!/bin/sh

# Show wifi 📶 and percent strength or 📡 if none.
# Show 🌐 if connected to ethernet or ❎ if none.
# Show 🔒 if a vpn connection is active
#
# OpenBSD has no /sys; everything comes from one ifconfig(8) run. A wireless
# interface has "media: IEEE802.11", wired has "media: Ethernet", a working
# link has "status: active", and the ieee80211 line of a joined network
# carries the signal as a percentage. wg(4) and tun(4) count as VPN.

case $BLOCK_BUTTON in
	1) detach dmenuwifi ;;
	3) notify-send "🌐 Internet module" "\- Click to connect
❌: wifi disabled
📡: no wifi connection
📶: wifi connection with quality
❎: no ethernet
🌐: ethernet working
🔒: vpn is active
" ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

ifconfig -a | awk '
	/^[a-z]/ {
		ifc = $1; sub(/:$/, "", ifc)
		up[ifc] = ($2 ~ /<UP/)
		if (ifc ~ /^(wg|tun)[0-9]/ && up[ifc]) vpn = 1
	}
	/media: IEEE802\.11/	{ wifi = ifc }
	/media: Ethernet/	{ eth[ifc] = 1 }
	/status: active/	{ active[ifc] = 1 }
	/ieee80211:/ {
		for (i = 1; i <= NF; i++)
			if ($i ~ /^[0-9]+%$/) sig = $i
	}
	END {
		if (wifi != "") {
			if (!up[wifi])			printf "❌ "
			else if (active[wifi] && sig != "")	printf "📶 %s ", sig
			else				printf "📡 "
		}
		e = "❎"
		for (i in eth) if (active[i]) e = "🌐"
		printf "%s", e
		if (vpn) printf " 🔒"
		printf "\n"
	}'
