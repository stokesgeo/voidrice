#!/bin/sh

# Show wifi 📶 and percent strength or 📡 if none.
# Show 🌐 if connected to ethernet or ❎ if none.
# Show 🔒 if a vpn connection is active (wg or tun)
# OpenBSD has no /sys: it all comes from one ifconfig(8).

case $BLOCK_BUTTON in
	3) notify-send "🌐 Internet module" "\- Click to connect
❌: wifi disabled
📡: no wifi connection
📶: wifi connection with quality
❎: no ethernet
🌐: ethernet working
🔒: vpn is active
" ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# The Mac: the way out is the interface of the default route (route(8));
# networksetup(8) names the Wi-Fi one; a VPN that takes all traffic is a
# tunnel. No signal strength: since the airport tool went (macOS 14.4),
# what is left is slow (system_profiler) or root's (wdutil). Wi-Fi off
# shows as 📡.
if [ "$(uname)" = Darwin ]; then
	out=$(route -n get default 2>/dev/null | awk '$1 == "interface:" { print $2 }')
	wifi=$(networksetup -listallhardwareports | awk '/^Hardware Port: Wi-Fi$/ { getline; print $2 }')
	case $out in
		'') echo 📡 ;;
		"$wifi") echo 📶 ;;
		utun*|ipsec*|ppp*) echo 🔒 ;;
		*) echo 🌐 ;;
	esac
	exit
fi

ifconfig -a | awk '
	/^[a-z]/ {
		ifc = $1; sub(/:$/, "", ifc)
		up[ifc] = ($2 ~ /<UP/)
		if (ifc ~ /^(wg|tun)[0-9]/ && up[ifc]) vpn = 1
	}
	/media: IEEE802\.11/	{ wifi = ifc }
	/media: Ethernet/	{ eth[ifc] = 1 }
	/status: active/	{ active[ifc] = 1 }
	/ieee80211:/ {
		for (i = 1; i <= NF; i++)
			if ($i ~ /^[0-9]+%$|dBm$/) sig = $i	# iwn(4) gives dBm
	}
	END {
		if (wifi != "") {
			if (!up[wifi])			printf "❌ "
			else if (active[wifi] && sig != "")	printf "📶 %s ", sig
			else				printf "📡 "
		}
		e = "❎"
		for (i in eth) if (active[i]) e = "🌐"
		printf "%s", e
		if (vpn) printf " 🔒"
		printf "\n"
	}'
