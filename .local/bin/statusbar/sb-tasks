#!/bin/sh

# Originally by Andr3as07 <https://github.com/Andr3as07>
# Some changes by Luke
# Rebuild by Tenyun

# Displays the number of running and queued downloads of qndl: 🤖2(1) is
# two jobs, one of them waiting.
#
# qndl's queue is nq(1). nq names each job file ,TIMESTAMP.PID in the
# queue directory. PID is the job's process, or, before the job starts,
# the nq process waiting for its turn; nq sets the owner-execute bit on the
# file while the job runs and clears it when the job ends (nq.1, nq.c). So
# a file whose PID is alive is a job not yet done: running with the x bit,
# queued without it. A file whose PID is gone is a finished job (qndl keeps
# the failed ones), and is not counted.

dir=${XDG_CACHE_HOME:-$HOME/.cache}/qndl

case $BLOCK_BUTTON in
	1) NQDIR=$dir detach "$TERMINAL" -e fq ;;
	3) notify-send "Tasks module" "🤖: number of running/queued downloads
- Left click follows their output (fq)" ;; # Right click
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

numr=0
numq=0
for f in "$dir"/,*; do
	[ -f "$f" ] || continue
	kill -0 "${f##*.}" 2>/dev/null || continue
	if [ -x "$f" ]; then numr=$((numr + 1)); else numq=$((numq + 1)); fi
done
num="$((numr + numq))($numq)"
[ "$num" != "0(0)" ] && printf "🤖%s\n" "$num"
exit 0
