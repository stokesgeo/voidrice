#!/bin/sh

# sb-iplocate: flag and name of the country your public IP address is in.
# Needs geoiplookup. The address comes from api.ipify.org.

ifinstalled geoiplookup || exit 1

getip() {
	route -n get default >/dev/null 2>&1 &&
		ftp -MV -o "$ipfile" https://api.ipify.org 2>/dev/null
}

# The background fetch saves the address here; it is used once, then deleted.
ipfile="${XDG_CACHE_HOME:-$HOME/.cache}/iplocate"
# No saved address: fetch one in the background (see sbar) and print nothing.
addr=$(cat "$ipfile" 2>/dev/null) && addr=$(geoiplookup "$addr" 2>/dev/null) && rm "$ipfile" ||
	( mkdir "${lock:=/tmp/sb-iplocate-$(id -u).lock}" 2>/dev/null &&
		( trap 'rmdir "$lock"' EXIT; tries=0; while [ $tries -ne 100 ]; do
			getip && break ||
				{ tries=$((tries+1)); sleep .1; }
		done
		! [ -f "$ipfile" ] &&
			until getip; do sleep 60; done &&
		sb-refresh
		) &
	echo; exit )
name="${addr##*, }"
flag="$(grep "flag: $name" "${XDG_DATA_HOME:-$HOME/.local/share}/larbs/chars/emoji")"
flag="${flag%% *}"
printf "%s %s\\n" "$flag" "$name"
