#!/bin/sh

# Gets your public ip address checks which country you are in and
# displays that information in the statusbar
# Needs geoiplookup. The address comes from api.ipify.org.
#
# https://www.maketecheasier.com/ip-address-geolocation-lookups-linux/

ifinstalled geoiplookup || exit 1

getip() {
	route -n get default >/dev/null 2>&1 &&
		ftp -MV -o "$ipfile" https://api.ipify.org 2>/dev/null &&
		touch "$ipfile"
}

# The address is kept here and fetched again once it is an hour old.
ipfile="${XDG_CACHE_HOME:-$HOME/.cache}/iplocate"
checkip() { [ -n "$(find "$ipfile" -mmin -60 2>/dev/null)" ]; }

# Fresh address: look it up. Otherwise fetch in the background (see sbar)
# and print nothing. The fetcher lets go of stdout, which sbar reads.
# shellcheck disable=SC2015
checkip ||
	{ ( exec >/dev/null 2>&1; lock=/tmp/sb-iplocate-$(id -u).lock
		mkdir "$lock" || exit
		trap 'rmdir "$lock"' EXIT; tries=0; while [ $tries -ne 100 ]; do
			getip && break ||
				{ tries=$((tries+1)); sleep .1; }
		done
		! checkip &&
			until getip; do sleep 60; done
		sb-refresh
		) &
	echo; exit; }
addr=$(geoiplookup "$(cat "$ipfile")" 2>/dev/null) || exit 1
name="${addr##*, }"
flag="$(grep "flag: $name" "${XDG_DATA_HOME:-$HOME/.local/share}/larbs/chars/emoji")"
flag="${flag%% *}"
printf "%s %s\\n" "$flag" "$name"
