#!/bin/sh

# sb-brightness: backlight level, in percent.
# wsconsctl(8) prints e.g. 70.00%; fbtab(5) gives the console user the device.

case $BLOCK_BUTTON in
	3) notify-send "💡 Brightness module" "\- Shows current brightness level ☀️." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

level=$(wsconsctl -n display.brightness) || exit 1

printf "💡%d%%\n" "${level%%.*}"
