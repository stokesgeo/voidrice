#!/bin/sh

# Module showing CPU load as a changing bars.
# Just like in polybar.
# Each bar represents amount of load on one core since
# last run. OpenBSD: kern.cp_time2.N; SMT threads, off by default, get no bar.

cache="${XDG_CACHE_HOME:-$HOME/.cache}"/cpubarscache

case $BLOCK_BUTTON in
	2) detach "$TERMINAL" -e top ;;
	3) notify-send "🪨 CPU load module" "Each bar represents
one CPU core";;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# id total idle
stats=$(i=0; n=$(sysctl -n hw.ncpu)
	while [ "$i" -lt "$n" ]; do
		sysctl -n kern.cp_time2."$i" |
			awk -F, -v id="$i" '{print id, $1+$2+$3+$4+$5+$6, $6}'
		i=$((i + 1))
	done)
[ ! -f "$cache" ] && echo "$stats" > "$cache"
old=$(cat "$cache")
printf "🪨"
echo "$stats" | while read -r row; do
	id=${row%% *}
	rest=${row#* }
	total=${rest%% *}
	idle=${rest##* }

	case "$(echo "$old" | awk '{if ($1 == id) {
		if (total == $2) print "idle"
		else printf "%d\n", (1 - (idle - $3)  / (total - $2))*100 /12.5 }}' \
		id="$id" total="$total" idle="$idle")" in

		"0") printf "▁";;
		"1") printf "▂";;
		"2") printf "▃";;
		"3") printf "▄";;
		"4") printf "▅";;
		"5") printf "▆";;
		"6") printf "▇";;
		"7") printf "█";;
		"8") printf "█";;
	esac
done; printf "\\n"
echo "$stats" > "$cache"
