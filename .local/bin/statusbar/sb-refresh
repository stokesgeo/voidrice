#!/bin/sh

# sb-refresh: ask the status bar to redraw now, by sending SIGUSR1 to sbar.
# This replaces voidrice's `pkill -RTMIN+n dwmblocks`: OpenBSD has no
# real-time signals. sbar redraws all blocks, not only the one that changed.
#
# SIGUSR1 kills a process that does not catch it, so check that the pid in
# the file is still sbar before signalling it.

pidfile=${XDG_CACHE_HOME:-$HOME/.cache}/sbar.pid
[ -f "$pidfile" ] || exit 0
pid=$(cat "$pidfile")
case $(ps -o command= -p "$pid" 2>/dev/null) in
*sbar*) kill -USR1 "$pid" ;;
esac
exit 0
