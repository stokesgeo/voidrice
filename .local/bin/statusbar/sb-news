#!/bin/sh

# sb-news: number of unread newsboat(1) items, and a sync mark while newsup
# runs. Left click opens newsboat; middle click syncs the feeds.

case $BLOCK_BUTTON in
        1) detach "$TERMINAL" -e newsboat ;;
	2) detach newsup >/dev/null && exit ;;
        3) notify-send "📰 News module" "\- Shows unread news items
- Shows 🔃 if updating with \`newsup\`
- Left click opens newsboat
- Middle click syncs RSS feeds
<b>Note:</b> Only one instance of newsboat (including updates) may be running at a time." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# While newsup runs, show its status file; else count the unread items.
cat "${XDG_CACHE_HOME:-$HOME/.cache}"/newsupdate 2>/dev/null || {
	unread="$(newsboat -x print-unread)"
	unread="${unread%% *}"
	[ "$unread" -gt 0 ] && printf "📰%s\n" "$unread"
}
