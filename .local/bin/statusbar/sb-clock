#!/bin/sh

# sb-clock: date and time, with a clock face for the hour.
# Left click shows appointments; on the Mac, Calendar and Reminders.

clock=$(date '+%I')

case "$clock" in
	"00") icon="🕛" ;;
	"01") icon="🕐" ;;
	"02") icon="🕑" ;;
	"03") icon="🕒" ;;
	"04") icon="🕓" ;;
	"05") icon="🕔" ;;
	"06") icon="🕕" ;;
	"07") icon="🕖" ;;
	"08") icon="🕗" ;;
	"09") icon="🕘" ;;
	"10") icon="🕙" ;;
	"11") icon="🕚" ;;
	"12") icon="🕛" ;;
esac

if [ "$(uname)" = Darwin ]; then
		case $BLOCK_BUTTON in
		1) open -a Calendar ;;
		2) open -a Reminders ;;
		3) notify-send "Time and date" "Left click opens Calendar. Middle click opens Reminders." ;;
		6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
		esac
		date "+%Y %b %d (%a) $icon%I:%M%p"
		exit
fi

case $BLOCK_BUTTON in
	1) notify-send "This Month" "$(cal | sed "s/[[:<:]]$(date +'%e'|tr -d ' ')[[:>:]]/<b><span color='red'>&<\/span><\/b>/")" && notify-send "Appointments" "$(calcurse -d3)" ;;
	2) detach "$TERMINAL" -e calcurse ;;
	3) notify-send "📅 Time/date module" "\- Left click to show upcoming appointments for the next three days via \`calcurse -d3\` and show the month via \`cal\`
- Middle click opens calcurse if installed" ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

date "+%Y %b %d (%a) $icon%I:%M%p"
