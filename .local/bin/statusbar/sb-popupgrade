#!/bin/sh

# sb-popupgrade: install the waiting updates in a terminal: base errata
# (syspatch(8)), then packages (pkg_add(1)).

# Run from a bar or a key: reopen in a terminal.
[ -t 0 ] || exec "$TERMINAL" -e "$0"

printf "Beginning upgrade.\n"

# The Mac: Homebrew's packages; macOS itself updates from System Settings.
# A launchd agent counts again in the user cache.
if [ "$(uname)" = Darwin ]; then
	cache=${XDG_CACHE_HOME:-$HOME/.cache}
	if ! { brew update && brew upgrade && mkdir -p "$cache" && : >"$cache/updates"; }; then
		printf "\nUpgrade failed.\nPress <Enter> to exit window.\n" >&2
		read -r _
		exit 1
	fi
else
	doas syspatch
	doas pkg_add -u
	doas rm -f /var/db/updates	# clears sb-updates; root's cron counts again within four hours
fi

sb-refresh

printf "\nUpgrade complete.\nPress <Enter> to exit window.\n"
read -r _
