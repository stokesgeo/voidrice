#!/bin/sh

# Displays current keyboard layout.
# Requires setxkbmap.
# Left click picks another with dmenu(1).

kb="$(setxkbmap -query | while read -r key value; do
	[ "$key" = "layout:" ] && { echo "$value"; break ;}
done)"

case $BLOCK_BUTTON in
	# The layouts are listed in the xkb rules file, between the "! layout" and
	# "! variant" headings.
	1) kb_choice="$(cat /usr/X11R6/share/X11/xkb/rules/base.lst)"
	kb_choice="${kb_choice#*! layout*}"
	kb_choice="${kb_choice%%! variant*}"
	kb_choice="$(echo "$kb_choice" | while read -r iso layout; do
		[ -z "$iso" ] || printf "%s - %s\n" "$layout" "$iso"
	done | dmenu -i -l 15)"
	kb_choice="${kb_choice##* }"
	[ -z "$kb_choice" ] && exit
	setxkbmap "$kb_choice"
	sb-refresh ;;
	3) notify-send "⌨  Keyboard/language module" "Current layout: $kb
- Left click to change keyboard." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

printf "%s\n" "$kb"
