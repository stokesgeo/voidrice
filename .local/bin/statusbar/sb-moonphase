#!/bin/sh

# Shows the current moon phase.

moonfile="${XDG_DATA_HOME:-$HOME/.local/share}/moonphase"

checkmoon() {
	[ "$(stat -f %Sm -t %Y-%m-%d "$moonfile" 2>/dev/null)" = "$(date '+%Y-%m-%d')" ]
}

getmoon() { route -n get default >/dev/null 2>&1 &&
	curl -sf "wttr.in/?format=%m" --output "$moonfile" && touch "$moonfile"
}

checkmoon ||
	( mkdir "${lock:=/tmp/sb-moonphase-$(id -u).lock}" 2>/dev/null &&
		( trap 'rmdir "$lock"' EXIT; tries=0; while [ $tries -ne 100 ]; do
			# shellcheck disable=SC2015
			getmoon && break ||
				{ tries=$((tries+1)); sleep .1; }
		done
		! checkmoon &&
			until getmoon; do sleep 60; done
		sb-refresh
		) &
	echo; exit )

icon="$(cat "$moonfile")"

case "$icon" in
	🌑) name="New" ;;
	🌒) name="Waxing Crescent" ;;
	🌓) name="First Quarter" ;;
	🌔) name="Waxing Gibbous" ;;
	🌕) name="Full" ;;
	🌖) name="Waning Gibbous" ;;
	🌗) name="Last Quarter" ;;
	🌘) name="Waning Crescent" ;;
	*) exit 1 ;;
esac

echo "${icon-?}"

case $BLOCK_BUTTON in
	3) notify-send "🌜 Moon phase module" "Displays current moon phase.
- 🌑: New
- 🌒: Waxing Crescent
- 🌓: First Quarter
- 🌔: Waxing Gibbous
- 🌕: Full
- 🌖: Waning Gibbous
- 🌗: Last Quarter
- 🌘: Waning Crescent" ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac
