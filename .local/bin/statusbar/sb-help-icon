#!/bin/sh

# sb-help-icon: a help mark for the bar. Left click opens the LARBS guide
# as a PDF; middle click sends SIGHUP to dwm, which restarts it.

case $BLOCK_BUTTON in
	1) groff -mom /usr/local/share/dwm/larbs.mom -Tpdf | zathura - ;;
	2) pkill -HUP dwm ;;
	3) notify-send "❓ Help module" "\- Left click to open LARBS guide.
- Middle click to refresh window manager." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

printf "❓\n"
