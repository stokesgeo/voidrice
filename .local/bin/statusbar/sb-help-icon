#!/bin/sh

# The clickable help menu. Middle click to restart wm.
# Left click opens vertrice(7) in a terminal. (Middle click sends SIGHUP to dwm.)

case $BLOCK_BUTTON in
	1) detach "$TERMINAL" -e man vertrice ;;
	2) pkill -HUP dwm ;;
	3) notify-send "❓ Help module" "\- Left click to open the vertrice manual.
- Middle click to refresh window manager." ;;
	6) detach "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

printf "❓\n"
