#!/bin/sh

# manpick: pick any manual page on the machine from a dmenu list, and read
# it with man(1) in a new terminal.
#
# The list is `apropos .`. apropos matches its argument as an extended
# regular expression against every page's names and one-line description,
# and "." matches any character, so every page is listed, one per line
# (the format is in apropos(1)):
#	ksh, rksh(1) - public domain Korn shell
#	apm(4/amd64) - ...
# that is: the names, the section in brackets, and a machine type after a
# slash when the page is for one machine only.
#
# Typing a page into dmenu works too: "ksh", or "ksh(1)", the way pages
# are named in text.

pick=$(apropos . | dmenu -i -l 20 -p "Manual:") || exit 0

# Take the line apart with the shell's own pattern removal, no sed:
# ${v%%P} removes the longest match of P from the end, ${v%P} the shortest;
# ${v#P} and ${v##P} do the same from the start.
names=${pick%%) - *}	# drop the description: "ksh, rksh(1"
names=${names%)}	# a typed "ksh(1)" still has its bracket
sec='' arch=''
case $names in *\(*)
	sec=${names##*\(}	# "1", or "4/amd64"
	names=${names%\(*} ;;	# "ksh, rksh"
esac
case $sec in */*)
	arch=${sec#*/}
	sec=${sec%%/*} ;;
esac
name=${names%%,*}	# the first name is enough to find the page
name=${name%% *}

# A name starting with "-" would reach man as an option.
case $name in
'') exit 0 ;;
-*) echo "manpick: not a page name: $name" >&2; exit 1 ;;
esac

# Build man's arguments in the positional parameters: the one list sh has.
set --
[ -n "$sec" ] && set -- -s "$sec"
[ -n "$arch" ] && set -- "$@" -S "$arch"
exec "${TERMINAL:-xterm}" -e man "$@" "$name"
