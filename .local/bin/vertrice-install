#!/bin/sh

# vertrice-install: the system half of vertrice: packages, /etc files, cron,
# services. Read it, then run it as root:
#	doas sh ~/.local/bin/vertrice-install
# Before doas.conf exists, use: su -, then sh ~you/.local/bin/vertrice-install
# It stops on failure; a second run keeps configuration lines once.
#
# The home half comes first, as you, once root has run pkg_add git. It puts
# this script and the files it installs in your home. The third line, before
# anything is written, limits the checkout to this system's files: the list
# in ~/.local/share/openbsd, or darwin on a Mac. After a pull that changes
# the list, run the second and third lines again.
#	git clone --bare https://github.com/stokesgeo/voidrice.git ~/.local/share/vertrice.git
#	cd ~/.local/share/vertrice.git
#	git show HEAD:.local/share/$(uname | tr A-Z a-z)/sparse-checkout | git --work-tree=$HOME sparse-checkout set --no-cone --stdin
#	git --work-tree=$HOME checkout -f
#	git config status.showUntrackedFiles no

# A Mac runs its own install, as you, not root.
[ "$(uname)" = Darwin ] && exec sh "$(dirname "$0")/../share/darwin/install" "$@"

set -e
printf '%s\n' \
    'WARNING: this provisions or reapplies the OpenBSD system configuration.' \
    'It overwrites system configuration and firewall rules, loads the firewall,' \
    'and resets service settings and power tuning to the shipped defaults.' \
    'This is not routine maintenance; earlier changes are not rolled back on failure.' >&2
printf 'Type yes to continue: ' >&2
if ! IFS= read -r answer || [ "$answer" != yes ]; then
	echo 'vertrice-install: cancelled; no changes made' >&2
	exit 1
fi

cron_tmp=
trap 'rm -f /etc/doas.new; [ -z "$cron_tmp" ] || rm -rf "$cron_tmp"' EXIT

# Root runs this, so "you" is found as the owner of the script. Root's mail
# goes to you.
u=$(stat -f %Su "$0")
# Literal sed replacement and cron argument, not arbitrary shell text.
case $u in
''|root|[!a-zA-Z_]*|*[!a-zA-Z0-9_-]*)
	echo 'vertrice-install: script owner must be a nonroot Unix login name' >&2
	exit 1 ;;
esac
cd "$(dirname "$0")/../share/openbsd" || exit
pkg_add -l pkglist			# the optional rest: pkg_add -l pkglist.extra
install -d -o _clamav -g _clamav -m 755 /var/db/clamav
install -d -o root -g wheel -m 755 /etc/clamav-certs
install -o root -g wheel -m 644 /usr/local/share/examples/clamav/certs/clamav.crt /etc/clamav-certs/clamav.crt
install -o root -g wheel -m 644 freshclam.conf /etc/freshclam.conf
printf '%s\n' 'Refreshing required ClamAV signatures in the foreground.' >&2
/usr/local/bin/freshclam --config-file=/etc/freshclam.conf --foreground
# The joined doas rules and pf rules are syntax-checked before installation.
# Parsing does not establish that the rules preserve access.
# doas.conf is the two rule files joined; doas -C parses the result.
cat doas.conf doas-agent.conf >/etc/doas.new
doas -C /etc/doas.new
install -m 640 /etc/doas.new /etc/doas.conf
rm -f /etc/doas.new
install -m 644 root.kshrc /root/.kshrc
install -m 644 login.conf.d/staff /etc/login.conf.d/staff
# pfctl -n only parses. The rules load only if they parse.
pfctl -nf pf.conf
install -m 600 pf.conf /etc/pf.conf
pfctl -f /etc/pf.conf
# apmd(8) runs /etc/apm/suspend on suspend; hibernate shares the script.
mkdir -p /etc/apm
install -m 755 apm-suspend /etc/apm/suspend
ln -sf suspend /etc/apm/hibernate
install -m 755 hotplug-attach /etc/hotplug/attach
install -m 755 hotplug-detach /etc/hotplug/detach
install -o root -g wheel -m 755 usbctl /usr/local/bin/usbctl
install -o root -g wheel -m 755 upgrade.sh /usr/local/sbin/vertrice-upgrade
# It writes each new disk's name here, for hotplug-watch. Made once: a
# second run must not look like an attach.
[ -e /var/db/hotplug-disk ] || install -m 644 /dev/null /var/db/hotplug-disk
# Stage the read and replacement separately. Only OpenBSD's exact absent-table
# diagnostic (status 1, no output) means an empty table; other failures stop.
cron_tmp=$(mktemp -d "${TMPDIR:-/tmp}/vertrice-install.XXXXXXXXXX")
if LC_ALL=C crontab -l >"$cron_tmp/old" 2>"$cron_tmp/error"; then :
else
	rc=$?
	cron_user=$(id -un)
	printf 'crontab: no crontab for %s\n' "$cron_user" >"$cron_tmp/absent"
	if [ "$rc" -ne 1 ] || [ -s "$cron_tmp/old" ] || ! cmp -s "$cron_tmp/error" "$cron_tmp/absent"; then
		cat "$cron_tmp/error" >&2
		echo 'vertrice-install: cannot read crontab; not replacing it' >&2
		exit 1
	fi
fi
# Own exact shipped rows/comments and old suffix-marked jobs only. Reading
# both fragments first also recognizes their standalone marker blocks; never
# consume an unrelated line after a marker. crontab checks syntax itself.
legacy='~	*/4	*	*	*	-ns (syspatch -c; pkg_add -u -n -v | grep "^Adding.*->" | sort -u) >/var/db/updates'
overnight='30	3	*	*	* /usr/local/sbin/vertrice-upgrade'
system_overnight='30	3	*	*	*	-s /usr/local/sbin/vertrice-upgrade'
comment='# /var/db/updates: what syspatch and pkg_add -u would install, one a line; sb-updates counts them.'
awk -v old="$cron_tmp/old" -v legacy="$legacy" -v overnight="$overnight" \
    -v system_overnight="$system_overnight" -v comment="$comment" '
	FILENAME != old { if ($0 != "") owned[$0] = 1; next }
	!($0 in owned) && $0 != legacy && $0 != overnight &&
	    $0 != system_overnight && $0 != comment &&
	    $0 !~ / # vertrice-(update-count|overnight-upgrade)$/ { print }
' updates.cron upgrade.cron "$cron_tmp/old" >"$cron_tmp/new"
cat updates.cron >>"$cron_tmp/new"
sed "s/@USER@/$u/g" upgrade.cron >>"$cron_tmp/new"
if grep -q '@USER@' "$cron_tmp/new"; then
	echo 'vertrice-install: unresolved nightly user; not replacing crontab' >&2
	exit 1
fi
crontab "$cron_tmp/new"
rm -rf "$cron_tmp"
cron_tmp=
# Mail for root, from cron and daily(8), reaches you unless an alias exists.
grep -q '^root:' /etc/mail/aliases || echo "root: $u" >>/etc/mail/aliases; newaliases
# rcctl fails on a service that is not installed, so base and packages are
# enabled apart.
rcctl enable apmd hotplugd unwind	# in base
rcctl enable messagebus obsdfreqd	# from pkglist
# apmd suspends at 17% battery. -L leaves frequency control manual for
# obsdfreqd; start apmd first, since -L initialises hw.setperf to 0.
rcctl set apmd flags -L -z 17
# obsdfreqd(1) pairs are on AC, on battery. -r 20 boosts sooner on AC;
# keep battery tuning unchanged. -T lowers the top speed above these degrees C.
rcctl set obsdfreqd flags -m 100,75 -r 20,90 -T 85,60
# Keep existing settings and add each shipped line only once.
for f in wsconsctl.conf fbtab; do
	touch "/etc/$f"
	while IFS= read -r line; do
		grep -Fqx -- "$line" "/etc/$f" || printf '%s\n' "$line" >>"/etc/$f"
	done <"$f"
done
echo "Done. Reboot to load it all."
