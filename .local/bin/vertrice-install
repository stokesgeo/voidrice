#!/bin/ksh

# vertrice-install: set up vertrice on a fresh OpenBSD install, in two
# stages, and test the result.
#
#	vertrice-install [-y] home		as you: fetch the dotfiles into $HOME
#	doas vertrice-install [-y] [-e] [-r] system	as root: packages, doas, daemons
#	doas vertrice-install [-y] pf		as root, optional: the laptop pf.conf
#	vertrice-install check			run ~/.local/share/openbsd/check
#
# Without -y it only prints the plan: what is already done ("ok") and what
# it would do ("would"). With -y it does it. Each step first looks at the
# current state and is skipped when already done, so running it again
# changes nothing. -e also installs pkglist.extra (features you can skip);
# without it only pkglist, the core, is installed. -r also turns on audio
# recording (kern.audio.record=1), which stays off otherwise.
#
# There is no `set -e`: one failed step should not stop the others, and
# set -e is silently ignored inside functions called from `if`, so it
# protects less than it seems. Instead each step's result is checked and
# counted, and the script exits nonzero if any step failed.
#
# Every system file it edits is first copied to FILE.orig, once: the first
# copy is the system's own, and later runs never overwrite it. A file that
# did not exist gets an empty FILE.orig, so a later edit in the same run
# cannot be mistaken for the system's version. Edits are
# written to FILE.vertrice and then renamed over FILE: a rename is atomic,
# so FILE is always either the old or the new version, never half written.
#
# For testing off the machine: ROOT=/some/dir puts every system path under
# that directory (default /). VERTRICE_USER names the desktop user (default:
# the owner of ~/.local/share/openbsd). VERTRICE_URL and VERTRICE_GIT
# change the repository and where its bare copy lives.

url=${VERTRICE_URL:-https://github.com/stokesgeo/vertrice.git}
gitdir=${VERTRICE_GIT:-$HOME/.local/share/vertrice.git}
R=${ROOT:-/}; R=${R%/}	# "" for the real system, so "$R/etc" is /etc

# Browser memory limits for the staff login class. OpenBSD's defaults are
# small; Chromium and qutebrowser (QtWebEngine) crash when they reach them.
# These values are the ones commonly given for browsers (from memory).
staffcaps="datasize-cur=4096M datasize-max=infinity openfiles-cur=4096 openfiles-max=8192"

usage() {
	print -u2 "usage: vertrice-install [-y] home | [-y] [-e] [-r] system | [-y] pf | check"
	exit 2
}

apply=0 record=0 extra=0
while getopts yer o; do
	case $o in
	y)	apply=1 ;;
	e)	extra=1 ;;
	r)	record=1 ;;
	*)	usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 1 ] || usage

# The data files live beside this script: ~/.local/bin/../share/openbsd.
bindir=$(cd -P -- "${0%/*}" 2>/dev/null && pwd)
data=${bindir%/*}/share/openbsd

fails=0
ok()   { print "  ok      $*"; }
note() { print "  note    $*"; }
# step "what it does" command...: print the step; with -y also run it.
step() {
	typeset what=$1; shift
	if [ $apply = 0 ]; then
		print "  would   $what"
		return 0
	fi
	print "  doing   $what"
	"$@" && return 0
	print "  FAILED  $what"
	fails=$((fails + 1))
	return 1
}
finish() {
	if [ $apply = 0 ]; then
		print "Dry run: nothing changed. Add -y to apply."
	elif [ $fails -gt 0 ]; then
		print "$fails step(s) failed; fix and run again (done steps are skipped)."
	else
		print "Done."
	fi
	[ $fails -eq 0 ]
	exit
}

### Stage 1: the dotfiles, as the user.
#
# The repository is a bare repo (history only, no files of its own) whose
# work tree is $HOME, so the dotfiles sit where programs look for them and
# $HOME itself is not a git checkout. The `config` function in the kshrc is
# git pointed at that pair: `config status`, `config add FILE`,
# `config commit`, `config pull`. Untracked files are hidden, so `config
# status` shows only the dotfiles, not everything else in $HOME.

g() { git --git-dir="$gitdir" --work-tree="$HOME" "$@"; }

movebackups() {	# movebackups dir file...: move each file into dir, keeping its path
	typeset dir=$1 f; shift
	for f; do
		mkdir -p "$dir/$(dirname "$f")" && mv "$HOME/$f" "$dir/$f" || return
	done
}
addexclude() {	# keep git from ever adding its own directory or the backups
	mkdir -p "$gitdir/info" && {
		print "/${gitdir#"$HOME"/}/"
		print "/.local/share/vertrice-backup/"
	} >>"$gitdir/info/exclude"
}

home() {
	if [ "$(id -u)" = 0 ]; then
		print -u2 "vertrice-install: run the home stage as your own user, not root."
		exit 1
	fi
	print "home: the dotfiles into $HOME"

	if ! command -v git >/dev/null; then
		print "  FAILED  git is not installed. As root: su -, then pkg_add git"
		fails=$((fails + 1)); finish
	fi

	if [ "$(git --git-dir="$gitdir" rev-parse --is-bare-repository 2>/dev/null)" = true ]; then
		ok "bare repo at $gitdir"
	else
		if [ -e "$gitdir" ]; then
			print "  FAILED  $gitdir exists but is not a bare repo; move it away"
			fails=$((fails + 1)); finish
		fi
		step "clone $url as a bare repo into $gitdir" \
			git clone --bare "$url" "$gitdir" || finish
		if [ $apply = 0 ]; then
			note "after the clone, every file here that the repo also has is"
			note "moved to ~/.local/share/vertrice-backup/DATE/, then the repo's"
			note "files are checked out"
			finish
		fi
	fi

	if grep -q vertrice-backup "$gitdir/info/exclude" 2>/dev/null; then
		ok "git ignores its own directory and the backups"
	else
		step "make git ignore its own directory and the backups" addexclude
	fi
	if [ "$(g config --get status.showUntrackedFiles)" = no ]; then
		ok "status.showUntrackedFiles=no"
	else
		step "hide untracked files (status.showUntrackedFiles=no)" \
			g config status.showUntrackedFiles no
	fi
	# A bare clone records no remote branches; this makes `config pull`
	# and `config status` compare against origin like a normal clone.
	if [ -n "$(g config --get remote.origin.fetch)" ]; then
		ok "origin fetch refspec"
	else
		step "track origin's branches (remote.origin.fetch)" \
			g config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
	fi

	# A bare repo has no index until the first checkout, so an index
	# means the files are already out. After that, changes to them are
	# yours, and `config status` shows them.
	if [ -e "$gitdir/index" ]; then
		ok "files checked out (config status shows your changes)"
	else
		typeset f backup list="" tmp
		backup=$HOME/.local/share/vertrice-backup/$(date +%Y%m%d-%H%M%S)
		# mktemp, not a name made from the pid: /tmp is shared.
		if ! tmp=$(mktemp) || ! g -c core.quotePath=false ls-tree -r --name-only HEAD >"$tmp"; then
			print "  FAILED  cannot list the repo's files"; fails=$((fails + 1)); finish
		fi
		while IFS= read -r f; do
			if [ -e "$HOME/$f" ] || [ -L "$HOME/$f" ]; then
				list="$list $f"	# names with spaces are not in this repo
			fi
		done <"$tmp"
		rm -f "$tmp"
		if [ -n "$list" ]; then
			for f in $list; do note "existing ~/$f"; done
			# shellcheck disable=SC2086
			step "move those to $backup" movebackups "$backup" $list || finish
		fi
		step "check out the repo's files into $HOME" g checkout || finish
	fi
	note "log in again to get the profile; manage the files with: config status"
	finish
}

### Stage 2: the system, as root.

keep_orig() {	# keep_orig file: copy file to file.orig, the first time only
	[ -e "$1.orig" ] && return 0
	if [ -e "$1" ]; then cp -p "$1" "$1.orig"; else : >"$1.orig"; fi
}
rewrite() {	# rewrite file command...: file becomes command's output with file as input
	typeset f=$1 new=$1.vertrice; shift
	if [ -e "$f" ]; then
		cp -p "$f" "$new" && "$@" <"$f" >"$new"
	else	# a new file: start from nothing
		: >"$new" && chmod 0644 "$new" && "$@" </dev/null >"$new"
	fi || { rm -f "$new"; return 1; }
	keep_orig "$f" && mv -f "$new" "$f"
}
put() {		# put src dst mode: install src as dst, root-owned
	keep_orig "$2" && install -o root -g wheel -m "$3" "$1" "$2"
}
same() { [ -e "$2" ] && cmp -s "$1" "$2"; }

# Line edits, used through rewrite. Both read the old file on stdin.
addline() {	# addline line: append line unless an identical line is there
	awk -v l="$1" '{ print } $0 == l { have = 1 } END { if (!have) print l }'
}
setkey() {	# setkey key value: make key=value the one line for key
	awk -F= -v k="$1" -v v="$2" '
		$1 == k { if (!done) print k "=" v; done = 1; next }
		{ print }
		END { if (!done) print k "=" v }'
}
getkey() {	# getkey file key: the value of key=value in file
	awk -F= -v k="$2" '$1 == k { v = substr($0, length(k) + 2) } END { print v }' "$1" 2>/dev/null
}
# The staff class in login.conf is a record of :cap=value: fields over
# continuation lines. staffcaps prints the record's values for our caps;
# setstaff removes our caps wherever they are in the record and puts the
# wanted values right after its first line.
staffcaps() {
	awk -v caps="$staffcaps" '
		BEGIN { n = split(caps, c, " "); for (i = 1; i <= n; i++) sub(/=.*/, "", c[i]) }
		!rec && /^staff[:|]/ { rec = 1 }
		rec { for (i = 1; i <= n; i++) if (match($0, ":" c[i] "=[^:]*"))
			v[i] = substr($0, RSTART + 1, RLENGTH - 1) }
		rec && !/\\$/ { rec = 0 }
		END { for (i = 1; i <= n; i++) printf "%s%s", v[i], (i < n ? " " : "\n") }' "$R/etc/login.conf"
}
setstaff() {
	awk -v caps="$staffcaps" '
		BEGIN { n = split(caps, c, " ") }
		!rec && /^staff[:|]/ { rec = 1; first = 1 }
		rec {
			for (i = 1; i <= n; i++) { name = c[i]; sub(/=.*/, "", name)
				gsub(":" name "=[^:]*", "") }
			end = !/\\$/
			if (!/^[ \t]*:\\$/ || first) print
			if (first && !end) for (i = 1; i <= n; i++) printf "\t:%s:\\\n", c[i]
			first = 0
			if (end) rec = 0
			next
		}
		{ print }'
}
newlogin() {	# rewrite login.conf, checking the result parses before using it
	typeset f=$R/etc/login.conf
	cp -p "$f" "$f.vertrice" && setstaff <"$f" >"$f.vertrice" || return
	if ! cap_mkdb -f "$f.vertrice" "$f.vertrice"; then
		print "  cap_mkdb rejects the edited login.conf; left unchanged"
		rm -f "$f.vertrice" "$f.vertrice.db"; return 1
	fi
	rm -f "$f.vertrice.db"
	keep_orig "$f" && mv -f "$f.vertrice" "$f" || return
	# login.conf.db, when present, is what login reads; rebuild it.
	[ ! -e "$f.db" ] || cap_mkdb "$f"
}

hotplugput() {
	install -d -o root -g wheel -m 0755 "$R/etc/hotplug" &&
		put "$data/hotplug-attach" "$R/etc/hotplug/attach" 0755
}
updatesput() {	# the update counter, root's; see vertrice-updates
	install -d -o root -g wheel -m 0755 "$R/usr/local/sbin" &&
		put "$data/vertrice-updates" "$R/usr/local/sbin/vertrice-updates" 0755
}
# Root's crontab line for it: every four hours at a random minute (~), no
# mail unless it fails (-n), one at a time (-s); crontab(5).
updatescron='~	*/4	*	*	*	-ns /usr/local/sbin/vertrice-updates'
addcron() {	# addcron line: append line to root's crontab through crontab(1)
	{ crontab -u root -l 2>/dev/null; print -r -- "$1"; } | crontab -u root -
}
apmput() {	# apmput name: install apm-suspend as /etc/apm/name
	install -d -o root -g wheel -m 0755 "$R/etc/apm" &&
		put "$data/apm-suspend" "$R/etc/apm/$1" 0755
}
newdoas() {	# install doas.conf only if doas -C accepts it; never leave none
	typeset new=$R/etc/doas.conf.vertrice
	install -o root -g wheel -m 0640 "$data/doas.conf" "$new" || return
	if ! doas -C "$new"; then
		print "  doas -C rejects $data/doas.conf; /etc/doas.conf unchanged"
		rm -f "$new"; return 1
	fi
	keep_orig "$R/etc/doas.conf" && mv -f "$new" "$R/etc/doas.conf"
}

# daemon name [flags]: enable it, set its flags if given, and (re)start it.
daemon() {
	typeset d=$1 want changed=0
	# A package's daemon has no rc script until the package is installed.
	if [ ! -e "$R/etc/rc.d/$d" ]; then
		if [ $apply = 0 ]; then
			print "  would   enable and start $d${2:+ with flags: $2} (after its package)"
		else
			print "  FAILED  no /etc/rc.d/$d: is its package installed?"
			fails=$((fails + 1))
		fi
		return
	fi
	if rcctl ls on 2>/dev/null | grep -qx "$d"; then
		ok "$d enabled"
	else
		step "enable $d" rcctl enable "$d"
	fi
	if [ $# -gt 1 ]; then
		want=$2
		if [ "$(rcctl get "$d" flags 2>/dev/null)" = "$want" ]; then
			ok "$d flags: $want"
		else
			# shellcheck disable=SC2086 # flags split into words, as typed
			step "set $d flags: $want" rcctl set "$d" flags $want && changed=1
		fi
	fi
	if ! rcctl check "$d" >/dev/null 2>&1; then
		step "start $d" rcctl start "$d"
	elif [ $changed = 1 ]; then
		step "restart $d with the new flags" rcctl restart "$d"
	else
		ok "$d running"
	fi
}

sysctlput() {
	sysctl "$1=$2" >/dev/null && rewrite "$R/etc/sysctl.conf" setkey "$1" "$2"
}
sysctlset() {	# sysctlset key value: set now and in /etc/sysctl.conf
	typeset k=$1 v=$2
	if [ "$(sysctl -n "$k" 2>/dev/null)" = "$v" ] &&
	    [ "$(getkey "$R/etc/sysctl.conf" "$k")" = "$v" ]; then
		ok "$k=$v (now and at boot)"
	else
		step "set $k=$v now and in /etc/sysctl.conf" sysctlput "$k" "$v"
	fi
}

system() {
	if [ "$(id -u)" != 0 ]; then
		print -u2 "vertrice-install: the system stage changes /etc and must run as root:"
		print -u2 "  doas $0 system"
		print -u2 "Before doas works (fresh install): su -, then run it by its full path."
		exit 1
	fi
	if [ ! -r "$data/pkglist" ]; then
		print -u2 "vertrice-install: no $data/pkglist. Run the copy in ~/.local/bin,"
		print -u2 "after the home stage."
		exit 1
	fi
	typeset user p l lists missing="" class
	# shellcheck disable=SC2012 # one known directory; its owner, not names
	user=${VERTRICE_USER:-$(ls -ld "$data" | awk '{ print $3 }')}
	if [ "$user" = root ]; then
		print -u2 "vertrice-install: $data belongs to root; run the copy in your home."
		exit 1
	fi
	print "system: packages, doas, root's shell, daemons, for user $user"

	# Packages: pkglist, and pkglist.extra with -e. Lines starting with #
	# are comments. Only the missing names go to pkg_add, which also skips
	# anything already installed under a different package name.
	lists=pkglist
	[ $extra = 1 ] && lists="pkglist pkglist.extra"
	for l in $lists; do
		if [ ! -r "$data/$l" ]; then
			print "  FAILED  no $data/$l"
			fails=$((fails + 1))
			continue
		fi
		while read -r p; do
			case $p in ""|"#"*) continue ;; esac
			pkg_info -qe "$p-*" >/dev/null 2>&1 || missing="$missing $p"
		done <"$data/$l"
	done
	if [ -z "$missing" ]; then
		ok "all packages in $lists installed"
	else
		note "missing:$missing"
		# shellcheck disable=SC2086 # one word per package name
		step "pkg_add$missing" pkg_add $missing
	fi
	[ $extra = 1 ] || note "pkglist.extra skipped (add -e to install it)"

	# doas. The rule permits group wheel, so a user outside wheel would be
	# locked out by it: refuse rather than install that.
	if same "$data/doas.conf" "$R/etc/doas.conf"; then
		ok "/etc/doas.conf is vertrice's"
	elif ! awk -F: -v u="$user" '$1 == "wheel" { n = split($4, m, ","); for (i = 1; i <= n; i++) if (m[i] == u) f = 1 } END { exit !f }' "$R/etc/group"; then
		print "  FAILED  $user is not in group wheel, so the doas rule would not"
		print "          let $user in. First: usermod -G wheel $user"
		fails=$((fails + 1))
	else
		step "install /etc/doas.conf after doas -C accepts it" newdoas
	fi

	# Root's shell.
	if same "$data/root.kshrc" "$R/root/.kshrc"; then
		ok "/root/.kshrc is vertrice's"
	else
		step "install /root/.kshrc" put "$data/root.kshrc" "$R/root/.kshrc" 0644
	fi
	if grep -qx 'export ENV=/root/.kshrc' "$R/root/.profile" 2>/dev/null; then
		ok "/root/.profile sets ENV"
	else
		step "add 'export ENV=/root/.kshrc' to /root/.profile" \
			rewrite "$R/root/.profile" addline 'export ENV=/root/.kshrc'
	fi

	# USB notices.
	if same "$data/hotplug-attach" "$R/etc/hotplug/attach"; then
		ok "/etc/hotplug/attach is vertrice's"
	else
		step "install /etc/hotplug/attach" hotplugput
	fi

	# Update counts for the bar (sb-updates): root counts, the user reads.
	if same "$data/vertrice-updates" "$R/usr/local/sbin/vertrice-updates"; then
		ok "/usr/local/sbin/vertrice-updates is vertrice's"
	else
		step "install /usr/local/sbin/vertrice-updates" updatesput
	fi
	if crontab -u root -l 2>/dev/null | grep -qxF -- "$updatescron"; then
		ok "root's crontab runs vertrice-updates"
	else
		step "add vertrice-updates to root's crontab (every 4 hours)" \
			addcron "$updatescron"
	fi

	# Lock X before sleeping: apmd runs these before suspend and hibernate.
	for p in suspend hibernate; do
		if same "$data/apm-suspend" "$R/etc/apm/$p"; then
			ok "/etc/apm/$p locks X first"
		else
			step "install /etc/apm/$p (lock X before sleeping)" apmput "$p"
		fi
	done

	# Browser memory: the staff class and its limits.
	class=$(awk -F: -v u="$user" '$1 == u { print $5 }' "$R/etc/master.passwd")
	if [ "$class" = staff ]; then
		ok "$user is in login class staff"
	else
		step "put $user in login class staff (was '${class:-default}')" usermod -L staff "$user"
	fi
	if [ "$(staffcaps)" = "$staffcaps" ]; then
		ok "staff class limits: $staffcaps"
	else
		note "staff class now: $(staffcaps)"
		step "set staff class limits in /etc/login.conf: $staffcaps" newlogin
	fi

	# Daemons. sndiod is on by default; apmd -z 7 suspends at 7% battery
	# on no AC. No -A/-L/-H: obsdfreqd sets the CPU speed.
	daemon sndiod
	daemon apmd "-z 7"
	daemon obsdfreqd "-m 100,50 -r 50,90 -T 85,65"
	daemon hotplugd
	daemon messagebus
	daemon unwind	# resolvd then points resolv.conf at it

	# Console: Caps Lock is Escape, and X's key repeat (300 ms, then 50
	# a second). wsconsctl.conf is read at boot.
	for p in 'keyboard.map+="keysym Caps_Lock = Escape"' \
	    keyboard.repeat.del1=300 keyboard.repeat.deln=20; do
		if grep -qxF "$p" "$R/etc/wsconsctl.conf" 2>/dev/null; then
			ok "$p in /etc/wsconsctl.conf"
		else
			step "add $p to /etc/wsconsctl.conf (next boot)" \
				rewrite "$R/etc/wsconsctl.conf" addline "$p"
		fi
	done

	# Battery charge limit, where the machine's driver offers one.
	if sysctl -n hw.battery.chargestop >/dev/null 2>&1; then
		sysctlset hw.battery.chargestop 80
		sysctl -n hw.battery.chargestart >/dev/null 2>&1 &&
			sysctlset hw.battery.chargestart 75
	else
		note "no hw.battery.chargestop on this machine: no charge limit"
	fi

	# Audio recording: off unless asked for with -r.
	if [ $record = 1 ]; then
		sysctlset kern.audio.record 1
	else
		note "kern.audio.record=$(sysctl -n kern.audio.record 2>/dev/null) (-r turns recording on)"
	fi

	# sshd: on if "Start sshd(8) by default?" was answered yes at install.
	# Left as it is; a laptop nobody logs in to remotely does not need it.
	if rcctl ls on 2>/dev/null | grep -qx sshd; then
		note "sshd is enabled. Not used? rcctl disable sshd; rcctl stop sshd"
	fi
	finish
}

### Optional: the laptop pf.conf, as root.
#
# Not part of the system stage: it changes what reaches the machine from the
# network, so it is its own choice. The file is checked with pfctl -nf (parse
# only, nothing loaded) before it replaces /etc/pf.conf, then loaded.

newpf() {
	typeset new=$R/etc/pf.conf.vertrice
	install -o root -g wheel -m 0600 "$data/pf.conf" "$new" || return
	if ! pfctl -nf "$new"; then
		print "  pfctl -nf rejects $data/pf.conf; /etc/pf.conf unchanged"
		rm -f "$new"; return 1
	fi
	keep_orig "$R/etc/pf.conf" && mv -f "$new" "$R/etc/pf.conf" &&
		pfctl -f "$R/etc/pf.conf"
}

pf() {
	if [ "$(id -u)" != 0 ]; then
		print -u2 "vertrice-install: the pf stage changes /etc/pf.conf and must run as root:"
		print -u2 "  doas $0 pf"
		exit 1
	fi
	print "pf: the laptop pf.conf (read $data/pf.conf first)"
	if same "$data/pf.conf" "$R/etc/pf.conf"; then
		ok "/etc/pf.conf is vertrice's"
	else
		note "inbound: nothing, unless tcp_in is set in the file"
		if [ $apply = 0 ]; then	# parsing loads nothing, so the plan can
			if pfctl -nf "$data/pf.conf" >/dev/null 2>&1; then
				ok "pfctl -nf accepts $data/pf.conf"
			else
				note "pfctl -nf rejects it; see: pfctl -nf $data/pf.conf"
			fi
		fi
		step "install /etc/pf.conf after pfctl -nf accepts it, and load it" newpf
	fi
	finish
}

case $1 in
home)	home ;;
system)	system ;;
pf)	pf ;;
check)	exec "$data/check" ;;
*)	usage ;;
esac
