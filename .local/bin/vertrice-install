#!/bin/sh

# vertrice-install: the system half of vertrice: packages, /etc files, cron,
# services. Read it, then run it as root:
#	doas sh ~/.local/bin/vertrice-install
# Before doas.conf exists, use: su -, then sh ~you/.local/bin/vertrice-install
# It is safe to run again, except for the two appends at the end.
#
# The home half comes first, as you, once root has run pkg_add git. It puts
# this script and the files it installs in your home. The third line, before
# anything is written, limits the checkout to this system's files: the list
# in ~/.local/share/openbsd, or darwin on a Mac. After a pull that changes
# the list, run the second and third lines again.
#	git clone --bare https://github.com/stokesgeo/vertrice.git ~/.local/share/vertrice.git
#	cd ~/.local/share/vertrice.git
#	git show HEAD:.local/share/$(uname | tr A-Z a-z)/sparse-checkout | git --work-tree=$HOME sparse-checkout set --no-cone --stdin
#	git --work-tree=$HOME checkout -f
#	git config status.showUntrackedFiles no

# A Mac runs its own install, as you, not root.
[ "$(uname)" = Darwin ] && exec sh "$(dirname "$0")/../share/darwin/install"

# Root runs this, so "you" is found as the owner of the script. Root's mail
# goes to you.
u=$(stat -f %Su "$0")
cd "$(dirname "$0")/../share/openbsd" || exit
pkg_add -l pkglist			# the optional rest: pkg_add -l pkglist.extra
# Each config is checked before it goes live, so a typo cannot lock you out.
# doas.conf is the two rule files joined; doas -C parses the result.
cat doas.conf doas-agent.conf >/etc/doas.new && doas -C /etc/doas.new && install -m 640 /etc/doas.new /etc/doas.conf; rm -f /etc/doas.new
install -m 644 root.kshrc /root/.kshrc
install -m 644 login.conf.d/staff /etc/login.conf.d/staff
# pfctl -n only parses. The rules load only if they parse.
pfctl -nf pf.conf && install -m 600 pf.conf /etc/pf.conf && pfctl -f /etc/pf.conf
# apmd(8) runs /etc/apm/suspend on suspend; hibernate shares the script.
mkdir -p /etc/apm && install -m 755 apm-suspend /etc/apm/suspend && ln -sf suspend /etc/apm/hibernate
install -m 755 hotplug-attach /etc/hotplug/attach
# It writes each new disk's name here, for hotplug-watch. Made once: a
# second run must not look like an attach.
[ -e /var/db/hotplug-disk ] || install -m 644 /dev/null /var/db/hotplug-disk
# Each crontab is rewritten without our old line, then with the current one,
# so a second run does not double it. Other entries stay.
(crontab -l | grep -v /var/db/updates; cat updates.cron) | crontab -
# Mail for root, from cron and daily(8), reaches you unless an alias exists.
grep -q '^root:' /etc/mail/aliases || echo "root: $u" >>/etc/mail/aliases; newaliases
# rcctl fails on a service that is not installed, so base and packages are
# enabled apart.
rcctl enable apmd hotplugd unwind	# in base
rcctl enable messagebus obsdfreqd	# from pkglist
# apmd suspends at 7% battery.
rcctl set apmd flags -z 7
# obsdfreqd(1) pairs are on AC, on battery. -T: above this many degrees C,
# the top speed drops until the CPU cools.
rcctl set obsdfreqd flags -m 100,50 -r 50,90 -T 85,65
# These two append. A second run repeats the lines; the last line read wins.
cat wsconsctl.conf >>/etc/wsconsctl.conf
cat fbtab >>/etc/fbtab
echo "Done. Reboot to load it all."
