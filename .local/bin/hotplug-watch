#!/bin/sh

# hotplug-watch: a notice when /etc/hotplug/attach writes a new disk's name.

f=/var/run/hotplug-disk
p=-p; while [ ! -e "$f" ]; do p=; sleep 10; done	# made by the first attach after boot: notify it
echo "$f" | exec entr -n $p sh -c 'notify-send "💾 $(cat /var/run/hotplug-disk) attached" "Super+F9 to mount it."'
