#!/bin/sh

# hotplug-watch: notify when /etc/hotplug/attach writes a new disk's name.

# vertrice-install makes the file, and it survives a reboot, so it is there
# at login. entr(1) -p waits for a change before it runs: no notice for the
# disk it named before.

echo /var/db/hotplug-disk | exec entr -np sh -c 'notify-send "💾 $(cat /var/db/hotplug-disk) attached" "Super+F9 to mount it."'
