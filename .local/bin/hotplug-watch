#!/bin/sh

# hotplug-watch: notify when a disk is plugged in. The root side,
# /etc/hotplug/attach (see ~/.local/share/openbsd/hotplug-attach), writes the
# disk's name to /var/run/hotplug-disk; this loop, started by xprofile in the
# user's session, watches that file with entr(1) and sends the notification.
# Root never reaches into the session; the session only reads a file.

f=/var/run/hotplug-disk

pgrep -f "entr.*hotplug-disk" >/dev/null && exit 0	# one watcher per session

# The file appears on the first attach after boot (/var/run is cleared).
# If it existed already, it names an old disk: -p skips entr's first run.
# If we waited for it, that first run is the attach that just happened.
postpone=-p
while [ ! -e "$f" ]; do postpone=; sleep 10; done

echo "$f" | exec entr -n $postpone sh -c \
	'notify-send "💾 $(cat /var/run/hotplug-disk) attached" "Super+F9 to mount it."'
