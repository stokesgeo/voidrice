#!/bin/sh

# queueandnotify: give each URL in the newsboat queue file to qndl, which
# queues the download with nq(1), then empty the file.

queuefile="${XDG_DATA_HOME:-$HOME/.local/share}/newsboat/queue"

while read -r line; do
	[ -z "$line" ] && continue
	url="${line%%[	 ]*}"
	qndl "$url" "ftp"	# base ftp(1): saves under the URL's file name
done < "$queuefile"

echo > "$queuefile"
