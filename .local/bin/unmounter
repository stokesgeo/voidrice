#!/bin/ksh

# unmounter: unmount the drive picked in dmenu. The system disk is never
# offered. A softraid volume with nothing left mounted is locked (bioctl -d).

# doas may ask for a password, so run in a terminal.
[ -t 0 ] || exec floatterm floatterm 64x4 "$0"

# The system disk (sd0, say): the device mounted on /, without its partition letter.
rootdisk=$(mount | awk '$3 == "/" {sub("/dev/", "", $1); sub("[a-p]$", "", $1); print $1}')
offered=$(mount | awk -v r="/dev/$rootdisk" '
	index($1, r) == 1 { next }
	$1 ~ /^simple-mtpfs/	{ printf "📱%s (%s)\n", $3, $1; next }
	$1 ~ /^\/dev\//		{ printf "💾%s (%s)\n", $3, $1 }')
chosen=$(print -r -- "$offered" | dmenu -i -p "Unmount which drive?") || exit 1
print -r -- "$offered" | grep -qxF -- "$chosen" || exit 1	# only what was offered
mp=$(print -r -- "$chosen" | sed 's|^[^/]*||; s| (.*||')	# "💾/mnt/usb (/dev/sd1i)"
dev=$(print -r -- "$chosen" | sed 's|.*(||; s|)$||')
[ -n "$mp" ] || exit 1

doas umount "$mp" || { notify-send "💾 Unmount failed." "$mp is busy? Close programs using it."; exit 1; }
case $mp in /mnt/*) doas rmdir "$mp" 2>/dev/null ;; esac
notify-send "💾 Drive unmounted." "$mp: safe to remove."

# If nothing of this disk stays mounted, try bioctl -d: it locks a softraid
# volume and fails on a plain stick.
disk=${dev#/dev/}; disk=${disk%[a-p]}
case $disk in sd[0-9]*)
	if ! mount | awk '{print $1}' | grep -q "^/dev/$disk[a-p]\$" &&
	    doas bioctl -d "$disk" 2>/dev/null; then
		notify-send "🔒 Drive locked." "$disk detached."
	fi
esac
