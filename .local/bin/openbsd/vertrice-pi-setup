#!/bin/sh
set -eu
[ "$(id -u)" != 0 ] || { echo 'vertrice-pi-setup: run as the laptop user, not root.' >&2; exit 1; }
command -v node >/dev/null
command -v npm >/dev/null
app=$HOME/.local/share/vertrice-pi
if [ -e "$app/current" ] || [ -L "$app/current" ] || [ -e "$app/node_modules" ] || [ -L "$app/node_modules" ] || [ -e "$app/pi" ] || [ -L "$app/pi" ]; then
	echo 'vertrice-pi-setup: existing installation retained; no migration or overwrite.'
	exit 0
fi
acquire=$HOME/.local/share/openbsd/pi/acquire/prepare.mjs
[ -f "$acquire" ] && [ ! -L "$acquire" ] || { echo 'vertrice-pi-setup: installed acquisition entrypoint unavailable.' >&2; exit 1; }
umask 077
mkdir -p "$app"
node "$acquire" "$app/build-inputs"
exec "$HOME/.local/bin/openbsd/vertrice-update" --pi --install-first --version 1.6.0
