#!/usr/bin/env python3
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys


def directory(path, private=False):
    info = path.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
        raise ValueError("untrusted directory: " + str(path))
    if private and stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("directory must have mode 0700: " + str(path))


def regular(path, executable=False):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1 or info.st_mode & 0o022:
        raise ValueError("untrusted file: " + str(path))
    if executable and (not info.st_mode & 0o100 or not os.access(path, os.X_OK)):
        raise ValueError("not executable: " + str(path))
    return path.read_bytes()


def digest(data):
    return hashlib.sha256(data).hexdigest()


def app_root(create=False):
    home = Path(os.environ["HOME"])
    if not home.is_absolute() or home.resolve() != home:
        raise ValueError("HOME must be an absolute path without symlinks")
    directory(home)
    path = home
    for name in (".local", "share", "vertrice-crush", "generations"):
        path = path / name
        if create and not os.path.lexists(path):
            path.mkdir(mode=0o700)
        directory(path, name in ("vertrice-crush", "generations"))
    return path.parent


def validate(generation):
    directory(generation, True)
    receipt = json.loads(regular(generation / "installation.json"))
    if receipt.get("schema") != 1:
        raise ValueError("unsupported installation receipt")
    acquisition = regular(generation / "acquisition.json")
    if digest(acquisition) != receipt["acquisition_sha256"]:
        raise ValueError("acquisition receipt mismatch")
    identity = json.loads(acquisition)
    for key in ("upstream", "commit", "patch_sha256", "source_manifest_sha256"):
        if receipt["source"][key] != identity[key]:
            raise ValueError("source identity mismatch")
    if identity.get("source_unchanged_after_acquisition") is not True:
        raise ValueError("source acquisition was not verified")
    if not re.fullmatch(r"[0-9a-f]{40}", identity["commit"]):
        raise ValueError("invalid source commit")
    for key in ("patch_sha256", "source_manifest_sha256"):
        if not re.fullmatch(r"[0-9a-f]{64}", identity[key]):
            raise ValueError("invalid source digest")
    directory(generation / "notices", True)
    for name in ("LICENSE.md", "vimbubble-LICENSE"):
        data = regular(generation / "notices" / name)
        if not data.strip() or digest(data) != receipt["notices"][name]:
            raise ValueError("license notice mismatch")
    binary = generation / "crush"
    if digest(regular(binary, True)) != receipt["binary_sha256"]:
        raise ValueError("binary checksum mismatch")
    return binary


def main():
    if os.getuid() == 0 or os.geteuid() != os.getuid():
        raise ValueError("run as the ordinary laptop user, not root")
    app = app_root()
    current = app / "current"
    info = current.lstat()
    if not stat.S_ISLNK(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError("current must be a user-owned generation symlink")
    target = os.readlink(current)
    if not re.fullmatch(r"generations/gen-[a-zA-Z0-9_-]+", target):
        raise ValueError("current is outside the private generations directory")
    binary = validate(app / target)
    os.execv(str(binary), [str(binary), *sys.argv[1:]])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError) as error:
        sys.exit("crush: " + str(error) + "; run vertrice-crush-setup for first installation")
