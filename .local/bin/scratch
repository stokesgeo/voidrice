#!/bin/sh

# scratch term|calc: show or hide a scratchpad xterm, and start it on first
# use. The window class (spterm, spcalc) is what cwmrc matches.

case $1 in
	term) name=spterm geo=120x34 cmd= ;;
	calc) name=spcalc geo=50x20 cmd="bc -l" ;;
	*) echo "usage: scratch term|calc" >&2; exit 1 ;;
esac

id=$(xdotool search --classname "^$name\$" | head -n 1)
if [ -z "$id" ]; then
	exec xterm -name "$name" -geometry "$geo" ${cmd:+-e $cmd}
elif xdotool search --onlyvisible --classname "^$name\$" >/dev/null; then
	xdotool windowunmap "$id"
else
	xdotool windowmap "$id" windowactivate "$id"
fi
