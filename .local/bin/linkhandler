#!/bin/sh

# Feed script a url or file location.
# If an image, it will view in nsxiv,
# if a video or gif, it will view in mpv
# if a music file or pdf, it will download,
# otherwise it opens link in browser.

url="${1:-$(xclip -o)}"

# fetch: download $url into a new private directory, as $tmpfile. A fixed
# name in /tmp, chosen by the URL, could be a planted symlink. The file keeps
# its name, so the viewer sees its extension. /tmp is cleared at boot.
fetch() {
	d=$(mktemp -d) || return
	name=$(echo "$url" | sed "s/.*\///;s/%20/ /g")
	tmpfile="$d/${name:-download}"
	curl -sL -o "$tmpfile" "$url"
}

case "$url" in
	*mkv|*webm|*mp4|*youtube.com/watch*|*youtube.com/playlist*|*youtube.com/shorts*|*youtu.be*|*hooktube.com*|*bitchute.com*|*videos.lukesmith.xyz*|*odysee.com*)
		detach mpv -quiet "$url" >/dev/null 2>&1 ;;
	*png|*jpg|*jpe|*jpeg|*gif|*webp)
		fetch && nsxiv -a "$tmpfile" >/dev/null 2>&1 & ;;
	*pdf|*cbz|*cbr)
		fetch && zathura "$tmpfile" >/dev/null 2>&1 & ;;
	*mp3|*flac|*opus|*mp3?source*)
		qndl "$url" "curl -LO" >/dev/null 2>&1 ;;
	*)
		[ -f "$url" ] && detach "$TERMINAL" -e "$EDITOR" "$url" >/dev/null 2>&1 || detach "$BROWSER" "$url" >/dev/null 2>&1
esac
