#!/bin/sh

# Open a terminal window in the same directory as the currently active window.
#
# OpenBSD has no /proc, pstree or tac. ps gives the process tree; proc-cwd
# (~/.local/src/sd, built on first use) reads a process's directory with
# sysctl(2) kern.proc_cwd. If it cannot be built, a plain terminal opens.
src=${SD_SRC:-$HOME/.local/src/sd}
proccwd=$src/proc-cwd
[ -x "$proccwd" ] && [ ! "$src/proc-cwd.c" -nt "$proccwd" ] ||
	(cd -- "$src" && make) >&2 || exec "$TERMINAL"

windowPID=$(xprop -id "$(xprop -root | sed -n "/_NET_ACTIVE_WINDOW/ s/^.*# // p")" | sed -n "/PID/ s/^.*= // p")
# The window's process and all below it, as pstree -n lists them (each
# process, then its children by pid), reversed: the deepest last one first.
# Sorted by pid first, so each process's children are listed in pid order.
PIDlist=$(ps -ax -o pid=,ppid= | sort -n | awk -v root="$windowPID" '
	function walk(p,	n, i, c) {
		order[++len] = p
		n = split(kids[p], c, " ")
		for (i = 1; i <= n; i++)
			walk(c[i])
	}
	$1 != $2 { kids[$2] = kids[$2] " " $1 }
	END {
		if (root !~ /^[0-9]+$/)
			exit
		walk(root)
		for (i = len; i > 0; i--)
			print order[i]
	}')
for PID in $PIDlist; do
	cmdline=$(ps -o args= -p "$PID")
	process_group_leader=$(ps -o comm= -p "$(ps -o pgid= -p "$PID" | tr -d ' ')")
	cwd=$("$proccwd" "$PID" 2>/dev/null)
	# zsh and lf won't be ignored even if it shows ~ or /
	case "$cmdline" in
		'lf -server') continue ;;
		"${SHELL##*/}"|'lf'|'lf '*) break ;;
	esac
	# git (and its sub-processes) will show the root of a repository instead of the actual cwd, so they're ignored
	[ "$process_group_leader" = 'git' ] || [ ! -d "$cwd" ] && continue
	# This is to ignore programs that show ~ or / instead of the actual working directory
	[ "$cwd" != "$HOME" ] && [ "$cwd" != '/' ] && break
done
[ "$PWD" != "$cwd" ] && [ -d "$cwd" ] && { cd "$cwd" || exit 1; }
"$TERMINAL"
