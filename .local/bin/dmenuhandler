#!/bin/sh

# dmenuhandler [URL|FILE]: pick in dmenu how to open a link or file. With no
# argument, dmenu asks for one.

url="${1:-$(true | dmenu -p "Paste URL or file path")}"

[ -z "$url" ] && exit

fetch() { d=$(mktemp -d) && tmpfile=$d/${url##*/} && ftp -MV -o "$tmpfile" "$url"; }	# mktemp -d: a private dir, so no one can plant a file at a guessable /tmp name

case "$(printf "copy url\nnsxiv\nsetbg\nPDF\nbrowser\nlynx\nvim\nmpv\nmpv loop\nmpv float\nqueue download\nqueue yt-dlp\nqueue yt-dlp audio" | dmenu -i -p "Open it with?")" in
	"copy url" ) echo "$url" | xclip -selection clipboard ;;
	mpv ) detach mpv -quiet "$url" >/dev/null 2>&1 ;;
	"mpv loop" ) detach mpv -quiet --loop "$url" >/dev/null 2>&1 ;;
	"mpv float" ) detach "$TERMINAL" -e mpv --geometry=+0-0 --autofit=30% --title="mpvfloat" "$url" >/dev/null 2>&1 ;;
	"queue yt-dlp" ) qndl "$url" >/dev/null 2>&1 ;;
	"queue yt-dlp audio" ) qndl "$url" 'yt-dlp -o %(title)s.%(ext)s -f bestaudio --embed-metadata --restrict-filenames' ;;
	"queue download" ) qndl "$url" "ftp" >/dev/null 2>&1 ;;
	PDF ) fetch && zathura "$tmpfile" >/dev/null 2>&1 ;;
	nsxiv ) fetch && nsxiv -a "$tmpfile" >/dev/null 2>&1 ;;
	vim ) fetch && detach "$TERMINAL" -e "$EDITOR" "$tmpfile" >/dev/null 2>&1 ;;
	setbg ) ftp -MV -o "${XDG_CACHE_HOME:-$HOME/.cache}/pic" "$url" && setbg "${XDG_CACHE_HOME:-$HOME/.cache}/pic" ;;
	browser ) detach "$BROWSER" "$url" >/dev/null 2>&1 ;;
	lynx ) detach "$TERMINAL" -e lynx "$url" >/dev/null 2>&1 ;;
esac
