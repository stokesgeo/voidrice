#!/bin/sh

# Feed this script a link and it will give dmenu
# some choice programs to use to open it.
# With no argument, dmenu asks for one.

url="${1:-$(true | dmenu -p "Paste URL or file path")}"

[ -z "$url" ] && exit

# Keep local paths as files, including names that look like options.
localfile=$url
if [ -f "$url" ]; then
	case $url in -*) localfile=./$url ;; esac
fi

fetch() {
	if [ -f "$url" ]; then
		tmpfile=$localfile
	else
		# A private directory prevents planted symlinks at a guessable name.
		d=$(mktemp -d) && tmpfile=$d/${url##*/} && ftp -MV -o "$tmpfile" "$url"
	fi
}

textbrowser=${TERMINAL_BROWSER:-lynx}
case "$(printf 'copy url\nnsxiv\nsetbg\nPDF\nbrowser\n%s\nvim\nmpv\nmpv loop\nmpv float\nqueue download\nqueue yt-dlp\nqueue yt-dlp audio\n' "$textbrowser" | dmenu -i -p "Open it with?")" in
	"copy url" ) echo "$url" | xclip -selection clipboard ;;
	mpv ) ifinstalled mpv && detach mpv -quiet "$localfile" >/dev/null 2>&1 ;;
	"mpv loop" ) ifinstalled mpv && detach mpv -quiet --loop "$localfile" >/dev/null 2>&1 ;;
	"mpv float" ) ifinstalled mpv && detach "$TERMINAL" -e mpv --geometry=+0-0 --autofit=30% --title="mpvfloat" "$localfile" >/dev/null 2>&1 ;;
	"queue yt-dlp" ) qndl "$url" >/dev/null 2>&1 ;;
	"queue yt-dlp audio" ) qndl "$url" 'yt-dlp -o %(title)s.%(ext)s -f bestaudio --embed-metadata --restrict-filenames' ;;
	"queue download" ) qndl "$url" "ftp" >/dev/null 2>&1 ;;
	PDF ) ifinstalled zathura && fetch && zathura "$tmpfile" >/dev/null 2>&1 ;;
	nsxiv ) fetch && nsxiv -a "$tmpfile" >/dev/null 2>&1 ;;
	vim ) fetch && detach "$TERMINAL" -e "$EDITOR" "$tmpfile" >/dev/null 2>&1 ;;
	setbg )
		if [ -f "$url" ]; then
			setbg "$localfile"
		else
			ftp -MV -o "${XDG_CACHE_HOME:-$HOME/.cache}/pic" "$url" && setbg "${XDG_CACHE_HOME:-$HOME/.cache}/pic"
		fi ;;
	browser ) detach "$BROWSER" "$url" >/dev/null 2>&1 ;;
	"$textbrowser" ) detach "$TERMINAL" -e "$textbrowser" "$url" >/dev/null 2>&1 ;;
esac
