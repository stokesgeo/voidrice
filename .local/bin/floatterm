#!/bin/sh

# floatterm NAME SIZE [COMMAND ...]: a terminal window named NAME (the
# instance cwmrc and xdotool match), SIZE columns x rows. st and xterm spell
# the options apart; st when $TERMINAL is st, else xterm.

name=$1 size=$2
shift 2
[ $# -gt 0 ] && set -- -e "$@"
if [ "$TERMINAL" = st ]; then exec st -n "$name" -g "$size" "$@"
else exec xterm -name "$name" -geometry "$size" "$@"
fi
