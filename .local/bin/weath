#!/bin/sh

# Get the weather on the terminal. An alternative location can be passed as an
# argument, and/or 'cp' to copy the forecast as plaintext to the clipboard.
# With no location, the cached report shows; WTTRURL sets another wttr.in-style host.

[ "$1" = cp ] && copy=true && shift

[ -n "$2" ] && { printf "Invalid option '%s'! The only valid option is 'cp'.\n" "$1" >&2; exit 1 ;}

report="${XDG_CACHE_HOME:-$HOME/.cache}/weatherreport"

data="$([ -z "$1" ] && cat "$report" 2>/dev/null ||
	ftp -MV -w 5 -U curl -o - "https://${WTTRURL:-wttr.is}/$1?F${copy:+T}" 2>/dev/null)" ||
	{ printf "Failed to get weather forecast!\nCheck your internet connection and the supplied location.\n" >&2; exit 1 ;}

[ -n "$copy" ] && {
	[ -z "$1" ] && read -r location <"$report" && location="${location#*: }"
	echo "$data" | sed "s/$(printf '\033')\[[^m]*m//g" | xclip -selection clipboard
	printf "Weather forecast for '%s' copied to clipboard.\n" "${1:-$location}"
	exit ;}

echo "$data" | less -S
