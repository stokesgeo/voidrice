#!/bin/sh

# ghostty on the Mac, as the scripts call $TERMINAL: a new window in this
# directory, running the command after -e if one is given. Ghostty's own
# command cannot open a window on macOS; open(1) starts another Ghostty
# instead. What open starts gets no environment from here, so the command
# runs under a login sh, which reads the profile. Each Ghostty started so
# quits with its last window, or it stays on, windowless.

n=$# e= next=
for a; do
	if [ -n "$next" ]; then
		if ! command -v "$a" >/dev/null 2>&1; then
			printf 'ghostty: %s is not installed\n' "$a" >&2
			notify-send "Program not installed" "$a: see the optional packages in man vertrice."
			exit 127
		fi
		next=
	fi
	if [ -z "$e" ] && [ "$a" = -e ]; then
		e=1 next=1; set -- "$@" -e /bin/sh -lc 'exec "$@"' sh
	else
		set -- "$@" "$a"
	fi
done
shift "$n"
[ -z "$next" ] || { echo "ghostty: -e needs a command" >&2; exit 2; }
exec open -na Ghostty.app --args --quit-after-last-window-closed=true \
	--window-inherit-working-directory=false --working-directory="$PWD" "$@"
