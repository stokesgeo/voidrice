#!/bin/sh

# nightlight [kelvin]: toggle a warm screen (sct, 4000 K by default). Super+F4.

state=${XDG_CACHE_HOME:-$HOME/.cache}/nightlight

if [ -f "$state" ] && [ -z "$1" ]; then
	sct && rm -f "$state" && notify-send "🌞 Night light off"
else
	sct "${1:-4000}" && : > "$state" && notify-send "🌙 Night light ${1:-4000} K"
fi
