#!/bin/ksh

# theme day|night|toggle|auto|clock|wal: the terminals' palette, and dunst's
# and zathura's colours (x11/themes/NAME.dunst, NAME.zathura; wal's own).
# Day and night also write gtk-3.0/settings.ini (wal leaves it), which is
# why the dotfiles do not track it.
# Super+F8 toggles; xprofile runs `theme clock`: day from 07:00, night from 19:00.
# Open terminals are recoloured with OSC sequences; zathura and GTK
# programs on their next start.

conf=${XDG_CONFIG_HOME:-$HOME/.config}
dir=$conf/x11/themes
wal=${XDG_CACHE_HOME:-$HOME/.cache}/wal
state=${XDG_CACHE_HOME:-$HOME/.cache}/theme
# The GTK themes for day and night. Placeholders, pending the owner's pick;
# both ship with gtk+3.
gtkday=Adwaita gtknight=Adwaita-dark

# gtk THEME: settings.ini, whole. The profile's QT_QPA_PLATFORMTHEME makes
# Qt programs follow it.
gtk() {
	mkdir -p "$conf/gtk-3.0"
	cat > "$conf/gtk-3.0/settings.ini" <<-EOF
	# Written by ~/.local/bin/theme: change it there.
	[Settings]
	gtk-theme-name=$1
	gtk-icon-theme-name=Adwaita
	gtk-font-name=Sans 10
	gtk-cursor-theme-size=0
	gtk-toolbar-style=GTK_TOOLBAR_TEXT
	gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
	gtk-button-images=0
	gtk-menu-images=1
	gtk-enable-event-sounds=1
	gtk-enable-input-feedback-sounds=1
	gtk-xft-antialias=1
	gtk-xft-hinting=1
	gtk-xft-hintstyle=hintfull
	gtk-xft-rgba=rgb
	gtk-cursor-theme-name=Adwaita
	EOF
}

auto() { h=$(date +%H); [ "$h" -ge 7 ] && [ "$h" -lt 19 ] && print day || print night; }

apply() {
	typeset p=$dir/$1 d=$dir/$1.dunst z=$dir/$1.zathura k v seq=
	[ "$1" = wal ] && p=$wal/colors.Xresources d=$wal/dunstrc z=$wal/zathurarc
	[ -n "$DISPLAY" ] && xrdb -merge "$p"
	while read -r k v; do
		case $k in
		\*.color*:)	k=${k#\*.color}; seq="$seq\033]4;${k%:};$v\007" ;;
		\*.foreground:)	seq="$seq\033]10;$v\007" ;;
		\*.background:)	seq="$seq\033]11;$v\007" ;;
		\*.cursorColor:) seq="$seq\033]12;$v\007" ;;
		esac
	done < "$p"
	# Every tty of mine (OpenBSD ptys are named tty[pqrs]*) gets the new colours.
	for t in $(ps -U "$(id -u)" -o tty= | sort -u | grep -E '^[pqrs]'); do
		[ -w "/dev/tty$t" ] && printf "$seq" > "/dev/tty$t" 2>/dev/null
	done
	mkdir -p "$conf/dunst/dunstrc.d" "$conf/zathura"
	cp "$d" "$conf/dunst/dunstrc.d/theme.conf"; cp "$z" "$conf/zathura/theme"
	dunstctl reload >/dev/null 2>&1
	case $1 in
	day)	gtk "$gtkday" ;;
	night)	gtk "$gtknight" ;;
	*)	[ -f "$conf/gtk-3.0/settings.ini" ] || gtk "$gtkday" ;;
	esac
	print "$1" > "$state"
}

case $1 in
day|night|wal)	apply "$1" ;;
toggle)		[ "$(cat "$state" 2>/dev/null)" = day ] && apply night || apply day ;;
auto)		apply "$(auto)" ;;
clock)
	[ "$PALETTE" = wal ] && exit 0	# the wallpaper sets the colours
	# Check every 5 minutes, so a laptop that slept catches up on waking.
	# Keep one loop: leave if another "theme clock" runs.
	pgrep -U "$(id -u)" -f 'theme clock' | grep -vx "$$" | grep -q . && exit 0
	last=
	while xrdb -query >/dev/null 2>&1; do
		now=$(auto)
		[ "$now" != "$last" ] && { apply "$now"; last=$now; }
		sleep 300
	done
	;;
*)	print -u2 "usage: theme day|night|toggle|auto|clock|wal"; exit 1 ;;
esac
