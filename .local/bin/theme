#!/bin/ksh

# theme day|night|toggle|auto|clock|wal: the terminals' palette
# (x11/themes/NAME), and dunst's and zathura's colours from it (wal's own).
# Day and night also write gtk-3.0/settings.ini and gtk.css (wal leaves
# them), which is why the dotfiles do not track them.
# Super+F8 toggles; xprofile runs `theme clock`: day from 07:00, night from 19:00.
# Open terminals are recoloured with OSC sequences; zathura and GTK
# programs on their next start. On the Mac, see mac below.

conf=${XDG_CONFIG_HOME:-$HOME/.config}
dir=$conf/x11/themes
wal=${XDG_CACHE_HOME:-$HOME/.cache}/wal
state=${XDG_CACHE_HOME:-$HOME/.cache}/theme
# The GTK themes for day and night, both shipped with gtk+3; gtk.css
# gives them the palette's colours.
gtkday=Adwaita gtknight=Adwaita-dark

# gtk THEME: settings.ini, whole. The profile's QT_QPA_PLATFORMTHEME makes
# Qt programs follow it.
gtk() {
	mkdir -p "$conf/gtk-3.0"
	cat > "$conf/gtk-3.0/settings.ini" <<-EOF
	# Written by ~/.local/bin/theme: change it there.
	[Settings]
	gtk-theme-name=$1
	gtk-icon-theme-name=Adwaita
	gtk-font-name=Sans 10
	gtk-cursor-theme-size=0
	gtk-toolbar-style=GTK_TOOLBAR_TEXT
	gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
	gtk-button-images=0
	gtk-menu-images=1
	gtk-enable-event-sounds=1
	gtk-enable-input-feedback-sounds=1
	gtk-xft-antialias=1
	gtk-xft-hinting=1
	gtk-xft-hintstyle=hintfull
	gtk-xft-rgba=rgb
	gtk-cursor-theme-name=Adwaita
	EOF
}

# gtkcss BG FG ACCENT: gtk.css, whole. Adwaita's own rules use fixed
# colours, so the named colours reach only programs that ask for them;
# the rules after them recolour windows, views, entries and selections.
gtkcss() {
	cat > "$conf/gtk-3.0/gtk.css" <<-EOF
	/* Written by ~/.local/bin/theme: Adwaita in the terminals' palette.
	   Running GTK programs pick it up on restart. */
	@define-color theme_bg_color $1; @define-color theme_base_color $1;
	@define-color theme_fg_color $2; @define-color theme_text_color $2;
	@define-color theme_selected_bg_color $3;
	@define-color theme_selected_fg_color $1;
	.background, .view, textview text, entry { color: $2; background-color: $1; }
	selection, *:selected { color: $1; background-color: $3; }
	EOF
}

auto() { h=$(date +%H); [ "$h" -ge 7 ] && [ "$h" -lt 19 ] && print day || print night; }

apply() {
	typeset p=$dir/$1 k v seq= fg bg acc u
	[ "$1" = wal ] && p=$wal/colors.Xresources
	[ -n "$DISPLAY" ] && xrdb -merge "$p"
	while read -r k v; do
		case $k in
		\*.color*:)	k=${k#\*.color}; k=${k%:}; seq="$seq\033]4;$k;$v\007"
			[ "$k" = 4 ] && acc=$v ;;	# the accent, as in dmenu
		\*.foreground:)	seq="$seq\033]10;$v\007" fg=$v ;;
		\*.background:)	seq="$seq\033]11;$v\007" bg=$v ;;
		\*.cursorColor:) seq="$seq\033]12;$v\007" ;;
		esac
	done < "$p"
	# Every tty of mine (OpenBSD ptys are named tty[pqrs]*) gets the new colours.
	for t in $(ps -U "$(id -u)" -o tty= | sort -u | grep -E '^tty[pqrs]'); do
		[ -w "/dev/$t" ] && printf "$seq" > "/dev/$t" 2>/dev/null
	done
	# dunst and zathura: wal's own files, else the palette's colours.
	mkdir -p "$conf/dunst/dunstrc.d" "$conf/zathura"
	if [ "$1" = wal ]; then
		cp "$wal/dunstrc" "$conf/dunst/dunstrc.d/theme.conf"
		cp "$wal/zathurarc" "$conf/zathura/theme"
	else
		for u in low normal critical; do
			printf '[urgency_%s]\n    background = "%s"\n    foreground = "%s"\n' "$u" "$bg" "$fg"
		done > "$conf/dunst/dunstrc.d/theme.conf"
		{ for u in default statusbar inputbar; do
			printf 'set %s-bg "%s"\nset %s-fg "%s"\n' "$u" "$bg" "$u" "$fg"
		done
		printf 'set recolor-lightcolor "%s"\nset recolor-darkcolor "%s"\n' "$bg" "$fg"
		} > "$conf/zathura/theme"
	fi
	dunstctl reload >/dev/null 2>&1
	case $1 in
	day)	gtk "$gtkday"; gtkcss "$bg" "$fg" "$acc" ;;
	night)	gtk "$gtknight"; gtkcss "$bg" "$fg" "$acc" ;;
	*)	[ -f "$conf/gtk-3.0/settings.ini" ] || gtk "$gtkday" ;;
	esac
	print "$1" > "$state"
}

# mac day|night|toggle|auto: the Mac, where day is macOS's light
# appearance and night its dark one. day, night and toggle set it; auto
# takes it as it is. For the clock, set Appearance to Auto: macOS
# switches by itself. Ghostty follows the appearance, between the two
# themes written here; the bar runs `theme auto` on each change, for its
# colours. The state file tells the menus which palette is shown.
mac() {
	typeset now p dark t
	defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q Dark && now=night || now=day
	case $1 in
	day|night)	p=$1 ;;
	toggle)		[ "$now" = day ] && p=night || p=day ;;
	auto)		p=$now ;;
	*)		print -u2 "usage: theme day|night|toggle|auto"; return 1 ;;
	esac
	dark=false; [ "$p" = night ] && dark=true
	[ "$p" = "$now" ] || osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null
	mkdir -p "$conf/ghostty/themes" "${state%/*}"
	for t in day night; do
		{ print "# Written by ~/.local/bin/theme from x11/themes/$t: change it there."
		sed -n 's/^\*\.color\([0-9]*\): /palette = \1=/p; s/^\*\.foreground: /foreground = /p
			s/^\*\.background: /background = /p; s/^\*\.cursorColor: /cursor-color = /p' "$dir/$t"
		} > "$conf/ghostty/themes/vertrice-$t"
	done
	sketchybar --bar color="0xff$(sed -n 's/^\*\.background: #//p' "$dir/$p")" \
		--set '/.*/' label.color="0xff$(sed -n 's/^\*\.foreground: #//p' "$dir/$p")" \
		>/dev/null 2>&1
	print "$p" > "$state"
}
[ "$(uname)" = Darwin ] && { mac "$1"; exit; }

case $1 in
day|night|wal)	apply "$1" ;;
toggle)		[ "$(cat "$state" 2>/dev/null)" = day ] && apply night || apply day ;;
auto)		apply "$(auto)" ;;
clock)
	[ "$PALETTE" = wal ] && exit 0	# the wallpaper sets the colours
	# Check every 5 minutes, so a laptop that slept catches up on waking.
	# Keep one loop: leave if another "theme clock" runs.
	pgrep -U "$(id -u)" -f 'theme clock' | grep -vx "$$" | grep -q . && exit 0
	last=
	while xrdb -query >/dev/null 2>&1; do
		now=$(auto)
		[ "$now" != "$last" ] && { apply "$now"; last=$now; }
		sleep 300
	done
	;;
*)	print -u2 "usage: theme day|night|toggle|auto|clock|wal"; exit 1 ;;
esac
