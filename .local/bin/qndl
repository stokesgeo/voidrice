#!/bin/sh

# $1 is a literal URL; $2 is a command split on whitespace, not shell code.
# nq runs one download-and-notification job at a time; sb-tasks counts them.
[ -z "$1" ] && exit
label=${1##*/}
if ! command -v nq >/dev/null 2>&1; then
	printf '%s\n' 'qndl: nq not found; download not queued' >&2
	notify-send 'qndl: nq not found; download not queued'
	exit 127
fi
cmd=$2
[ -n "$cmd" ] || cmd='yt-dlp --embed-metadata -c'
export NQDIR="${XDG_CACHE_HOME:-$HOME/.cache}/qndl"
notify-send "⏳ Queuing $label..."
# Split command words without pathname expansion. The URL stays one argument.
set -f
nq -cq sh -c '
	label=$1
	shift
	"$@"
	rc=$?
	if [ "$rc" -eq 0 ]; then
		notify-send "👍 $label done."
	else
		notify-send "qndl: $label failed (exit $rc)."
	fi
	exit "$rc"
' qndl "$label" $cmd "$1"
