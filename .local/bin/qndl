#!/bin/sh

# qndl URL [COMMAND]: queue a download of URL with nq(1), then strip query
# junk from the saved file name. COMMAND defaults to yt-dlp. nq runs jobs one
# after another; sb-tasks counts them.
[ -z "$1" ] && exit
base="$(basename "$1")"
notify-send "⏳ Queuing $base..."
cmd="$2"
[ -z "$cmd" ] && cmd="yt-dlp --embed-metadata -ic"
export NQDIR="${XDG_CACHE_HOME:-$HOME/.cache}/qndl"
nq -cq $cmd "$1"
realname="$(echo "$base" | sed -E "s/\?(source|dest).*//;s/%20/ /g")"
nq -cq mv "$base" "$realname"
nq -cq notify-send "👍 $realname done."
