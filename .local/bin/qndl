#!/bin/sh

# qndl URL [COMMAND]: queue a download and notify when it is done.
# COMMAND defaults to yt-dlp; the URL is added as its last word. Downloads
# run one at a time, in the order queued, and land in the directory qndl
# was started from.
#
# The queue is nq(1) (package nq). Its job files live in
# ${XDG_CACHE_HOME:-$HOME/.cache}/qndl, one per job, named ,TIMESTAMP.PID;
# sb-tasks counts them, and `NQDIR=~/.cache/qndl fq` follows their output.
# nq removes the file of a job that succeeded (-c) and keeps a failed one,
# with its output, for `fq -a`.
#
# notify-send reaches dunst from the job: nq runs the job with the
# environment it was given, adding only NQJOBID, so the session's
# DBUS_SESSION_BUS_ADDRESS carries over (read in nq.c, v0.5).
#
# COMMAND is shell text (callers quote words in it, as dmenuhandler's audio
# entry does); the URL goes to the job as a separate argument and is never
# parsed by the shell.

[ -z "$1" ] && exit
base="$(basename "$1")"
notify-send "⏳ Queuing $base..."
cmd="${2:-yt-dlp --embed-metadata -ic}"
realname="$(echo "$base" | sed -E "s/\?(source|dest).*//;s/%20/ /g")"

NQDIR="${XDG_CACHE_HOME:-$HOME/.cache}/qndl"
export NQDIR
# The job files hold the URLs: keep the queue private.
[ -d "$NQDIR" ] || mkdir -p -m 700 "$NQDIR" || exit 1

# In the job: $1 the command, $2 the URL, $3 the name a plain download is
# saved under, $4 that name without the ?source= tail and with spaces for
# %20, as voidrice renamed it.
nq -c -q sh -c '
	eval "$1 \"\$2\"" || { notify-send "❌ $4 failed."; exit 1; }
	[ "$3" = "$4" ] || [ ! -f "$3" ] || mv -- "$3" "$4"
	notify-send "👍 $4 done."' qndl "$cmd" "$1" "$base" "$realname" </dev/null
