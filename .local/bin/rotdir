#!/bin/sh

# rotdir FILE: list the files of the current directory, starting at FILE and
# wrapping round to the ones before it. nsxiv reads this list on standard
# input, so opening the 15th image makes "next" show the 16th.

[ -z "$1" ] && printf "usage: rotdir regex\n" 2>&1 && exit 1

base="$(basename "$1")"

for i in $(ls "$PWD"); do
	[ "$i" = "$base" ] && m=1
	case "$m" in
		1 ) echo "$i" ;;
		* ) lines="$lines$i\n" ;;
	esac
done; echo "$lines"
