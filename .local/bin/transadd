#!/bin/sh

# transadd TORRENT...: add torrents to transmission-daemon, and start the
# daemon first if it is not running. A new daemon can miss remote requests in
# its first moments, hence the sleep.

pgrep -x transmission-daemon >/dev/null || {
	transmission-daemon &&
	notify-send "Starting transmission daemon..." &&
	sleep 3 && sb-refresh
}

transmission-remote -a "$@" && notify-send "🔽 Torrent added."
