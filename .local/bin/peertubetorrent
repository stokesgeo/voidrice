#!/bin/sh
# peertubetorrent LINK QUALITY: add a PeerTube video to transmission, with
# transadd. QUALITY is 360, 480 or 1080.
# 13/07/20 - Arthur Bais

# The API lists torrent URLs ending UUID-QUALITY.torrent. The 37 characters
# are the 36 of the UUID and its dash.
instance=$(echo "$1" | sed -E "s|/w.+||")
vidid=$(echo "$1" | sed -E "s|.+/||")
link=$(ftp -MV -o - "$instance/api/v1/videos/$vidid" 2>/dev/null | grep -o "$instance/download/torrents/.\{37\}$2.torrent")
transadd "$link"
