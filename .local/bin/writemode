#!/bin/sh

# writemode [FILE]: full-screen nvim in Goyo on FILE, or on the writing file changed last.

mkdir -p ~/writing && cd ~/writing || exit
f=${1:-$(proof -l)}
if [ -n "$f" ]; then set -- -c 'silent! Goyo' "$f"; else set -- .; fi
# xterm, even with TERMINAL=st: st has no -fullscreen.
exec xterm -name write -fullscreen -e nvim "$@"
