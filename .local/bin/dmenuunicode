#!/bin/sh

# The famous "get a menu of emojis to copy" script.

# Get user selection via dmenu from emoji files.
# Each line of the char files is a character and its name. dmenu shows the
# line (text from ";" on is cut); the first word is the character.
chosen="$(cat "${XDG_DATA_HOME:-$HOME/.local/share}"/larbs/chars/* |
	{ while read -r line; do echo "${line%%;*}"; done | dmenu -i -l 30 ;})"
chosen="${chosen%% *}"

# Exit if none chosen.
[ -z "$chosen" ] && exit

# If you run this command with an argument, it will automatically insert the
# character. Otherwise, show a message that the emoji has been copied.
# The Mac has no xdotool: there the character is pasted with Cmd+V.
[ -n "$1" ] && [ "$(uname)" = Darwin ] && { printf %s "$chosen" | pbcopy
	exec osascript -e 'tell application "System Events" to keystroke "v" using command down' ;}
[ -n "$1" ] && { xdotool type "$chosen"; exit ;}

printf %s "$chosen" | xclip -selection clipboard
notify-send "'$chosen' copied to clipboard."
