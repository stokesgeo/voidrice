#!/bin/sh

# Set as a cron job to check for new RSS entries for newsboat.
# If newsboat is open, sends it an "R" key to refresh.
# Packages live in /usr/local/bin on OpenBSD; cron's PATH includes it.

notify-send "📰 Updating RSS feeds..."

pgrep -f newsboat$ && xdotool key --window "$(xdotool search --name "^newsboat$")" R && exit

echo 🔃 > /tmp/newsupdate
sb-refresh
newsboat -x reload
rm -f /tmp/newsupdate
sb-refresh
notify-send "📰 RSS feed update complete."
