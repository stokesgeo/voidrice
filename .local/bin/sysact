#!/bin/sh

# A dmenu wrapper script for system functions.
# zzz and ZZZ go through apmd, whose /etc/apm/suspend locks the screen first.

# Mute and pause music while locked. Unmute after only if it was not muted
# before.
lock(){
	was_muted="$(sndioctl -n output.mute)"
	mpc pause & pauseallmpv &
	sndioctl -q output.mute=1
	xlock
	[ "$was_muted" = 0 ] && sndioctl -q output.mute=0
	sb-refresh
}

case "$(printf "🔒 lock\n🚪 leave $WM\n♻️ renew $WM\n🐻 hibernate\n🔃 reboot\n🖥️shutdown\n💤 sleep\n📺 display off" | dmenu -i -p 'Action: ')" in
	'🔒 lock') lock ;;
	"🚪 leave $WM") pkill -TERM -xn "$WM" ;;
	"♻️ renew $WM") pkill -HUP -xn "$WM" ;;
	'🐻 hibernate') ZZZ ;;
	'💤 sleep') zzz ;;
	'🔃 reboot') "$TERMINAL" -e doas reboot ;;
	'🖥️shutdown') "$TERMINAL" -e doas shutdown -p now ;;
	'📺 display off') xset dpms force off ;;
	*) exit 1 ;;
esac
