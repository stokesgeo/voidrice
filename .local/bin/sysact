#!/bin/sh

# A dmenu wrapper script for system functions.
#
# OpenBSD: zzz(8) suspends and ZZZ hibernates through apmd(8), so apmd must
# be enabled (rcctl enable apmd). reboot and shutdown need root: they open
# in a terminal so doas(1) can ask for the password. The locker is xlock(1)
# from base.

wm=cwm
pgrep -x dwm >/dev/null && wm=dwm

lock(){
	was_muted="$(sndioctl -n output.mute)"
	mpc pause & pauseallmpv &
	sndioctl -q output.mute=1
	xlock -mode blank
	[ "$was_muted" = 0 ] && sndioctl -q output.mute=0
	sb-refresh
}

# Lock first, then suspend: the screen is locked when the machine wakes.
lockthen(){
	xlock -mode blank &
	sleep 1
	"$@"
}

case "$(printf "🔒 lock\n🚪 leave $wm\n♻️ renew $wm\n🐻 hibernate\n🔃 reboot\n🖥️shutdown\n💤 sleep\n📺 display off" | dmenu -i -p 'Action: ')" in
	'🔒 lock') lock ;;
	"🚪 leave $wm") pkill -TERM -xn "$wm" ;;
	"♻️ renew $wm") pkill -HUP -xn "$wm" ;;
	'🐻 hibernate') lockthen ZZZ ;;
	'💤 sleep') lockthen zzz ;;
	'🔃 reboot') "$TERMINAL" -e doas reboot ;;
	'🖥️shutdown') "$TERMINAL" -e doas shutdown -p now ;;
	'📺 display off') xset dpms force off ;;
	*) exit 1 ;;
esac
