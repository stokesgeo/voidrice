#!/bin/sh

# ifinstalled PROGRAM...: succeed if each PROGRAM is a command or an installed
# package. Otherwise notify which one is missing and exit 1. Scripts call it
# before they use an optional program. Some optional functions in LARBS require
# programs not installed by default; I use this little script to check for them.

for x in "$@"; do
	if ! command -v "$x" >/dev/null 2>&1 && ! pkg_info -qe "$x-*"; then
 		notify-send "📦 $x" "must be installed for this function." && exit 1 ;
	fi
done
