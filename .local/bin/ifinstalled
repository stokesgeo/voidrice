#!/bin/sh

# Some optional functions in LARBS require programs not installed by default. I
# use this little script to check to see if a command exists and if it doesn't
# it informs the user that they need that command to continue. This is used in
# various other scripts for clarity's sake.
#
# Usage: ifinstalled PROGRAM... Each may be a command or an installed package:
# pkg_info's on OpenBSD, Homebrew's on the Mac.

case $(uname) in
Darwin) pkg() { brew list "$1" >/dev/null 2>&1; } ;;
*) pkg() { pkg_info -qe "$1-*"; } ;;
esac
for x in "$@"; do
	if ! command -v "$x" >/dev/null 2>&1 && ! pkg "$x"; then
 		notify-send "📦 $x" "must be installed for this function." && exit 1 ;
	fi
done
