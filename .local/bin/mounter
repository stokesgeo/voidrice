#!/bin/ksh

# mounter: mount a drive picked in dmenu: 💾 disklabel(8) partitions,
# 🔒 softraid(4) CRYPTO volumes (unlocked with bioctl(8)), 📱 phones
# (simple-mtpfs). An fstab(5) line for the disk's DUID wins. doas(1) has no
# askpass, so it asks in a terminal: hence the xterm.

[ -t 0 ] || exec xterm -name floatterm -geometry 64x4 -e "$0"
doas true || exit 1

escape() { print -r -- "$*" | tr -cd '[:alnum:] -' | tr '[:upper:] ' '[:lower:]-'; }
disknames=$(sysctl -n hw.disknames)
duidof() { print "$disknames" | tr ',' '\n' | sed -n "s/^$1://p"; }

# partitions DISK: "part size type label" for each usable partition.
# The label comes from the stick: printable characters only, printed with -r.
partitions() {
	typeset label
	label=$(doas disklabel "$1" 2>/dev/null | sed -n 's/^label: *//p' | tr -cd '[:print:]')
	doas disklabel -h "$1" 2>/dev/null | l=$label awk -v d="$1" '
		BEGIN { l = ENVIRON["l"] }
		$1 ~ /^[a-p]:$/ && $1 != "c:" && $4 !~ /^(unused|swap)$/ {
			printf "%s%s %s %s %s\n", d, substr($1, 1, 1), $2, $4, l }'
}

set -f	# dmenu text below must never glob
mounted=$(mount)
# The system disk (the one holding /) is never offered, mounted or not.
rootdisk=$(print "$mounted" | awk '$3 == "/" {sub("/dev/", "", $1); sub("[a-p]$", "", $1); print $1}')
inuse=$(doas bioctl softraid0 2>/dev/null | grep -o '<[a-z]*[0-9]*[a-p]>' | tr -d '<>')

drives=$(print "$disknames" | tr ',' '\n' | sed 's/:.*//' | grep -E '^(sd|cd)[0-9]+$' |
	grep -vx "${rootdisk:-none}" |
	while read -r d; do partitions "$d"; done |
	while read -r part size type label; do
		if [ "$type" = RAID ]; then
			print "$inuse" | grep -qx "$part" || print -r -- "🔒$part ($size $label) CRYPTO"
		else	# FUSE mounts may not name the device: check /mnt/PART too
			print "$mounted" | grep -qE "^/dev/$part |^[^ ]* on /mnt/$part " ||
				print -r -- "💾$part ($size $label) $type"
		fi
	done)
# Phone names come from the phone: printed with -r too.
phones=$(simple-mtpfs -l 2>/dev/null | sed 's/^/📱/')

alldrives=$(printf '%s\n%s\n' "$phones" "$drives" | sed '/^$/d')
[ -n "$alldrives" ] || { notify-send "💾 mounter" "Nothing to mount."; exit 1; }
chosen=$(print -r -- "$alldrives" | dmenu -i -p "Mount which drive?") || exit 1
print -r -- "$alldrives" | grep -qxF -- "$chosen" || exit 1	# only what was offered

# getmount NAME: ask where to mount, offering /mnt/NAME; create it on request.
getmount() {
	mp=$({ print "/mnt/$1"; find /mnt /media /mount /home -maxdepth 1 -type d 2>/dev/null; } |
		dmenu -i -p "Mount this drive where?") || exit 1
	[ -n "$mp" ] || exit 1
	if [ ! -d "$mp" ]; then
		[ "$(printf 'No\nYes' | dmenu -i -p "$mp does not exist. Create it?")" = Yes ] || exit 1
		mkdir -p "$mp" 2>/dev/null || doas mkdir -p "$mp" || exit 1
	fi
}

# mountpart PART TYPE: fstab first (by DUID), else ask and mount by type.
mountpart() {
	typeset part=$1 type=$2 disk=${1%?} dev=/dev/$1 duid u g
	duid=$(duidof "$disk")
	if [ -n "$duid" ] && doas mount "$duid.${part#$disk}" 2>/dev/null; then
		notify-send "💾 Drive mounted." "$part mounted from fstab."
		exit 0
	fi
	getmount "$part"
	u=$(id -u) g=$(id -g)
	fuse="allow_other,uid=$u,gid=$g,nosuid,nodev"	# nosuid,nodev on every mount
	case $type in
		MSDOS|NTFS)	# OpenBSD labels exFAT and NTFS alike: try each
			{ [ "$type" = MSDOS ] &&
				doas mount_msdos -o nosuid,nodev -u "$u" -g "$g" "$dev" "$mp" 2>/dev/null; } ||
			doas mount.exfat -o "$fuse" "$dev" "$mp" 2>/dev/null ||
			doas ntfs-3g -o "$fuse" "$dev" "$mp" ;;
		4.2BSD)	doas mount -o nosuid,nodev "$dev" "$mp" ;;
		ext2fs)	doas mount_ext2fs -o nosuid,nodev "$dev" "$mp" ;;
		ISO9660) doas mount_cd9660 -o nosuid,nodev "$dev" "$mp" ;;
		*)	false ;;
	esac || { notify-send "💾 Mount failed." "$part ($type)"; exit 1; }
	notify-send "💾 Drive mounted." "$part mounted to $mp."
}

case $chosen in
	💾*)
		set -- ${chosen#💾}
		mountpart "$1" "${chosen##* }"
		;;
	🔒*)
		set -- ${chosen#🔒}
		print "Passphrase for $1:"
		# bioctl prints "softraid0: CRYPTO volume attached as sd3".
		new=$(doas bioctl -c C -l "/dev/$1" softraid0) || exit 1
		new=$(print -r -- "$new" | sed -n 's/.* volume attached as \(sd[0-9]*\)$/\1/p')
		[ -n "$new" ] || { notify-send "🔒 Unlock failed." "$1"; exit 1; }
		disknames=$(sysctl -n hw.disknames)
		inner=$(partitions "$new" | grep -v ' RAID ')
		if [ "$(print -r -- "$inner" | wc -l)" -gt 1 ]; then
			all=$inner
			inner=$(print -r -- "$all" | dmenu -i -p "Mount which partition of $new?") || exit 1
			print -r -- "$all" | grep -qxF -- "$inner" || exit 1	# only what was offered
		fi
		set -- $inner
		[ -n "$1" ] || exit 1
		notify-send "🔓 Decrypted." "$new unlocked."
		mountpart "$1" "$3"
		;;
	📱*)
		notify-send "❗Note" "Remember to allow file access on your phone now."
		name=${chosen#📱}
		getmount "$(escape "${name#*: }")"
		doas simple-mtpfs -o allow_other,nosuid,nodev -o fsname="simple-mtpfs-$(escape "${name#*: }")" \
			--device "${name%%:*}" "$mp" || { notify-send "📱 Mount failed."; exit 1; }
		notify-send "🤖 Android mounted." "Android device mounted to $mp."
		;;
esac
