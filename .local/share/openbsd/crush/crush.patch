+package permission
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAdminApprovalPaths(t *testing.T) {
+	for _, mode := range []PermissionMode{PermissionModeNormal, PermissionModeYolo, PermissionModeSysadmin} {
+		svc := NewPermissionService(t.TempDir(), []string{"admin_step"}, nil)
+		svc.SetPermissionMode(mode)
+		svc.AutoApproveSession("owner")
+		ctx, cancel := context.WithCancel(WithHookApproval(t.Context(), "call"))
+		requests := svc.Subscribe(ctx)
+		done := make(chan error, 1)
+		go func() {
+			_, err := svc.Request(ctx, CreatePermissionRequest{SessionID: "owner", ToolCallID: "call", ToolName: "admin_step", Action: "admin", Path: t.TempDir()})
+			done <- err
+		}()
+		var req PermissionRequest
+		select {
+		case event := <-requests:
+			req = event.Payload
+		case <-done:
+			t.Fatal("Admin bypassed fresh approval")
+		case <-time.After(time.Second):
+			t.Fatal("Admin approval was not published")
+		}
+		claim := req
+		claim.Description = "private-claim"
+		require.True(t, svc.GrantPersistent(claim))
+		cancel()
+		require.ErrorIs(t, <-done, context.Canceled)
+		require.True(t, svc.Grant(claim))
+		require.False(t, svc.Grant(claim))
+		require.False(t, svc.GrantPersistent(claim))
+	}
+}
+
+func TestAdminClaimsAcrossScopes(t *testing.T) {
+	svc := NewPermissionService(t.TempDir(), nil, nil)
+	svc.SetSessionScope(func(_ context.Context, id string) string { return id })
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	requests := svc.Subscribe(ctx)
+	notifications := svc.SubscribeNotifications(ctx)
+	done := make(chan bool, 2)
+	for _, id := range []string{"first", "second"} {
+		go func() {
+			granted, err := svc.Request(ctx, CreatePermissionRequest{SessionID: id, ToolCallID: id, ToolName: "admin_step", Action: "admin", Path: "/tmp"})
+			done <- granted && err == nil
+		}()
+	}
+	for range 2 {
+		var req PermissionRequest
+		select {
+		case event := <-requests:
+			req = event.Payload
+		case <-time.After(time.Second):
+			t.Fatal("Missing scoped approval")
+		}
+		claim := req
+		claim.Description = "claim-" + req.SessionID
+		require.True(t, svc.GrantPersistent(claim))
+		other := claim
+		other.Description = "other-terminal"
+		require.False(t, svc.Grant(other))
+		require.False(t, svc.GrantPersistent(other))
+		require.True(t, svc.Grant(claim))
+	}
+	for range 2 {
+		select {
+		case granted := <-done:
+			require.True(t, granted)
+		case <-time.After(time.Second):
+			t.Fatal("Missing admin completion")
+		}
+	}
+	for range 6 {
+		select {
+		case event := <-notifications:
+			require.Contains(t, []string{"first", "second"}, event.Payload.SessionID)
+		case <-time.After(time.Second):
+			t.Fatal("Missing session-scoped notification")
+		}
+	}
+}
