+// handleVisual interprets a key against the VISUAL-mode keymap.
+// Motions extend the selection; the operators consume it and leave.
+// An operator that finds nothing to act on leaves the mode alone —
+// reporting NORMAL for an edit that never happened is a lie the host
+// would render. Unrecognised keys are swallowed, as in NORMAL.
+func (v *Modal) handleVisual(msg tea.KeyPressMsg) (forward []tea.KeyPressMsg, nextMode Mode) {
+	r, printable := printableRune(msg)
+	if !printable {
+		if msg.Key().Code == tea.KeyEscape {
+			v.clearVisual()
+			return nil, Normal
+		}
+		return nil, Visual
+	}
+
+	switch r {
+	case 'v':
+		if v.linewise {
+			// Narrow from whole rows to a charwise selection
+			// starting where the cursor sits, like vim.
+			v.linewise = false
+			v.beginSelection()
+			return nil, Visual
+		}
+		// Toggling VISUAL off drops the selection, like vim.
+		v.clearVisual()
+		return nil, Normal
+	case 'V':
+		v.selectLine()
+		return nil, Visual
+	case 'd', 'x':
+		if !v.deleteSelection() {
+			return nil, Visual
+		}
+		return nil, Normal
+	case 'y':
+		if !v.yank() {
+			return nil, Visual
+		}
+		return nil, Normal
+	case 'c':
+		if !v.deleteSelection() {
+			return nil, Visual
+		}
+		return nil, Insert
+	case 'i', 'a', 'I', 'A', 'o', 'O', 'p', 'r', '~':
+		// Operators VISUAL doesn't implement. Swallow rather than
+		// let NORMAL's meaning leak in mid-selection.
+		return nil, Visual
+	}
+
+	if v.motion(r) {
+		v.updateSelection()
+	}
+	return nil, Visual
+}
+
+// beginSelection anchors a selection at the cursor without moving it.
+func (v *Modal) beginSelection() {
+	t := v.composer
+	v.anchor = textarea.Position{Row: t.Line(), Col: t.Column()}
+	v.head = v.anchor
+	v.updateSelection()
+}
+
+// extendSelection stretches the in-progress selection to wherever the
+// cursor now sits.
+func (v *Modal) extendSelection() {
+	t := v.composer
+	x, y := selectionPoint(t, textarea.Position{Row: t.Line(), Col: t.Column()})
+	t.ExtendSelection(x, y)
+}
+
+// selectLine implements `V`: linewise VISUAL anchored on the row under
+// the cursor. Linewise is a mode rather than a one-off selection —
+// the anchor row outlives each motion, and the cursor stays on its own
+// line so `k` and `j` grow the selection by rows instead of walking
+// back over a displaced head.
+func (v *Modal) selectLine() {
+	v.linewise = true
+	v.anchorRow = v.composer.Line()
+	v.selectRows(v.anchorRow, v.anchorRow)
+}
+
+// updateSelection re-derives the selection after a motion: whole rows
+// between the anchor row and the cursor's row when linewise, the
+// charwise stretch to the cursor otherwise.
+func (v *Modal) updateSelection() {
+	if !v.linewise {
+		t := v.composer
+		v.head = textarea.Position{Row: t.Line(), Col: t.Column()}
+		start, end := v.anchor, v.head
+		if before(end, start) {
+			start, end = end, start
+		}
+		end.Col = clusterEnd(lineRunes(t, end.Row), end.Col)
+		x, y := selectionPoint(t, start)
+		t.BeginSelection(x, y)
+		x, y = selectionPoint(t, end)
+		t.ExtendSelection(x, y)
+		setPosition(t, v.head.Row, v.head.Col)
+		return
+	}
+	row := v.composer.Line()
+	v.selectRows(min(v.anchorRow, row), max(v.anchorRow, row))
+}
+
+// selectRows covers rows [top, bot] whole, taking the newline that
+// ends bot so `d` removes the rows instead of emptying them. The last
+// row of the buffer has no trailing newline, so there the selection
+// reaches back over the one before top and the rows still vanish; a
+// one-row buffer has no newline either way and empties.
+//
+// The cursor goes back where it was afterwards: BeginSelection and
+// ExtendSelection move it as a side effect, and in linewise VISUAL the
+// user's cursor belongs on its own line, not on the selection head.
+func (v *Modal) selectRows(top, bot int) {
+	t := v.composer
+	row, col := t.Line(), t.Column()
+	anchorRow, anchorCol := top, 0
+	headRow, headCol := bot, len(lineRunes(t, bot))
+	switch {
+	case bot+1 < t.LineCount():
+		headRow, headCol = bot+1, 0
+	case top > 0:
+		anchorRow, anchorCol = top-1, len(lineRunes(t, top-1))
+	}
+	x, y := selectionPoint(t, textarea.Position{Row: anchorRow, Col: anchorCol})
+	t.BeginSelection(x, y)
+	x, y = selectionPoint(t, textarea.Position{Row: headRow, Col: headCol})
+	t.ExtendSelection(x, y)
+	setPosition(t, row, col)
+}
+
+// clearVisual drops the selection and the linewise flag together, so
+// the next `v` or `V` starts clean.
+func (v *Modal) clearVisual() {
+	v.linewise = false
+	v.composer.ClearSelection()
+}
+
+// ensureSelection covers bare `v` followed straight by an operator:
+// with anchor and head equal there is nothing to act on, so stretch
+// the selection over the character under the cursor the way vim's
+// inclusive VISUAL does. Reaching right is the usual case; at the end
+// of a line SetCursorColumn clamps and nothing grows, so reach left
+// instead and take the last rune, which is where vim would have kept
+// the cursor anyway. Reports whether there is now something to
+// operate on — an empty line yields nothing either way.
+func (v *Modal) ensureSelection() bool {
+	t := v.composer
+	if t.HasSelection() {
+		return true
+	}
+	col := t.Column()
+	t.SetCursorColumn(clusterEnd(lineRunes(t, t.Line()), col))
+	v.extendSelection()
+	if t.HasSelection() {
+		return true
+	}
+	t.SetCursorColumn(clusterPrev(lineRunes(t, t.Line()), col))
+	v.extendSelection()
+	return t.HasSelection()
+}
+
+// deleteSelection removes the selection and remembers it, so a
+// following `p` pastes what was cut. Backs `d`, `x` and `c`. Reports
+// false when there was nothing to delete.
+func (v *Modal) deleteSelection() bool {
+	if !v.ensureSelection() {
+		return false
+	}
+	v.register = v.composer.SelectedText()
+	if v.linewise {
+		v.register = strings.Join(bufferLines(v.composer)[min(v.anchorRow, v.composer.Line()):max(v.anchorRow, v.composer.Line())+1], "\n")
+	}
+	v.registerLine = v.linewise
+	v.composer.DeleteSelection()
+	v.linewise = false
+	return true
+}
+
+// yank copies the selection into the register and leaves the buffer
+// alone. Reports false when there was nothing to yank.
+func (v *Modal) yank() bool {
+	if !v.ensureSelection() {
+		return false
+	}
+	start, _, _ := v.composer.Selection()
+	v.register = v.composer.SelectedText()
+	if v.linewise {
+		v.register = strings.Join(bufferLines(v.composer)[min(v.anchorRow, v.composer.Line()):max(v.anchorRow, v.composer.Line())+1], "\n")
+	}
+	v.registerLine = v.linewise
+	v.clearVisual()
+	setPosition(v.composer, start.Row, start.Col)
+	return true
+}
+
+// paste implements NORMAL-mode `p`: drop the register in after the
+// cursor. Charwise only — a linewise register pastes as text, not as
+// a new line above/below.
+func (v *Modal) paste() {
+	if v.register == "" && !v.registerLine {
+		return
+	}
+	t := v.composer
+	// One past the cursor, except at the end of the line where
+	// SetCursorColumn clamps back to the line length — which is
+	// exactly where an append should land.
+	if v.registerLine {
+		t.CursorEnd()
+		t.InsertString("\n" + v.register)
+		return
+	}
+	t.SetCursorColumn(clusterEnd(lineRunes(t, t.Line()), t.Column()))
+	t.InsertString(v.register)
+	t.SetCursorColumn(clusterPrev(lineRunes(t, t.Line()), t.Column()))
+}
+
+// farColumn is wider than any cell a textarea will render, so
+// PositionAt resolves it to the end of whatever row it lands on.
+const farColumn = 1 << 20
+
+// selectionPoint inverts textarea.PositionAt: it returns the
+// textarea-relative cell (x, y) that maps to pos.
+//
+// BeginSelection and ExtendSelection take *rendered* coordinates —
+// screen cells measured from the textarea's top-left, gutter
+// included, y counting soft-wrapped display rows from the top of the
+// viewport — not buffer coordinates. Everything that maps between
+// the two (gutter width, the wrap, the scroll offset) is unexported,
+// so the only public way back is to search PositionAt itself. The
+// mapping is monotone in y and then in x, which makes both axes a
+// binary search.
+func selectionPoint(t *textarea.Model, pos textarea.Position) (x, y int) {
+	// PositionAt adds the scroll offset to y, so the topmost
+	// reachable row is -ScrollYOffset.
+	top := -t.ScrollYOffset()
+	rows := t.ScrollYOffset() + displayRowBound(t)
+	y = top + sort.Search(rows, func(i int) bool {
+		return !before(t.PositionAt(farColumn, top+i), pos)
+	})
+	x = sort.Search(farColumn, func(i int) bool {
+		return !before(t.PositionAt(i, y), pos)
+	})
+	return x, y
+}
+
+// before reports whether p sorts before q in the buffer.
+func before(p, q textarea.Position) bool {
+	if p.Row != q.Row {
+		return p.Row < q.Row
+	}
+	return p.Col < q.Col
+}
+
+// displayRowBound returns an upper bound on the number of rendered
+// rows the buffer occupies: every wrapped row holds at least one
+// rune, and every logical line occupies at least one row even when
+// empty.
+func displayRowBound(t *textarea.Model) int {
+	n := t.LineCount() + 1
+	for _, line := range bufferLines(t) {
+		n += len([]rune(line))
+	}
+	return n
+}
