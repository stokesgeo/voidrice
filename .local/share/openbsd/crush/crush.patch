+package chat
+
+import (
+	"testing"
+
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/charmbracelet/crush/internal/ui/styles"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/stretchr/testify/require"
+)
+
+func TestToolItemsStartFoldedAndExpand(t *testing.T) {
+	t.Parallel()
+
+	sty := styles.CharmtonePantera()
+	tc := message.ToolCall{
+		ID:       "bash-fold",
+		Name:     "bash",
+		Input:    `{"command":"printf hello"}`,
+		Finished: true,
+	}
+	item := NewToolMessageItem(&sty, "msg", tc, &message.ToolResult{
+		ToolCallID: "bash-fold",
+		Content:    "SECRETOUTPUT",
+	}, false, "")
+
+	FoldToolItems([]MessageItem{item}, true)
+	folded := ansi.Strip(item.Render(100))
+	require.NotContains(t, folded, "SECRETOUTPUT", "tool output must be folded by default")
+
+	expandable, ok := item.(Expandable)
+	require.True(t, ok)
+	require.True(t, expandable.ToggleExpanded())
+	expanded := ansi.Strip(item.Render(100))
+	require.Contains(t, expanded, "SECRETOUTPUT", "expanding must show the tool body")
+
+	require.False(t, expandable.ToggleExpanded())
+	collapsed := ansi.Strip(item.Render(100))
+	require.NotContains(t, collapsed, "SECRETOUTPUT", "collapsing must return to the folded header")
+	FoldToolItems([]MessageItem{item}, false)
+	require.Contains(t, ansi.Strip(item.Render(100)), "SECRETOUTPUT")
+}
