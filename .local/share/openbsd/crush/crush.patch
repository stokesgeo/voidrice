@@ -0,0 +1,69 @@
+package agent
+
+import (
+	"context"
+	"testing"
+
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/stretchr/testify/require"
+)
+
+type canceledResultTool struct {
+	fakeTool
+	cancel func()
+}
+
+func (t *canceledResultTool) Run(ctx context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {
+	t.cancel()
+	return t.fakeTool.Run(ctx, call)
+}
+
+type canceledResultModel struct {
+	finishStreamModel
+	toolName string
+	calls    int
+}
+
+func (m *canceledResultModel) Stream(context.Context, fantasy.Call) (fantasy.StreamResponse, error) {
+	m.calls++
+	return func(yield func(fantasy.StreamPart) bool) {
+		if yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeToolCall, ID: "canceled-tool", ToolCallName: m.toolName, ToolCallInput: "{}"}) {
+			yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeFinish, FinishReason: fantasy.FinishReasonToolCalls})
+		}
+	}, nil
+}
+
+func TestRunCanceledToolResultPreservesAdminOutcome(t *testing.T) {
+	for _, name := range []string{"admin_step", "other_tool"} {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			env := testEnv(t)
+			model := &canceledResultModel{toolName: name}
+			response := fantasy.NewTextErrorResponse("Admin outcome is unknown; inspect actual state before retrying")
+			response.StopTurn = true
+			tool := &canceledResultTool{fakeTool: fakeTool{name: name, resp: response}}
+			sa := testSessionAgent(env, model, &finishStreamModel{text: "title"}, "test", tool)
+			sess, err := env.sessions.Create(t.Context(), "canceled tool result")
+			require.NoError(t, err)
+			tool.cancel = func() { sa.Cancel(sess.ID) }
+			_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "do work"})
+			require.ErrorIs(t, err, context.Canceled)
+			require.True(t, tool.called)
+			require.Equal(t, 1, model.calls)
+			msgs, err := env.messages.List(t.Context(), sess.ID)
+			require.NoError(t, err)
+			var results []message.ToolResult
+			for _, msg := range msgs {
+				results = append(results, msg.ToolResults()...)
+			}
+			require.Len(t, results, 1)
+			require.True(t, results[0].IsError)
+			if name == "admin_step" {
+				require.Equal(t, response.Content, results[0].Content)
+			} else {
+				require.Equal(t, interruptedToolCallResult, results[0].Content)
+			}
+		})
+	}
+}
