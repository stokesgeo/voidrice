new file mode 100644
--- /dev/null
+++ b/internal/ui/model/vi.go
@@ -0,0 +1,153 @@
+package model
+
+import (
+	"strings"
+
+	"charm.land/bubbles/v2/key"
+	tea "charm.land/bubbletea/v2"
+	vim "github.com/guygrigsby/vimbubble/v2"
+)
+
+func (m *UI) prepareVi(msg tea.Msg) {
+	if m.com == nil || m.com.Workspace == nil {
+		return
+	}
+	cfg := m.com.Config()
+	enabled := cfg != nil && cfg.Options != nil && cfg.Options.TUI != nil && cfg.Options.TUI.Vi
+	if !enabled {
+		if m.vi != nil {
+			m.vi.SetEnabled(false)
+			m.vi = nil
+		}
+		return
+	}
+	if m.vi == nil {
+		m.vi = vim.New(&m.textarea)
+		m.vi.SetMode(vim.Insert)
+	}
+	id := ""
+	if m.session != nil {
+		id = m.session.ID
+	}
+	if id != m.viSession {
+		m.vi.ClearHistory()
+		m.viSession = id
+	}
+	switch msg.(type) {
+	case tea.MouseClickMsg:
+		m.vi.Reset()
+	case tea.PasteMsg, openEditorMsg:
+		m.vi.EndEdit()
+		m.vi.BeginEdit()
+	}
+}
+func (m *UI) finishVi(msg tea.Msg, wasBang bool) {
+	if m.vi == nil {
+		return
+	}
+	if wasBang != m.bangMode {
+		m.vi.ClearHistory()
+	}
+	switch msg.(type) {
+	case tea.PasteMsg, openEditorMsg:
+		m.vi.EndEdit()
+		m.vi.Reset()
+	}
+	id := ""
+	if m.session != nil {
+		id = m.session.ID
+	}
+	if id != m.viSession {
+		m.vi.ClearHistory()
+		m.viSession = id
+	}
+	if m.focus != uiFocusEditor || m.dialog.HasDialogs() || m.activeInline != nil {
+		m.vi.Reset()
+	}
+	if _, ok := msg.(tea.BlurMsg); ok {
+		m.vi.Reset()
+	}
+}
+func (m *UI) handleViKey(msg tea.KeyPressMsg) bool {
+	if m.vi == nil || m.focus != uiFocusEditor || m.activeInline != nil {
+		return false
+	}
+	name := msg.String()
+	oldValue := m.textarea.Value()
+	defer func() {
+		if oldValue == m.textarea.Value() {
+			return
+		}
+		if m.bangMode {
+			m.bangWasEmpty = m.textarea.Value() == ""
+		}
+		m.updateHistoryDraft(oldValue)
+		if m.completionsOpen {
+			word := m.textareaWord()
+			if !strings.HasPrefix(word, "@") {
+				m.closeCompletions()
+			} else {
+				m.completionsQuery = word[1:]
+				m.completions.Filter(m.completionsQuery)
+			}
+		}
+	}()
+	if name == "alt+esc" || name == "alt+enter" {
+		return false
+	}
+	if name == "esc" {
+		if m.completionsOpen {
+			m.closeCompletions()
+		}
+		m.vi.Update(msg)
+		return true
+	}
+	if name == "enter" && m.completionsOpen && m.vi.Mode() == vim.Insert {
+		return false
+	}
+	if name == "enter" {
+		m.vi.EndEdit()
+		return false
+	}
+	if key.Matches(msg, m.keyMap.Editor.Newline) {
+		if m.vi.Mode() == vim.Insert {
+			m.vi.BeginEdit()
+			m.updateTextarea(tea.KeyPressMsg{Code: tea.KeyEnter})
+		}
+		return true
+	}
+	if key.Matches(msg, m.keyMap.Editor.OpenEditor) {
+		m.vi.EndEdit()
+		m.vi.Reset()
+		return false
+	}
+	if m.completionsOpen && m.vi.Mode() == vim.Insert && (name == "tab" || name == "up" || name == "down") {
+		return false
+	}
+	if name == "tab" || name == "shift+tab" {
+		m.vi.Reset()
+		return false
+	}
+	if m.vi.Mode() == vim.Insert {
+		if key.Matches(msg, m.keyMap.Editor.HistoryPrev, m.keyMap.Editor.HistoryNext) {
+			m.vi.EndEdit()
+			m.vi.BeginEdit()
+			return false
+		}
+		before := m.textarea.Height()
+		consumed, _ := m.vi.Update(msg)
+		if consumed {
+			m.handleTextareaHeightChange(before)
+		}
+		return consumed
+	}
+	if msg.Mod != 0 && name != "ctrl+r" && msg.Text == "" {
+		m.vi.Reset()
+		m.vi.BeginEdit()
+		return false
+	}
+	before := m.textarea.Height()
+	m.vi.Update(msg)
+	m.handleTextareaHeightChange(before)
+	return true
+}
