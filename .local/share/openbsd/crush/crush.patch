+		for _, agentCfg := range []config.Agent{cfg.Agents[config.AgentTask], writeAgentConfig(cfg)} {
+			names := c.effectiveToolNames(agentCfg, true)
+			require.Contains(t, names, "bash")
+			require.Contains(t, names, "view")
+			for _, name := range []string{"job_output", "job_kill", "agent", "agent_dispatch", "agent_send", "agent_status", "agent_stop", "question", "admin_step"} {
+				require.NotContains(t, names, name)
+			}
+		}
+		names := c.effectiveToolNames(cfg.Agents[config.AgentCoder], false)
