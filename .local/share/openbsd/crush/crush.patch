+package vimbubble
+
+import (
+	"strings"
+	"unicode"
+
+	"charm.land/bubbles/v2/textarea"
+)
+
+// setPosition walks the textarea's public cursor API to (row, col).
+// CursorUp and CursorDown step one *display* row, so a soft-wrapped
+// logical line takes several steps to cross; the loop gives up when a
+// step doesn't move the cursor, which is what happens at the top and
+// bottom of the buffer.
+func setPosition(t *textarea.Model, row, col int) {
+	row = clamp(row, 0, t.LineCount()-1)
+	for t.Line() != row {
+		wasRow, wasCol := t.Line(), t.Column()
+		if t.Line() > row {
+			t.CursorUp()
+		} else {
+			t.CursorDown()
+		}
+		if t.Line() == wasRow && t.Column() == wasCol {
+			break
+		}
+	}
+	t.SetCursorColumn(clusterStart(lineRunes(t, t.Line()), col))
+}
+
+func clamp(v, low, high int) int {
+	if v < low {
+		return low
+	}
+	if v > high {
+		return high
+	}
+	return v
+}
+
+// bufferLines splits the buffer the way the textarea stores it.
+func bufferLines(t *textarea.Model) []string {
+	return strings.Split(t.Value(), "\n")
+}
+
+// lineRunes returns row's content, or nil when row is out of range.
+func lineRunes(t *textarea.Model, row int) []rune {
+	ls := bufferLines(t)
+	if row < 0 || row >= len(ls) {
+		return nil
+	}
+	return []rune(ls[row])
+}
+
+// replaceRow swaps row's content for runes and re-pins the cursor at
+// col. Every buffer-level verb funnels through here so the
+// Value/SetValue/reposition dance exists once.
+func replaceRow(t *textarea.Model, row int, runes []rune, col int) {
+	ls := bufferLines(t)
+	if row < 0 || row >= len(ls) {
+		return
+	}
+	ls[row] = string(runes)
+	t.SetValue(strings.Join(ls, "\n"))
+	setPosition(t, row, col)
+}
+
+// charUnderCursor returns the cursor's row and column along with the
+// row's runes, or ok=false when the cursor sits past the end of its
+// line and there is no character to act on.
+func charUnderCursor(t *textarea.Model) (row, col int, runes []rune, ok bool) {
+	row, col = t.Line(), t.Column()
+	runes = lineRunes(t, row)
+	if col < 0 || col >= len(runes) {
+		return row, col, runes, false
+	}
+	return row, col, runes, true
+}
+
+// replaceCharAtCursor edits the buffer so the character at the cursor
+// becomes r, leaving the cursor where it was. Reports false when the
+// cursor sits past the end of its line (nothing to replace).
+func replaceCharAtCursor(t *textarea.Model, replacement rune) bool {
+	row, col, runes, ok := charUnderCursor(t)
+	if !ok {
+		return false
+	}
+	col = clusterStart(runes, col)
+	end := clusterEnd(runes, col)
+	runes = append(append(append([]rune(nil), runes[:col]...), replacement), runes[end:]...)
+	replaceRow(t, row, runes, col)
+	return true
+}
+
+// toggleCaseAtCursor implements vim's `~`: flips the case of the
+// character at the cursor and advances one cell. No-op when the
+// cursor is past the end of its line.
+func toggleCaseAtCursor(t *textarea.Model) {
+	row, col, runes, ok := charUnderCursor(t)
+	if !ok {
+		return
+	}
+	switch r := runes[col]; {
+	case unicode.IsLower(r):
+		runes[col] = unicode.ToUpper(r)
+	case unicode.IsUpper(r):
+		runes[col] = unicode.ToLower(r)
+	}
+	end := clusterEnd(runes, col)
+	if end >= len(runes) && row+1 < t.LineCount() {
+		replaceRow(t, row, runes, col)
+		setPosition(t, row+1, 0)
+		return
+	}
+	replaceRow(t, row, runes, end)
+}
+
+// charKind classifies a rune for vim's word-motion semantics.
+type charKind int
+
+const (
+	classSpace charKind = iota
+	classWord
+	classPunct
+)
+
+func charClass(r rune) charKind {
+	switch {
+	case r == ' ' || r == '\t':
+		return classSpace
+	case unicode.IsLetter(r) || unicode.IsDigit(r) || r == '_':
+		return classWord
+	default:
+		return classPunct
+	}
+}
+
+// findWordEnd returns the column AFTER the current word starting at
+// `col` on `line`. Mirrors vim's `w` motion: word characters are
+// alnum + _; a run of punctuation also counts as a word boundary;
+// one trailing space gets swallowed so `cw foo` reaches `bar` cleanly
+// (vim's quirk).
+func findWordEnd(line []rune, col int) int {
+	if col >= len(line) {
+		return col
+	}
+	i := clusterStart(line, col)
+	startKind := charClass(line[i])
+	for i < len(line) && charClass(line[i]) == startKind && startKind != classSpace {
+		i = clusterEnd(line, i)
+	}
+	for i < len(line) && charClass(line[i]) == classSpace {
+		i = clusterEnd(line, i)
+	}
+	return i
+}
+
+// findWordStart returns the column at the start of the word before
+// `col`, mirroring vim's `b`: step back over whitespace, then back
+// over the run of same-class runes.
+func findWordStart(line []rune, col int) int {
+	i := clusterPrev(line, min(col, len(line)))
+	for i >= 0 && charClass(line[i]) == classSpace {
+		if i == 0 {
+			return 0
+		}
+		i = clusterPrev(line, i)
+	}
+	if i < 0 {
+		return 0
+	}
+	kind := charClass(line[i])
+	for i > 0 && charClass(line[clusterPrev(line, i)]) == kind {
+		if i == 0 {
+			return 0
+		}
+		i = clusterPrev(line, i)
+	}
+	return i
+}
+
+// deleteRangeOnRow removes runes [startCol, endCol) on `row` and
+// leaves the cursor at startCol. No-op when the range is empty or
+// outside the line.
+func deleteRangeOnRow(t *textarea.Model, row, startCol, endCol int) {
+	if endCol <= startCol {
+		return
+	}
+	runes := lineRunes(t, row)
+	startCol = clusterStart(runes, max(startCol, 0))
+	endCol = min(endCol, len(runes))
+	if clusterStart(runes, endCol) != endCol {
+		endCol = clusterEnd(runes, endCol)
+	}
+	if startCol >= len(runes) {
+		return
+	}
+	kept := make([]rune, 0, len(runes)-(endCol-startCol))
+	kept = append(kept, runes[:startCol]...)
+	kept = append(kept, runes[endCol:]...)
+	replaceRow(t, row, kept, startCol)
+}
+
+// clearRow empties the content of `row` without removing the row
+// itself. Used by `cc` (change line) where vim leaves the user on a
+// blank line in INSERT mode.
+func clearRow(t *textarea.Model, row int) {
+	replaceRow(t, row, nil, 0)
+}
+
+// deleteWord deletes from the cursor through the end of the current
+// word on the current line. Shared by `dw` and `cw` — same range,
+// different mode-end behaviour (dw stays Normal, cw enters Insert).
+func (v *Modal) deleteWord() {
+	v.rangeOnRow(func(line []rune, col int) (int, int) {
+		return col, findWordEnd(line, col)
+	})
+}
+
+// wordBoundsInner returns the [start, end) of vim's "inner word"
+// text object: the contiguous run of same-class characters around
+// `col`. Word class is {alnum, _}; punctuation runs and whitespace
+// runs are also single units, which matches vim's iw on those
+// regions.
+func wordBoundsInner(line []rune, col int) (start, end int) {
+	if col < 0 || col >= len(line) {
+		return col, col
+	}
+	kind := charClass(line[col])
+	start = clusterStart(line, col)
+	for start > 0 && charClass(line[clusterPrev(line, start)]) == kind {
+		start = clusterPrev(line, start)
+	}
+	end = clusterEnd(line, col)
+	for end < len(line) && charClass(line[end]) == kind {
+		end = clusterEnd(line, end)
+	}
+	return start, end
+}
+
+// wordBoundsAround returns the [start, end) of vim's "a word" text
+// object: inner word PLUS the trailing whitespace run, or (if there
+// is no trailing whitespace) the leading whitespace run. Matches
+// the way `daw` eats one of the two surrounding spaces so the user
+// doesn't end up with two adjacent spaces collapsing into one.
+func wordBoundsAround(line []rune, col int) (start, end int) {
+	start, end = wordBoundsInner(line, col)
+	if start == end {
+		return start, end
+	}
+	probe := end
+	for probe < len(line) && (line[probe] == ' ' || line[probe] == '\t') {
+		probe++
+	}
+	if probe > end {
+		return start, probe
+	}
+	probe = start
+	for probe > 0 && (line[probe-1] == ' ' || line[probe-1] == '\t') {
+		probe--
+	}
+	return probe, end
+}
+
+// rangeOnRow looks up the [start, end) range for the current cursor
+// position via `bounds` and deletes it. Shared by dw/cw and
+// ciw/caw/diw/daw — each verb only names its bounds function.
+func (v *Modal) rangeOnRow(bounds func(line []rune, col int) (int, int)) {
+	row, col := v.composer.Line(), v.composer.Column()
+	start, end := bounds(lineRunes(v.composer, row), col)
+	line := lineRunes(v.composer, row)
+	v.register = string(line[start:end])
+	v.registerLine = false
+	deleteRangeOnRow(v.composer, row, start, end)
+}
+
+func (v *Modal) deleteInsideWord() { v.rangeOnRow(wordBoundsInner) }
+func (v *Modal) deleteAroundWord() { v.rangeOnRow(wordBoundsAround) }
