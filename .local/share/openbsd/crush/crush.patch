+}
+
+func TestBuiltBashUsesForegroundWhenJobsUnavailable(t *testing.T) {
+	c := newGateTestCoordinator(t, true)
+	require.NoError(t, c.readyWg.Wait())
+	cases := []struct {
+		name       string
+		subagent   bool
+		disabled   []string
+		foreground bool
+	}{
+		{name: "parent"},
+		{name: "read worker", subagent: true, foreground: true},
+		{name: "write worker", subagent: true, foreground: true},
+		{name: "output disabled", disabled: []string{"job_output"}, foreground: true},
+		{name: "kill disabled", disabled: []string{"job_kill"}, foreground: true},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			c.cfg.Config().Options.DisabledTools = test.disabled
+			c.cfg.SetupAgents()
+			agentCfg := c.cfg.Config().Agents[config.AgentCoder]
+			if test.subagent {
+				agentCfg = c.cfg.Config().Agents[config.AgentTask]
+				if test.name == "write worker" {
+					agentCfg = writeAgentConfig(c.cfg.Config())
+				}
+			}
+			attached, err := c.buildTools(t.Context(), agentCfg, test.subagent, c.mainAgent.Model)
+			require.NoError(t, err)
+			var bash fantasy.AgentTool
+			for _, tool := range attached {
+				if tool.Info().Name == "bash" {
+					bash = tool
+				}
+			}
+			require.NotNil(t, bash)
+			if !test.foreground {
+				require.Contains(t, bash.Info().Description, "automatically move to background")
+				return
+			}
+			require.NotContains(t, bash.Info().Description, "job_output")
+			require.NotContains(t, bash.Info().Description, "job_kill")
+			rejected, err := bash.Run(t.Context(), fantasy.ToolCall{ID: "background", Input: `{"command":"echo rejected","run_in_background":true}`})
+			require.NoError(t, err)
+			require.True(t, rejected.IsError)
+			require.Contains(t, rejected.Content, "foreground-only")
+			ctx := context.WithValue(t.Context(), tools.SessionIDContextKey, t.Name())
+			result, err := bash.Run(ctx, fantasy.ToolCall{ID: "foreground", Input: `{"command":"echo worker-smoke","auto_background_after":-1}`})
+			require.NoError(t, err)
+			require.Contains(t, result.Content, "worker-smoke")
+		})
+	}
+}
