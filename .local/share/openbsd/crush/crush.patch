new file mode 100644
--- /dev/null
+++ b/internal/activity/activity_test.go
@@ -0,0 +1,107 @@
+package activity
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func openTest(t *testing.T) (*Tracker, string) {
+	t.Helper()
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0o700))
+	tracker, err := Open(dir)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, tracker.Close()) })
+	return tracker, dir
+}
+
+func readTest(t *testing.T, dir string) Record {
+	t.Helper()
+	files, err := filepath.Glob(filepath.Join(dir, "*", "*.json"))
+	require.NoError(t, err)
+	require.Len(t, files, 1)
+	info, err := os.Stat(files[0])
+	require.NoError(t, err)
+	require.Equal(t, os.FileMode(0o600), info.Mode().Perm())
+	data, err := os.ReadFile(files[0])
+	require.NoError(t, err)
+	var record Record
+	require.NoError(t, json.Unmarshal(data, &record))
+	return record
+}
+
+func TestLifecycle(t *testing.T) {
+	tracker, dir := openTest(t)
+	tracker.Observe("session")
+	require.Equal(t, "idle", readTest(t, dir).State)
+	run := tracker.Run("session")
+	require.Equal(t, "working", readTest(t, dir).State)
+	wait := tracker.Wait("session")
+	other := tracker.Run("session")
+	require.Equal(t, "waiting_owner", readTest(t, dir).State)
+	wait()
+	wait()
+	require.Equal(t, "working", readTest(t, dir).State)
+	run()
+	require.Equal(t, "working", readTest(t, dir).State)
+	other()
+	record := readTest(t, dir)
+	require.Equal(t, "idle", record.Current(time.Now()))
+	require.Equal(t, "unknown", record.Current(record.ObservedAt.Add(11*time.Second)))
+	require.NoError(t, tracker.Close())
+	require.Equal(t, "unknown", readTest(t, dir).State)
+	tracker.Run("session")()
+	require.Equal(t, "unknown", readTest(t, dir).State)
+}
+
+func TestConcurrentAndHeartbeat(t *testing.T) {
+	tracker, dir := openTest(t)
+	var group sync.WaitGroup
+	for range 20 {
+		group.Go(func() {
+			end := tracker.Run("session")
+			wait := tracker.Wait("session")
+			wait()
+			end()
+		})
+	}
+	group.Wait()
+	first := readTest(t, dir)
+	require.Equal(t, "idle", first.State)
+	require.Eventually(t, func() bool {
+		return readTest(t, dir).Sequence > first.Sequence
+	}, 4*time.Second, 100*time.Millisecond)
+}
+
+func TestDisabledAndPrivateRoot(t *testing.T) {
+	tracker, err := Open("")
+	require.NoError(t, err)
+	require.Nil(t, tracker)
+	tracker.Run("session")()
+	tracker.Wait("session")()
+	require.NoError(t, tracker.Close())
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0o755))
+	_, err = Open(dir)
+	require.Error(t, err)
+}
+
+func TestInstancesAndUnsafeSessionNames(t *testing.T) {
+	tracker, dir := openTest(t)
+	tracker.Run("../../outside")()
+	require.Equal(t, "../../outside", readTest(t, dir).SessionID)
+	other, err := Open(dir)
+	require.NoError(t, err)
+	defer other.Close()
+	other.Run("../../outside")()
+	files, err := filepath.Glob(filepath.Join(dir, "*", "*.json"))
+	require.NoError(t, err)
+	require.Len(t, files, 2)
+	require.NotEqual(t, tracker.instance, other.instance)
+}
diff --git a/internal/activity/owner_unix.go b/internal/activity/owner_unix.go
new file mode 100644
--- /dev/null
+++ b/internal/activity/owner_unix.go
@@ -0,0 +1,25 @@
+//go:build !windows
+
+package activity
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+func checkOwner(root *os.Root) error {
+	file, err := root.Open(".")
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	var stat unix.Stat_t
+	if err := unix.Fstat(int(file.Fd()), &stat); err != nil {
+		return err
+	}
+	if stat.Uid != uint32(os.Geteuid()) {
+		return ownerError()
+	}
+	return nil
+}
