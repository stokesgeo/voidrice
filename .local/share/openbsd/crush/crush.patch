@@ -0,0 +1,189 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/config"
+	"github.com/charmbracelet/crush/internal/shell"
+	"github.com/stretchr/testify/require"
+)
+
+func foregroundBashForTest(t *testing.T) (fantasy.AgentTool, *recordingPermissionService, string) {
+	t.Helper()
+	dir := t.TempDir()
+	perms := &recordingPermissionService{allow: true}
+	tool := NewForegroundBashTool(perms, dir, dir, &config.Attribution{}, "test-model", testMaxJobs, nil, t.Name())
+	return tool, perms, dir
+}
+
+func TestForegroundBashRejectsBackgroundBeforePermissions(t *testing.T) {
+	tool, perms, dir := foregroundBashForTest(t)
+	before := shell.GetBackgroundShellManager().List()
+	for _, ctx := range []context.Context{context.Background(), context.WithValue(t.Context(), SessionIDContextKey, t.Name())} {
+		resp := runBashTool(t, tool, ctx, BashParams{
+			Command: "echo unexpected > started", RunInBackground: true,
+		})
+		require.True(t, resp.IsError)
+		require.Contains(t, resp.Content, "foreground-only")
+	}
+	require.Zero(t, perms.requestCount)
+	require.ElementsMatch(t, before, shell.GetBackgroundShellManager().List())
+	_, err := os.Stat(filepath.Join(dir, "started"))
+	require.ErrorIs(t, err, os.ErrNotExist)
+}
+
+func TestForegroundBashOutputAndExitStatus(t *testing.T) {
+	tool, _, _ := foregroundBashForTest(t)
+	ctx := context.WithValue(t.Context(), SessionIDContextKey, t.Name())
+	before := shell.GetBackgroundShellManager().List()
+	resp := runBashTool(t, tool, ctx, BashParams{Command: "echo stdout; echo stderr >&2; exit 42"})
+	require.False(t, resp.IsError)
+	require.Contains(t, resp.Content, "stdout")
+	require.Contains(t, resp.Content, "stderr")
+	require.Contains(t, resp.Content, "Exit code 42")
+	var meta BashResponseMetadata
+	require.NoError(t, json.Unmarshal([]byte(resp.Metadata), &meta))
+	require.False(t, meta.Background)
+	require.Empty(t, meta.ShellID)
+	require.ElementsMatch(t, before, shell.GetBackgroundShellManager().List())
+}
+
+func TestForegroundBashIgnoresAutoBackground(t *testing.T) {
+	for _, threshold := range []int{-1, 1} {
+		t.Run(time.Duration(threshold).String(), func(t *testing.T) {
+			tool, _, _ := foregroundBashForTest(t)
+			ctx := context.WithValue(t.Context(), SessionIDContextKey, t.Name())
+			before := shell.GetBackgroundShellManager().List()
+			start := time.Now()
+			resp := runBashTool(t, tool, ctx, BashParams{Command: "sleep 1.2; echo completed", AutoBackgroundAfter: threshold})
+			require.GreaterOrEqual(t, time.Since(start), time.Second)
+			require.False(t, resp.IsError)
+			require.Contains(t, resp.Content, "completed")
+			var meta BashResponseMetadata
+			require.NoError(t, json.Unmarshal([]byte(resp.Metadata), &meta))
+			require.False(t, meta.Background)
+			require.Empty(t, meta.ShellID)
+			require.ElementsMatch(t, before, shell.GetBackgroundShellManager().List())
+		})
+	}
+}
+
+func TestForegroundBashCancellationCleansUp(t *testing.T) {
+	tool, _, dir := foregroundBashForTest(t)
+	ctx, cancel := context.WithCancel(context.WithValue(t.Context(), SessionIDContextKey, t.Name()))
+	defer cancel()
+	before := shell.GetBackgroundShellManager().List()
+	done := make(chan error, 1)
+	go func() {
+		_, err := tool.Run(ctx, fantasy.ToolCall{ID: "cancel", Input: `{"command":"echo started > started; sleep 30; echo survived > survived","auto_background_after":-1}`})
+		done <- err
+	}()
+	require.Eventually(t, func() bool {
+		_, err := os.Stat(filepath.Join(dir, "started"))
+		return err == nil
+	}, 5*time.Second, 10*time.Millisecond)
+	manager := shell.GetBackgroundShellManager()
+	var running *shell.BackgroundShell
+	for _, id := range manager.List() {
+		candidate, ok := manager.Get(id)
+		if ok && candidate.WorkingDir == dir {
+			running = candidate
+		}
+	}
+	require.NotNil(t, running)
+	cancel()
+	select {
+	case err := <-done:
+		require.ErrorIs(t, err, context.Canceled)
+	case <-time.After(7 * time.Second):
+		t.Fatal("foreground cancellation did not return")
+	}
+	require.True(t, running.IsDone())
+	require.ElementsMatch(t, before, manager.List())
+	_, err := os.Stat(filepath.Join(dir, "survived"))
+	require.ErrorIs(t, err, os.ErrNotExist)
+}
+
+func TestBashBackgroundPolicyRegression(t *testing.T) {
+	for _, explicit := range []bool{true, false} {
+		name := "automatic"
+		if explicit {
+			name = "explicit"
+		}
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			ctx := context.WithValue(t.Context(), SessionIDContextKey, t.Name())
+			resp := runBashTool(t, newBashToolForTest(dir), ctx, BashParams{
+				Command: "echo retrievable; sleep 30", RunInBackground: explicit, AutoBackgroundAfter: 1,
+			})
+			require.False(t, resp.IsError)
+			var meta BashResponseMetadata
+			require.NoError(t, json.Unmarshal([]byte(resp.Metadata), &meta))
+			require.True(t, meta.Background)
+			require.NotEmpty(t, meta.ShellID)
+			manager := shell.GetBackgroundShellManager()
+			t.Cleanup(func() { manager.Kill(context.Background(), meta.ShellID) })
+			job, ok := manager.Get(meta.ShellID)
+			require.True(t, ok)
+			require.False(t, job.IsDone())
+			input, err := json.Marshal(JobOutputParams{ShellID: meta.ShellID})
+			require.NoError(t, err)
+			output, err := NewJobOutputTool(dir).Run(ctx, fantasy.ToolCall{ID: "output", Input: string(input)})
+			require.NoError(t, err)
+			require.False(t, output.IsError)
+			require.Contains(t, output.Content, "retrievable")
+			input, err = json.Marshal(JobKillParams{ShellID: meta.ShellID})
+			require.NoError(t, err)
+			killed, err := NewJobKillTool().Run(ctx, fantasy.ToolCall{ID: "kill", Input: string(input)})
+			require.NoError(t, err)
+			require.False(t, killed.IsError)
+			require.True(t, job.IsDone())
+			_, ok = manager.Get(meta.ShellID)
+			require.False(t, ok)
+		})
+	}
+}
+
+func TestBashPolicyDescriptions(t *testing.T) {
+	for _, platform := range []string{"openbsd", "linux"} {
+		for _, foreground := range []bool{true, false} {
+			desc := renderBashDescription(&config.Attribution{}, "model", nil, foreground, platform)
+			require.NotContains(t, desc, "Grep/Glob/Agent")
+			if foreground {
+				require.Contains(t, desc, "Foreground Execution")
+				for _, absent := range []string{"job_output", "job_kill", "automatically move", "servers", "Watch/monitoring"} {
+					require.NotContains(t, desc, absent)
+				}
+			} else {
+				require.Contains(t, desc, "automatically move to background")
+				require.Contains(t, desc, "job_output")
+				require.Contains(t, desc, "job_kill")
+				require.Contains(t, desc, "Long-running servers")
+			}
+			if platform == "openbsd" {
+				require.Contains(t, desc, "`admin_step` when available")
+				require.Contains(t, desc, "required owner action to the parent agent or user")
+				require.Contains(t, desc, "Do not fall back to `sudo` or `doas` through bash")
+				require.Contains(t, desc, "do not automatically retry")
+				require.NotContains(t, desc, "Run privileged commands with plain")
+			} else {
+				require.Contains(t, desc, "Run privileged commands with plain `sudo`")
+				require.NotContains(t, desc, "`admin_step`")
+			}
+		}
+	}
+	require.Equal(t, renderBashDescription(&config.Attribution{}, "model", nil, false, runtime.GOOS), bashDescription(&config.Attribution{}, "model", nil))
+	tool, _, _ := foregroundBashForTest(t)
+	info, err := json.Marshal(tool.Info())
+	require.NoError(t, err)
+	require.NotContains(t, string(info), "job_output")
+	require.NotContains(t, string(info), "automatically moving")
+	require.Contains(t, string(info), "foreground-only")
+}
