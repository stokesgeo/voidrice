+package agent
+
+import (
+	"context"
+	"errors"
+	"io"
+	"strconv"
+	"testing"
+	"time"
+
+	"charm.land/catwalk/v3/pkg/catwalk"
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/agent/notify"
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCanContinueStream(t *testing.T) {
+	t.Parallel()
+	for _, test := range []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"truncated", io.ErrUnexpectedEOF, true},
+		{"overload", &fantasy.ProviderError{TransientError: true}, true},
+		{"server", &fantasy.ProviderError{StatusCode: 503}, true},
+		{"rate limit", &fantasy.ProviderError{StatusCode: 429}, true},
+		{"unauthorized", &fantasy.ProviderError{StatusCode: 401, TransientError: true}, false},
+		{"forbidden", &fantasy.ProviderError{StatusCode: 403}, false},
+		{"context", &fantasy.ProviderError{ContextTooLargeErr: true, TransientError: true}, false},
+		{"validation", &fantasy.ProviderError{StatusCode: 400}, false},
+		{"canceled", context.Canceled, false},
+		{"deadline", context.DeadlineExceeded, false},
+		{"storage", errors.New("database unavailable"), false},
+		{"nil", nil, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			require.Equal(t, test.want, canContinueStream(t.Context(), test.err))
+		})
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	require.False(t, canContinueStream(ctx, io.ErrUnexpectedEOF))
+	require.ErrorIs(t, waitStreamContinuation(ctx, time.Hour), context.Canceled)
+}
+
+type recoveryStreamModel struct {
+	finishStreamModel
+	calls    int
+	failures int
+	requests []fantasy.Call
+	withTool bool
+}
+
+func (m *recoveryStreamModel) Stream(ctx context.Context, call fantasy.Call) (fantasy.StreamResponse, error) {
+	m.calls++
+	m.requests = append(m.requests, call)
+	if m.withTool && m.calls == 1 {
+		return func(yield func(fantasy.StreamPart) bool) {
+			if !yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeToolCall, ID: "completed-tool", ToolCallName: "record", ToolCallInput: "{}"}) {
+				return
+			}
+			yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeFinish, FinishReason: fantasy.FinishReasonToolCalls})
+		}, nil
+	}
+	if m.calls <= m.failures {
+		return func(yield func(fantasy.StreamPart) bool) {
+			yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: &fantasy.Error{Title: "stream error", Message: "Our servers are currently overloaded. Please try again later."}})
+		}, nil
+	}
+	return m.finishStreamModel.Stream(ctx, call)
+}
+
+func TestRunStreamContinuation(t *testing.T) {
+	for _, failures := range []int{4, 100} {
+		t.Run(strconv.Itoa(failures), func(t *testing.T) {
+			env := testEnv(t)
+			large := &recoveryStreamModel{finishStreamModel: finishStreamModel{text: "recovered"}, failures: failures}
+			small := &finishStreamModel{text: "title"}
+			var completed []notify.RunComplete
+			sa := NewSessionAgent(SessionAgentOptions{
+				Models:   fixedModels(Model{Model: large, CatwalkCfg: catwalk.Model{ContextWindow: 200000}}, Model{Model: small}),
+				Cfg:      testConfigStore(),
+				Sessions: env.sessions,
+				Messages: env.messages,
+			})
+			sess, err := env.sessions.Create(t.Context(), "recovery")
+			require.NoError(t, err)
+			_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, RunID: "original", Prompt: "do work", OnComplete: func(event notify.RunComplete) { completed = append(completed, event) }})
+			if failures == 4 {
+				require.NoError(t, err)
+				require.Equal(t, 5, large.calls)
+			} else {
+				require.Error(t, err)
+				require.Equal(t, 12, large.calls)
+			}
+			require.Len(t, completed, 1)
+			require.Equal(t, "original", completed[0].RunID)
+			if failures == 4 {
+				require.Empty(t, completed[0].Error)
+				require.Equal(t, "recovered", completed[0].Text)
+			}
+			msgs, err := env.messages.List(t.Context(), sess.ID)
+			require.NoError(t, err)
+			var prompts []string
+			for _, msg := range msgs {
+				if msg.Role == message.User {
+					for _, part := range msg.Parts {
+						if text, ok := part.(message.TextContent); ok {
+							prompts = append(prompts, text.Text)
+						}
+					}
+				}
+			}
+			require.Equal(t, "do work", prompts[0])
+			if failures == 4 {
+				require.Len(t, prompts, 2)
+			} else {
+				require.Len(t, prompts, 3)
+			}
+			require.Contains(t, prompts[1], "Continue the interrupted task")
+			require.False(t, sa.HasPendingWork(sess.ID))
+		})
+	}
+}
+
+func TestStreamContinuationPreservesToolResult(t *testing.T) {
+	env := testEnv(t)
+	large := &recoveryStreamModel{finishStreamModel: finishStreamModel{text: "recovered"}, failures: 5, withTool: true}
+	tool := &fakeTool{name: "record", resp: fantasy.NewTextResponse("unique completed result")}
+	sa := testSessionAgent(env, large, &finishStreamModel{text: "title"}, "test", tool)
+	sess, err := env.sessions.Create(t.Context(), "tool recovery")
+	require.NoError(t, err)
+	_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "do work"})
+	require.NoError(t, err)
+	require.True(t, tool.called)
+	require.Equal(t, 6, large.calls)
+	requireToolCallAdjacency(t, large.requests[5].Prompt)
+	var results int
+	for _, msg := range large.requests[5].Prompt {
+		for _, part := range msg.Content {
+			if result, ok := part.(fantasy.ToolResultPart); ok && result.ToolCallID == "completed-tool" {
+				results++
+			}
+		}
+	}
+	require.Equal(t, 1, results)
+}
+
+func TestStreamContinuationCancellation(t *testing.T) {
+	env := testEnv(t)
+	large := &recoveryStreamModel{finishStreamModel: finishStreamModel{text: "unexpected"}, failures: 100}
+	sa := testSessionAgent(env, large, &finishStreamModel{text: "title"}, "test")
+	sess, err := env.sessions.Create(t.Context(), "cancel recovery")
+	require.NoError(t, err)
+	done := make(chan error, 1)
+	go func() {
+		_, runErr := sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "do work"})
+		done <- runErr
+	}()
+	require.Eventually(t, func() bool {
+		msgs, listErr := env.messages.List(t.Context(), sess.ID)
+		if listErr != nil {
+			return false
+		}
+		for _, msg := range msgs {
+			if finish := msg.FinishPart(); finish != nil && finish.Reason == message.FinishReasonError {
+				return true
+			}
+		}
+		return false
+	}, time.Minute, 20*time.Millisecond)
+	sa.Cancel(sess.ID)
+	select {
+	case runErr := <-done:
+		require.ErrorIs(t, runErr, context.Canceled)
+	case <-time.After(5 * time.Second):
+		t.Fatal("recovery did not stop on cancellation")
+	}
+	require.Equal(t, 4, large.calls)
+	require.False(t, sa.HasPendingWork(sess.ID))
+	msgs, err := env.messages.List(t.Context(), sess.ID)
+	require.NoError(t, err)
+	for _, msg := range msgs {
+		if msg.Role == message.Assistant {
+			require.Equal(t, message.FinishReasonCanceled, msg.FinishPart().Reason)
+		}
+	}
+}
