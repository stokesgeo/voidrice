diff --git a/third_party/vimbubble/grapheme.go b/third_party/vimbubble/grapheme.go
new file mode 100644
--- /dev/null
+++ b/third_party/vimbubble/grapheme.go
@@ -0,0 +1,81 @@
+package vimbubble
+
+import (
+	"github.com/rivo/uniseg"
+	"strings"
+)
+
+func boundaries(line []rune) []int {
+	result := []int{0}
+	count := 0
+	iter := uniseg.NewGraphemes(string(line))
+	for iter.Next() {
+		count += len([]rune(iter.Str()))
+		result = append(result, count)
+	}
+	return result
+}
+func clusterStart(line []rune, col int) int {
+	last := 0
+	for _, end := range boundaries(line) {
+		if end > col {
+			break
+		}
+		last = end
+	}
+	return last
+}
+func clusterEnd(line []rune, col int) int {
+	for _, end := range boundaries(line) {
+		if end > col {
+			return end
+		}
+	}
+	return len(line)
+}
+func clusterPrev(line []rune, col int) int {
+	last := 0
+	for _, end := range boundaries(line) {
+		if end >= col {
+			break
+		}
+		last = end
+	}
+	return last
+}
+func (v *Modal) deleteChar() {
+	t := v.composer
+	row, col := t.Line(), t.Column()
+	line := lineRunes(t, row)
+	col = clusterStart(line, col)
+	end := clusterEnd(line, col)
+	v.register = string(line[col:end])
+	v.registerLine = false
+	deleteRangeOnRow(t, row, col, end)
+}
+func (v *Modal) deleteLine() {
+	t := v.composer
+	lines := bufferLines(t)
+	row := t.Line()
+	v.register = lines[row]
+	v.registerLine = true
+	lines = append(lines[:row], lines[row+1:]...)
+	if len(lines) == 0 {
+		lines = []string{""}
+	}
+	t.SetValue(strings.Join(lines, "\n"))
+	setPosition(t, min(row, len(lines)-1), 0)
+}
+func (v *Modal) changeWord() {
+	v.rangeOnRow(func(line []rune, col int) (int, int) {
+		if col >= len(line) {
+			return col, col
+		}
+		kind := charClass(line[col])
+		end := clusterEnd(line, col)
+		for end < len(line) && charClass(line[end]) == kind {
+			end = clusterEnd(line, end)
+		}
+		return col, end
+	})
+}
diff --git a/third_party/vimbubble/history.go b/third_party/vimbubble/history.go
new file mode 100644
--- /dev/null
+++ b/third_party/vimbubble/history.go
@@ -0,0 +1,92 @@
+package vimbubble
+
+type snapshot struct {
+	text     string
+	row, col int
+}
+
+func (v *Modal) state() snapshot {
+	return snapshot{v.composer.Value(), v.composer.Line(), v.composer.Column()}
+}
+func (v *Modal) restore(s snapshot) {
+	v.composer.SetValue(s.text)
+	setPosition(v.composer, s.row, s.col)
+	v.composer.ClearSelection()
+}
+func push(stack []snapshot, s snapshot) []snapshot {
+	if len(s.text) > 1<<20 {
+		return nil
+	}
+	stack = append(stack, s)
+	size := 0
+	for i := len(stack) - 1; i >= 0; i-- {
+		size += len(stack[i].text)
+		if len(stack)-i > 100 || size > 4<<20 {
+			return append([]snapshot(nil), stack[i+1:]...)
+		}
+	}
+	return stack
+}
+func (v *Modal) BeginEdit() {
+	if !v.editing {
+		v.base = v.state()
+		v.editing = true
+	}
+}
+func (v *Modal) EndEdit() {
+	if !v.editing {
+		return
+	}
+	if v.base.text != v.composer.Value() {
+		v.undo = push(v.undo, v.base)
+		v.redo = nil
+	}
+	v.editing = false
+	v.base = snapshot{}
+}
+func (v *Modal) Reset() {
+	v.EndEdit()
+	v.chord.reset()
+	v.operatorPending = 0
+	v.clearVisual()
+	if v.mode != Disabled {
+		v.mode = Insert
+	}
+}
+func (v *Modal) ClearHistory() {
+	v.editing = false
+	v.base = snapshot{}
+	v.undo = nil
+	v.redo = nil
+	v.register = ""
+	v.registerLine = false
+	v.Reset()
+}
+func (v *Modal) Undo() {
+	v.EndEdit()
+	if len(v.undo) == 0 {
+		return
+	}
+	s := v.undo[len(v.undo)-1]
+	v.undo[len(v.undo)-1] = snapshot{}
+	v.undo = v.undo[:len(v.undo)-1]
+	v.redo = push(v.redo, v.state())
+	v.restore(s)
+	v.chord.reset()
+	v.operatorPending = 0
+	v.mode = Normal
+}
+func (v *Modal) Redo() {
+	v.EndEdit()
+	if len(v.redo) == 0 {
+		return
+	}
+	s := v.redo[len(v.redo)-1]
+	v.redo[len(v.redo)-1] = snapshot{}
+	v.redo = v.redo[:len(v.redo)-1]
+	v.undo = push(v.undo, v.state())
+	v.restore(s)
+	v.chord.reset()
+	v.operatorPending = 0
+	v.mode = Normal
+}
diff --git a/third_party/vimbubble/normal.go b/third_party/vimbubble/normal.go
new file mode 100644
--- /dev/null
+++ b/third_party/vimbubble/normal.go
@@ -0,0 +1,239 @@
+package vimbubble
+
+import (
+	tea "charm.land/bubbletea/v2"
+)
+
+// motion applies a single-key vim motion to the textarea cursor and
+// reports whether r was one. Every move goes through the public
+// cursor API, so NORMAL and VISUAL share the same implementation:
+// VISUAL just extends the selection afterwards.
+func (v *Modal) motion(r rune) bool {
+	t := v.composer
+	switch r {
+	case 'h':
+		t.SetCursorColumn(clusterPrev(lineRunes(t, t.Line()), t.Column()))
+	case 'l':
+		t.SetCursorColumn(clusterEnd(lineRunes(t, t.Line()), t.Column()))
+	case 'j':
+		t.CursorDown()
+	case 'k':
+		t.CursorUp()
+	case '0':
+		t.CursorStart()
+	case '$':
+		t.CursorEnd()
+	case 'w':
+		t.SetCursorColumn(findWordEnd(lineRunes(t, t.Line()), t.Column()))
+	case 'b':
+		t.SetCursorColumn(findWordStart(lineRunes(t, t.Line()), t.Column()))
+	case 'G':
+		t.MoveToEnd()
+	default:
+		return false
+	}
+	t.SetCursorColumn(clusterStart(lineRunes(t, t.Line()), t.Column()))
+	return true
+}
+
+// handleNormal interprets a key against the NORMAL-mode keymap.
+// Returns:
+//   - forward: synthesised key presses the textarea should process.
+//     Only the verbs the textarea already implements (delete, kill to
+//     end of line, newline) go this route; motions move the cursor
+//     directly through the public API.
+//   - nextMode: the mode the composer should be in after this key.
+//
+// There is no "handled" result: NORMAL swallows unrecognised keys
+// rather than letting them insert into the buffer, so every key that
+// reaches here is consumed.
+func (v *Modal) handleNormal(msg tea.KeyPressMsg) (forward []tea.KeyPressMsg, nextMode Mode) {
+	r, printable := printableRune(msg)
+
+	// Pending state takes priority: when `r` is waiting for its arg
+	// the next rune MUST replace the char under the cursor regardless
+	// of what it would otherwise mean. Same for an in-progress chord:
+	// the next rune completes it, not gets re-routed through motion
+	// dispatch (`w` after `c` is "change word", not "move forward").
+	if v.operatorPending == 'r' {
+		v.operatorPending = 0
+		if !printable {
+			return nil, Normal
+		}
+		replaceCharAtCursor(v.composer, r)
+		return nil, Normal
+	}
+	if v.chord.pending != 0 {
+		switch {
+		case v.chord.stale():
+			v.chord.reset()
+			// Fall through — the user's current key starts fresh.
+		case !printable:
+			// Non-printable cancels the chord (Esc, arrows, etc).
+			v.chord.reset()
+			return nil, Normal
+		default:
+			// Operator + specifier path (3-key sequences): when the
+			// pending operator is c/d AND we haven't yet collected a
+			// specifier, treat i/a as the inner/around specifier
+			// rather than as their normal "INSERT" / "append" mode
+			// switches. This is what makes `ciw` parse correctly: the
+			// `i` after `c` belongs to the chord, not to mode-switch
+			// dispatch below.
+			if v.chord.specifier == 0 && (v.chord.pending == 'c' || v.chord.pending == 'd') && (r == 'i' || r == 'a') {
+				v.chord.setSpecifier(r)
+				return nil, Normal
+			}
+			if v.chord.specifier != 0 {
+				op, spec := v.chord.pending, v.chord.specifier
+				v.chord.reset()
+				return v.dispatchTextObject(op, spec, r)
+			}
+			// Plain 2-key combo (no specifier).
+			op := v.chord.pending
+			v.chord.reset()
+			return v.dispatch2Key(string(op) + string(r))
+		}
+	}
+
+	if !printable {
+		return nil, Normal
+	}
+
+	// Mode switches. `a`, `I` and `A` place the cursor first; `o` and
+	// `O` need the textarea's own newline handling, so they go out as
+	// key presses.
+	switch r {
+	case 'i':
+		return nil, Insert
+	case 'a':
+		v.composer.SetCursorColumn(clusterEnd(lineRunes(v.composer, v.composer.Line()), v.composer.Column()))
+		return nil, Insert
+	case 'I':
+		v.composer.CursorStart()
+		return nil, Insert
+	case 'A':
+		v.composer.CursorEnd()
+		return nil, Insert
+	case 'o':
+		v.composer.CursorEnd()
+		return []tea.KeyPressMsg{{Code: tea.KeyEnter}}, Insert
+	case 'O':
+		v.composer.CursorStart()
+		return []tea.KeyPressMsg{
+			{Code: tea.KeyEnter},
+			{Code: tea.KeyUp},
+		}, Insert
+	case 'v':
+		v.linewise = false
+		v.beginSelection()
+		return nil, Visual
+	case 'V':
+		v.selectLine()
+		return nil, Visual
+	}
+
+	if v.motion(r) {
+		return nil, Normal
+	}
+
+	// Edits that don't need an argument.
+	switch r {
+	case 'x':
+		v.deleteChar()
+		return nil, Normal
+	case 'D':
+		return []tea.KeyPressMsg{killToEndOfLine}, Normal
+	case '~':
+		toggleCaseAtCursor(v.composer)
+		return nil, Normal
+	case 'p':
+		v.paste()
+		return nil, Normal
+	case 'r':
+		// Wait for the next keystroke; that key replaces the char at
+		// the cursor without advancing. operatorPending is checked at
+		// the top of this function on the next call.
+		v.operatorPending = 'r'
+		return nil, Normal
+	}
+
+	// `/` and `:` are vim's command-mode triggers. Host apps that
+	// implement a slash-command palette want NORMAL-mode `/` to
+	// drop into INSERT and pass the character through, so users don't
+	// have to first press `i` to reach their commands.
+	if r == '/' || r == ':' {
+		return []tea.KeyPressMsg{{Code: r, Text: string(r)}}, Insert
+	}
+
+	// Start a chord on the operator keys. Completion is handled at
+	// the top of this function.
+	if r == 'g' || r == 'd' || r == 'c' {
+		v.chord.start(r)
+		return nil, Normal
+	}
+
+	// Unrecognised key — swallow rather than insert.
+	return nil, Normal
+}
+
+// The two textarea bindings the vim verbs lean on. ctrl+k kills to the
+// end of the line (D, d$, c$); ctrl+u kills back to its start (d0, c0).
+var (
+	killToEndOfLine   = tea.KeyPressMsg{Code: 'k', Mod: tea.ModCtrl}
+	killToStartOfLine = tea.KeyPressMsg{Code: 'u', Mod: tea.ModCtrl}
+)
+
+// dispatch2Key runs a finished operator+motion combo (no specifier).
+func (v *Modal) dispatch2Key(combo string) (forward []tea.KeyPressMsg, nextMode Mode) {
+	switch combo {
+	case "gg":
+		v.composer.MoveToBegin()
+		return nil, Normal
+	case "dd":
+		v.deleteLine()
+		return nil, Normal
+	case "dw":
+		v.deleteWord()
+		return nil, Normal
+	case "d$":
+		return []tea.KeyPressMsg{killToEndOfLine}, Normal
+	case "d0":
+		return []tea.KeyPressMsg{killToStartOfLine}, Normal
+	case "cw":
+		v.changeWord()
+		return nil, Insert
+	case "c$":
+		return []tea.KeyPressMsg{killToEndOfLine}, Insert
+	case "c0":
+		return []tea.KeyPressMsg{killToStartOfLine}, Insert
+	case "cc":
+		clearRow(v.composer, v.composer.Line())
+		return nil, Insert
+	}
+	// Unknown combo: swallow silently (matches vim — beeping every
+	// typo would be brutal).
+	return nil, Normal
+}
+
+// dispatchTextObject runs a finished operator+specifier+object
+// sequence. Today: word objects only (iw, aw). Adding inner-sentence
+// / inner-paragraph / quoted-string text objects would slot in here
+// with sibling bounds functions in cursor.go.
+func (v *Modal) dispatchTextObject(operator, specifier, object rune) (forward []tea.KeyPressMsg, nextMode Mode) {
+	switch string(operator) + string(specifier) + string(object) {
+	case "ciw":
+		v.deleteInsideWord()
+		return nil, Insert
+	case "caw":
+		v.deleteAroundWord()
+		return nil, Insert
+	case "diw":
+		v.deleteInsideWord()
+		return nil, Normal
+	case "daw":
+		v.deleteAroundWord()
+		return nil, Normal
+	}
+	return nil, Normal
+}
diff --git a/third_party/vimbubble/repair_test.go b/third_party/vimbubble/repair_test.go
new file mode 100644
--- /dev/null
+++ b/third_party/vimbubble/repair_test.go
@@ -0,0 +1,81 @@
+package vimbubble
+
+import (
+	tea "charm.land/bubbletea/v2"
+	"testing"
+)
+
+func TestRepairedEditing(t *testing.T) {
+	for _, tc := range []struct{ text, keys, want string }{
+		{"one two", "cwX", "X two"}, {"one two", "lciwX", "X two"}, {"abc", "vlyp", "aabbc"},
+		{"e\u0301x next", "dw", "next"}, {"e\u0301x", "rA", "Ax"}, {"one\ntwo", "Gdd", "one"},
+		{"👨‍👩‍👧‍👦x", "x", "x"}, {"🇺🇸x", "rA", "Ax"}, {"a👨‍👩‍👧‍👦b", "lvld", "a"},
+	} {
+		t.Run(tc.keys+tc.text, func(t *testing.T) {
+			v, ta := newTestModal(t)
+			ta.SetValue(tc.text)
+			ta.MoveToBegin()
+			v.SetEnabled(true)
+			pressAll(t, v, ta, tc.keys)
+			if ta.Value() != tc.want {
+				t.Fatalf("got %q want %q", ta.Value(), tc.want)
+			}
+		})
+	}
+}
+func TestLinewiseBlankRows(t *testing.T) {
+	for _, tc := range []struct{ text, keys, want string }{{"\na\nb", "Vjyp", "\n\na\na\nb"}, {"a\n\nb", "Vjyp", "a\na\n\n\nb"}, {"a\nb", "jddp", "a\nb"}, {"a\n\nb", "jddp", "a\nb\n"}} {
+		v, ta := newTestModal(t)
+		ta.SetValue(tc.text)
+		ta.MoveToBegin()
+		v.SetEnabled(true)
+		pressAll(t, v, ta, tc.keys)
+		if ta.Value() != tc.want {
+			t.Errorf("%q %s: %q want %q", tc.text, tc.keys, ta.Value(), tc.want)
+		}
+	}
+}
+func TestHistoryBoundAndBranch(t *testing.T) {
+	v, ta := newTestModal(t)
+	v.SetEnabled(true)
+	for i := 0; i < 120; i++ {
+		v.BeginEdit()
+		ta.InsertString("x")
+		v.EndEdit()
+	}
+	if len(v.undo) != 100 {
+		t.Fatal(len(v.undo))
+	}
+	v.Undo()
+	v.BeginEdit()
+	ta.InsertString("y")
+	v.EndEdit()
+	before := ta.Value()
+	v.Redo()
+	if ta.Value() != before {
+		t.Fatal("redo branch survived")
+	}
+}
+func TestRepairHistory(t *testing.T) {
+	v, ta := newTestModal(t)
+	ta.SetValue("one two")
+	ta.MoveToBegin()
+	v.SetEnabled(true)
+	pressAll(t, v, ta, "cwXYZ")
+	press(t, v, ta, "escape")
+	press(t, v, ta, "u")
+	if ta.Value() != "one two" || ta.Column() != 0 {
+		t.Fatal(ta.Value(), ta.Column())
+	}
+	v.Update(tea.KeyPressMsg{Code: 'r', Mod: tea.ModCtrl})
+	if ta.Value() != "XYZ two" {
+		t.Fatal(ta.Value())
+	}
+	press(t, v, ta, "d")
+	v.Reset()
+	press(t, v, ta, "escape")
+	press(t, v, ta, "d")
+	if ta.Value() != "XYZ two" {
+		t.Fatal("stale operator")
+	}
+}
diff --git a/third_party/vimbubble/vim.go b/third_party/vimbubble/vim.go
new file mode 100644
--- /dev/null
+++ b/third_party/vimbubble/vim.go
@@ -0,0 +1,319 @@
+package vimbubble
+
+import (
+	"time"
+
+	"charm.land/bubbles/v2/textarea"
+	tea "charm.land/bubbletea/v2"
+)
+
+// Mode is the current vim mode. The zero value is Disabled, meaning
+// vimbubble passes every key through untouched.
+type Mode uint8
+
+const (
+	// Disabled is the off-switch: vimbubble.Update never consumes a
+	// key, so the host textarea behaves like a plain text input.
+	Disabled Mode = iota
+	// Normal is vim's command mode: cursor motion + the vim verbs
+	// (x, dw, cw, ~, r, …). Letter keys are swallowed rather than
+	// inserted so a stray "x" doesn't paste an x into the buffer.
+	Normal
+	// Insert is plain typing: every key passes through to the
+	// textarea except Esc, which returns the user to Normal.
+	Insert
+	// Visual anchors a selection at the cursor and extends it with
+	// the motion keys. d/x delete it, y yanks it into the register,
+	// c deletes it and drops into Insert, Esc clears it.
+	Visual
+)
+
+// String returns a short human-readable label ("disabled", "normal",
+// "insert", "visual"). For a styled footer label, see
+// (*Modal).ModeLabel.
+func (m Mode) String() string {
+	switch m {
+	case Normal:
+		return "normal"
+	case Insert:
+		return "insert"
+	case Visual:
+		return "visual"
+	}
+	return "disabled"
+}
+
+// Modal wraps a textarea.Model with modal editing. Caller owns the
+// textarea — Modal doesn't allocate it and never replaces it. Modal only
+// reads + mutates the textarea's value, cursor and selection.
+type Modal struct {
+	composer *textarea.Model
+	mode     Mode
+
+	// chord tracks the first key of a two-key sequence (gg, dd, cw,
+	// d$, …) with a short timeout so a stray "g" doesn't permanently
+	// trap the composer in a half-chord state.
+	chord chord
+
+	// operatorPending captures an operator that needs an argument
+	// (today: `r` waiting for the replacement char). Reset on the
+	// next keystroke regardless of validity so we never get stuck.
+	operatorPending rune
+
+	// register holds the last yank or Visual-mode delete. `p` pastes
+	// it. One unnamed register; "a and friends aren't implemented.
+	register string
+
+	// linewise is set by `V`: the selection covers whole rows between
+	// anchorRow and the cursor's row, recomputed after every motion,
+	// rather than running from a fixed character anchor.
+	linewise     bool
+	anchorRow    int
+	anchor       textarea.Position
+	head         textarea.Position
+	registerLine bool
+	undo, redo   []snapshot
+	base         snapshot
+	editing      bool
+}
+
+// New returns a Modal attached to ta. Starts disabled.
+//
+// The cursor is read and written through bubbles v2's public API
+// (Line, Column, SetCursorColumn, CursorUp/CursorDown), so unlike v1
+// there is no reflect/unsafe read of the textarea's internals.
+func New(ta *textarea.Model) *Modal {
+	return &Modal{composer: ta}
+}
+
+// Mode returns the current mode.
+func (v *Modal) Mode() Mode { return v.mode }
+
+// SetMode forces the mode. Useful when a host app needs to bring the
+// composer into Insert after running a command (e.g. dropping into
+// edit-mode) or wants to drop back to Normal after a slash-command
+// finishes. Entering Visual anchors a selection at the cursor;
+// leaving it clears the selection. SetMode(Disabled) clears pending
+// state the same way SetEnabled(false) does.
+func (v *Modal) SetMode(m Mode) {
+	v.EndEdit()
+	v.chord.reset()
+	v.operatorPending = 0
+	switch {
+	case m == Visual && v.mode != Visual:
+		v.linewise = false
+		v.beginSelection()
+	case m != Visual && v.mode == Visual:
+		v.clearVisual()
+	}
+	v.mode = m
+	if m == Disabled {
+		v.chord.reset()
+		v.operatorPending = 0
+	}
+}
+
+// IsEnabled reports whether vim is active. Equivalent to
+// v.Mode() != Disabled. Provided as a convenience for callers that
+// want to gate behaviour without typing the comparison.
+func (v *Modal) IsEnabled() bool { return v.mode != Disabled }
+
+// SetEnabled flips vim mode on/off. Enabling lands the composer in
+// Normal (matches the way vim itself opens). Disabling clears any
+// pending chord/operator state.
+func (v *Modal) SetEnabled(on bool) {
+	if on {
+		v.SetMode(Normal)
+		return
+	}
+	v.SetMode(Disabled)
+}
+
+// ModeLabel returns a styled label like "-- NORMAL --" suitable for
+// rendering near the composer. Empty when disabled — callers can
+// switch on the empty string to decide whether to render anything.
+func (v *Modal) ModeLabel() string {
+	switch v.mode {
+	case Normal:
+		return "-- NORMAL --"
+	case Insert:
+		return "-- INSERT --"
+	case Visual:
+		return "-- VISUAL --"
+	}
+	return ""
+}
+
+// Position returns the textarea's logical cursor as (row, col): row
+// indexes a logical line, col a rune within it.
+func (v *Modal) Position() (row, col int) {
+	return v.composer.Line(), v.composer.Column()
+}
+
+// SetPosition moves the textarea cursor to (row, col), clamped to the
+// buffer. Both are logical buffer coordinates, not screen cells.
+func (v *Modal) SetPosition(row, col int) {
+	setPosition(v.composer, row, col)
+}
+
+// Update routes a key press through vim. Returns (consumed, cmd):
+//   - consumed=true → vim handled this key. The caller should NOT
+//     forward msg to the textarea. cmd is whatever the Bubble Tea
+//     runtime needs to run afterwards (today: usually nil).
+//   - consumed=false → vim isn't interested in this key. The caller
+//     handles it as it would have without vim (e.g. textarea.Update).
+//
+// Disabled mode never consumes — Modal is invisible until enabled.
+func (v *Modal) Update(msg tea.KeyPressMsg) (consumed bool, cmd tea.Cmd) {
+	switch v.mode {
+	case Disabled:
+		return false, nil
+
+	case Insert:
+		if msg.Key().Code == tea.KeyEscape {
+			v.SetMode(Normal)
+			return true, nil
+		}
+		// Pass everything else through. We don't synthesise it; the
+		// caller's textarea.Update will see the same key.
+		if (msg.Code == tea.KeyLeft || msg.Code == tea.KeyRight) && msg.Mod == 0 && !v.composer.HasSelection() {
+			v.EndEdit()
+			line := lineRunes(v.composer, v.composer.Line())
+			col := v.composer.Column()
+			if (msg.Code==tea.KeyLeft && col==0) || (msg.Code==tea.KeyRight && col==len(line)) { return false,nil }
+			if msg.Code == tea.KeyLeft {
+				col = clusterPrev(line, col)
+			} else {
+				col = clusterEnd(line, col)
+			}
+			v.composer.SetCursorColumn(col)
+			return true, nil
+		}
+		if msg.Code == tea.KeyLeft || msg.Code == tea.KeyRight || msg.Code == tea.KeyUp || msg.Code == tea.KeyDown || msg.Code == tea.KeyHome || msg.Code == tea.KeyEnd {
+			v.EndEdit()
+			return false, nil
+		}
+		v.BeginEdit()
+		if v.composer.HasSelection() {
+			return false, nil
+		}
+		if msg.Code == tea.KeyBackspace || msg.Code == tea.KeyDelete {
+			row, col := v.Position()
+			line := lineRunes(v.composer, row)
+			if msg.Code == tea.KeyBackspace && col > 0 {
+				deleteRangeOnRow(v.composer, row, clusterPrev(line, col), col)
+				return true, nil
+			}
+			if msg.Code == tea.KeyDelete && col < len(line) {
+				deleteRangeOnRow(v.composer, row, col, clusterEnd(line, col))
+				return true, nil
+			}
+		}
+		return false, nil
+
+	case Normal:
+		if msg.String() == "u" {
+			v.Undo()
+			return true, nil
+		}
+		if msg.String() == "ctrl+r" {
+			v.Redo()
+			return true, nil
+		}
+		v.BeginEdit()
+		forward, next := v.handleNormal(msg)
+		v.mode = next
+		cmd := v.forward(forward)
+		if next != Insert {
+			v.EndEdit()
+		}
+		return true, cmd
+
+	case Visual:
+		v.BeginEdit()
+		forward, next := v.handleVisual(msg)
+		v.mode = next
+		cmd := v.forward(forward)
+		if next != Insert {
+			v.EndEdit()
+		}
+		return true, cmd
+	}
+	return false, nil
+}
+
+// forward hands synthesised key presses to the textarea so its own
+// editing logic runs, and folds whatever commands it returns into
+// one.
+func (v *Modal) forward(keys []tea.KeyPressMsg) tea.Cmd {
+	var cmds []tea.Cmd
+	for _, k := range keys {
+		var c tea.Cmd
+		*v.composer, c = v.composer.Update(k)
+		if c != nil {
+			cmds = append(cmds, c)
+		}
+	}
+	if len(cmds) == 0 {
+		return nil
+	}
+	return tea.Batch(cmds...)
+}
+
+// printableRune reports the single character a key press carries.
+// Dispatch reads Key.Text rather than Key.Code so shifted keys ("I",
+// "A", "$", "~") arrive as themselves, while ctrl/alt combinations
+// and named keys (Esc, arrows) are never mistaken for a vim verb.
+func printableRune(msg tea.KeyPressMsg) (rune, bool) {
+	k := msg.Key()
+	if k.Mod&^tea.ModShift != 0 {
+		return 0, false
+	}
+	r := []rune(k.Text)
+	if len(r) != 1 {
+		return 0, false
+	}
+	return r[0], true
+}
+
+// chord tracks the partial state of a multi-key vim sequence:
+//   - 2-key:  operator + motion       — cw, dd, gg, d$, …
+//   - 3-key:  operator + specifier + object — ciw, caw, diw, daw
+//
+// The specifier (`i` for "inner", `a` for "around") bridges operator
+// and text-object keys. Bare `i` / `a` are mode switches in vim's
+// grammar; we only read them as specifiers when an operator is
+// already pending. Cleared after chordTimeout so the user isn't
+// trapped after pressing a chord starter and walking off.
+type chord struct {
+	pending   rune // the operator: 'c', 'd', 'g'
+	specifier rune // 'i' or 'a', set only mid-sequence
+	startedAt time.Time
+}
+
+const chordTimeout = 800 * time.Millisecond
+
+func (c *chord) reset() {
+	c.pending = 0
+	c.specifier = 0
+	c.startedAt = time.Time{}
+}
+
+func (c *chord) start(r rune) {
+	c.reset()
+	c.pending = r
+	c.startedAt = time.Now()
+}
+
+// setSpecifier advances a pending operator into a 3-key sequence by
+// stamping the inner/around specifier. Refreshes the timeout so the
+// user gets another chordTimeout window to land the object key.
+func (c *chord) setSpecifier(r rune) {
+	c.specifier = r
+	c.startedAt = time.Now()
+}
+
+// stale reports whether the pending sequence has aged out.
+func (c *chord) stale() bool {
+	return c.pending != 0 && time.Since(c.startedAt) > chordTimeout
+}
diff --git a/third_party/vimbubble/vim_test.go b/third_party/vimbubble/vim_test.go
new file mode 100644
--- /dev/null
+++ b/third_party/vimbubble/vim_test.go
@@ -0,0 +1,724 @@
+package vimbubble
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"charm.land/bubbles/v2/textarea"
+	tea "charm.land/bubbletea/v2"
+)
+
+// keyPress builds the key event a v2 terminal would deliver for a key
+// name: a printable key carries its Text, a named key carries only a
+// Code.
+func keyPress(name string) tea.KeyPressMsg {
+	switch name {
+	case "escape":
+		return tea.KeyPressMsg{Code: tea.KeyEscape}
+	case "enter", "\n":
+		return tea.KeyPressMsg{Code: tea.KeyEnter}
+	}
+	r := []rune(name)
+	if len(r) != 1 {
+		panic("keyPress: not a single key: " + name)
+	}
+	return tea.KeyPressMsg{Code: r[0], Text: name}
+}
+
+// press routes one key through the Modal and forwards it to the
+// textarea when the Modal didn't consume it — exactly what a host
+// app's Update does.
+func press(t *testing.T, v *Modal, ta *textarea.Model, key string) {
+	t.Helper()
+	msg := keyPress(key)
+	if consumed, _ := v.Update(msg); !consumed {
+		*ta, _ = ta.Update(msg)
+	}
+}
+
+// pressAll sends each rune of keys in turn.
+func pressAll(t *testing.T, v *Modal, ta *textarea.Model, keys string) {
+	t.Helper()
+	for _, r := range keys {
+		press(t, v, ta, string(r))
+	}
+}
+
+// newTestModal builds a Modal attached to a wide-enough textarea for the
+// keymap tests to run without their cursor falling off the right
+// edge. Mode is Disabled at the start; tests enable explicitly.
+func newTestModal(t *testing.T) (*Modal, *textarea.Model) {
+	t.Helper()
+	ta := textarea.New()
+	ta.SetWidth(80)
+	ta.SetHeight(5)
+	ta.Focus()
+	return New(&ta), &ta
+}
+
+func seedNormal(t *testing.T, v *Modal, ta *textarea.Model, text string) {
+	t.Helper()
+	v.SetEnabled(true)
+	press(t, v, ta, "i")
+	pressAll(t, v, ta, text)
+	press(t, v, ta, "escape")
+	v.SetPosition(0, 0)
+}
+
+func TestModeString(t *testing.T) {
+	cases := []struct {
+		m    Mode
+		want string
+	}{
+		{Disabled, "disabled"},
+		{Normal, "normal"},
+		{Insert, "insert"},
+		{Visual, "visual"},
+	}
+	for _, c := range cases {
+		if got := c.m.String(); got != c.want {
+			t.Errorf("Mode(%d).String(): got %q, want %q", c.m, got, c.want)
+		}
+	}
+}
+
+func TestModeLabel(t *testing.T) {
+	v, _ := newTestModal(t)
+	cases := []struct {
+		m    Mode
+		want string
+	}{
+		{Disabled, ""},
+		{Normal, "-- NORMAL --"},
+		{Insert, "-- INSERT --"},
+		{Visual, "-- VISUAL --"},
+	}
+	for _, c := range cases {
+		v.SetMode(c.m)
+		if got := v.ModeLabel(); got != c.want {
+			t.Errorf("ModeLabel(%s): got %q, want %q", c.m, got, c.want)
+		}
+	}
+}
+
+func TestDisabledNeverConsumes(t *testing.T) {
+	v, _ := newTestModal(t)
+	// Default mode is Disabled.
+	consumed, _ := v.Update(keyPress("h"))
+	if consumed {
+		t.Errorf("Disabled mode consumed a key — host textarea should handle everything")
+	}
+	if label := v.ModeLabel(); label != "" {
+		t.Errorf("ModeLabel when disabled: got %q, want \"\"", label)
+	}
+}
+
+func TestSetEnabledLandsInNormal(t *testing.T) {
+	v, _ := newTestModal(t)
+	v.SetEnabled(true)
+	if v.Mode() != Normal {
+		t.Errorf("after Enable: mode=%v, want Normal", v.Mode())
+	}
+	if !v.IsEnabled() {
+		t.Error("IsEnabled false after SetEnabled(true)")
+	}
+	if label := v.ModeLabel(); label != "-- NORMAL --" {
+		t.Errorf("ModeLabel: got %q, want %q", label, "-- NORMAL --")
+	}
+	v.SetEnabled(false)
+	if v.IsEnabled() {
+		t.Error("IsEnabled true after SetEnabled(false)")
+	}
+}
+
+func TestInsertEscReturnsToNormal(t *testing.T) {
+	v, ta := newTestModal(t)
+	v.SetEnabled(true)
+	press(t, v, ta, "i")
+	if v.Mode() != Insert {
+		t.Fatalf("i should enter Insert, got %v", v.Mode())
+	}
+	press(t, v, ta, "escape")
+	if v.Mode() != Normal {
+		t.Errorf("Esc from Insert: mode=%v, want Normal", v.Mode())
+	}
+}
+
+func TestInsertPassesKeysThrough(t *testing.T) {
+	v, ta := newTestModal(t)
+	v.SetEnabled(true)
+	press(t, v, ta, "i")
+	// Plain letters in Insert: vim doesn't consume; host typing flows
+	// to the textarea unchanged.
+	for _, r := range "hi" {
+		consumed, _ := v.Update(keyPress(string(r)))
+		if consumed {
+			t.Errorf("Insert mode consumed %q — should pass through", r)
+		}
+		*ta, _ = ta.Update(keyPress(string(r)))
+	}
+	if got := ta.Value(); got != "hi" {
+		t.Errorf("textarea after typing: got %q, want hi", got)
+	}
