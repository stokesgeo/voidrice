new file mode 100644
--- /dev/null
+++ b/internal/agent/stream_recovery.go
@@ -0,0 +1,43 @@
+package agent
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"time"
+
+	"charm.land/fantasy"
+)
+
+func canContinueStream(ctx context.Context, err error) bool {
+	if err == nil || ctx.Err() != nil || errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	var providerErr *fantasy.ProviderError
+	if errors.As(err, &providerErr) {
+		if providerErr.AuthError || providerErr.IsContextTooLarge() || providerErr.StatusCode == 401 || providerErr.StatusCode == 403 {
+			return false
+		}
+		return providerErr.IsRetryable()
+	}
+	var streamErr *fantasy.Error
+	if errors.As(err, &streamErr) && streamErr.Title == "stream error" {
+		text := strings.ToLower(streamErr.Message)
+		return strings.Contains(text, "overloaded") || strings.Contains(text, "temporarily unavailable") || strings.Contains(text, "connection")
+	}
+	var networkErr net.Error
+	return errors.Is(err, io.ErrUnexpectedEOF) || errors.As(err, &networkErr) || fantasy.IsTransportError(err)
+}
+
+func waitStreamContinuation(ctx context.Context, delay time.Duration) error {
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return ctx.Err()
+	}
+}
