+package model
+
+import (
+	"image/color"
+	"testing"
+
+	"github.com/charmbracelet/crush/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFollowsTerminal(t *testing.T) {
+	for _, name := range []string{"", "terminal", "vertrice-day", "vertrice-night"} {
+		model := newTestUIWithConfig(t, &config.Config{Options: &config.Options{TUI: &config.TUIOptions{ActiveTheme: name}}})
+		require.Equal(t, name == "terminal", model.followsTerminal())
+		model.userThemeSelected = true
+		require.False(t, model.followsTerminal())
+	}
+}
+
+func TestTerminalThemeRestoredAfterHostClear(t *testing.T) {
+	model := newHostThemeTestUI(t, &config.Config{Options: &config.Options{TUI: &config.TUIOptions{ActiveTheme: "terminal"}}})
+	model.terminalThemeHash = [32]byte{1}
+	model.hostTheme.active = true
+	require.False(t, model.followsTerminal())
+	model.handleHostThemeStyles(hostThemeStylesMsg{seq: model.hostTheme.seq, styles: *model.com.Styles})
+	require.True(t, model.followsTerminal())
+	require.Equal(t, [32]byte{}, model.terminalThemeHash)
+}
+
+func TestSameTerminalColor(t *testing.T) {
+	require.True(t, sameTerminalColor(nil, nil))
