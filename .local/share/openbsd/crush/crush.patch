+)
+
+type settlementFailureModel struct {
+	finishStreamModel
+	calls    int
+	requests []fantasy.Call
+}
+
+func (m *settlementFailureModel) Stream(ctx context.Context, call fantasy.Call) (fantasy.StreamResponse, error) {
+	m.calls++
+	m.requests = append(m.requests, call)
+	if m.calls == 1 {
+		return func(yield func(fantasy.StreamPart) bool) {
+			if yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeToolCall, ID: "completed-tool", ToolCallName: "record", ToolCallInput: "{}"}) {
+				yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeFinish, FinishReason: fantasy.FinishReasonToolCalls})
+			}
+		}, nil
+	}
+	if m.calls == 2 {
+		return func(yield func(fantasy.StreamPart) bool) {
+			for _, id := range []string{"pending-first", "pending-second"} {
+				if !yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeToolInputStart, ID: id, ToolCallName: "record"}) {
+					return
+				}
+			}
+			yield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: io.ErrUnexpectedEOF})
+		}, nil
+	}
+	return m.finishStreamModel.Stream(ctx, call)
+}
+
+type settlementFailureMessages struct {
+	message.Service
+	failUpdate        bool
+	err               error
+	failures          int
+	settlementCreates int
+}
+
+func (s *settlementFailureMessages) Update(ctx context.Context, msg message.Message) error {
+	calls := msg.ToolCalls()
+	if s.failUpdate && s.failures == 0 && len(calls) == 2 && calls[0].Finished && calls[1].Finished {
+		s.failures++
+		return s.err
+	}
+	return s.Service.Update(ctx, msg)
+}
+
+func (s *settlementFailureMessages) Create(ctx context.Context, sessionID string, params message.CreateMessageParams) (message.Message, error) {
+	for _, part := range params.Parts {
+		if result, ok := part.(message.ToolResult); ok && strings.HasPrefix(result.ToolCallID, "pending-") {
+			s.settlementCreates++
+			if !s.failUpdate && s.failures == 0 && s.settlementCreates == 2 {
+				s.failures++
+				return message.Message{}, s.err
+			}
+		}
+	}
+	return s.Service.Create(ctx, sessionID, params)
+}
+
+func TestSettlementFailureNextTurnPreservesOutcomes(t *testing.T) {
+	for _, failUpdate := range []bool{true, false} {
+		name := "partial tool result create"
+		if failUpdate {
+			name = "assistant update"
+		}
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			env := testEnv(t)
+			persistenceErr := errors.New("injected settlement persistence failure")
+			messages := &settlementFailureMessages{Service: env.messages, failUpdate: failUpdate, err: persistenceErr}
+			env.messages = messages
+			model := &settlementFailureModel{finishStreamModel: finishStreamModel{text: "state inspected"}}
+			tool := &fakeTool{name: "record", resp: fantasy.NewTextResponse("earlier successful result")}
+			sa := testSessionAgent(env, model, &finishStreamModel{text: "title"}, "test", tool)
+			sess, err := env.sessions.Create(t.Context(), "next turn after settlement failure")
+			require.NoError(t, err)
+			_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "do work"})
+			require.ErrorIs(t, err, persistenceErr)
+			require.Equal(t, 2, model.calls)
+			require.True(t, tool.called)
+			tool.called = false
+			_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "inspect state before repeating any action"})
+			require.NoError(t, err)
+			require.Equal(t, 3, model.calls)
+			require.Equal(t, 1, messages.failures)
+			require.False(t, tool.called)
+			requireToolCallAdjacency(t, model.requests[2].Prompt)
+			results := make(map[string]fantasy.ToolResultPart)
+			for _, msg := range model.requests[2].Prompt {
+				for _, part := range msg.Content {
+					if result, ok := part.(fantasy.ToolResultPart); ok {
+						_, duplicate := results[result.ToolCallID]
+						require.False(t, duplicate, result.ToolCallID)
+						results[result.ToolCallID] = result
+					}
+				}
+			}
+			require.Len(t, results, 3)
+			require.Equal(t, fantasy.ToolResultOutputContentText{Text: "earlier successful result"}, results["completed-tool"].Output)
+			for _, id := range []string{"pending-first", "pending-second"} {
+				output, ok := results[id].Output.(fantasy.ToolResultOutputContentError)
+				require.True(t, ok, id)
+				require.Contains(t, output.Error.Error(), "Execution outcome is unknown")
+				require.Contains(t, output.Error.Error(), "check actual state before repeating any action")
+			}
+		})
+	}
+}
+
+func TestRunSettlementFailureStopsContinuation(t *testing.T) {
+	for _, failUpdate := range []bool{true, false} {
+		name := "partial tool result create"
+		if failUpdate {
+			name = "assistant update"
+		}
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			env := testEnv(t)
+			stored := env.messages
+			persistenceErr := errors.New("injected settlement persistence failure")
+			messages := &settlementFailureMessages{Service: stored, failUpdate: failUpdate, err: persistenceErr}
+			env.messages = messages
+			model := &settlementFailureModel{finishStreamModel: finishStreamModel{text: "unexpected continuation"}}
+			tool := &fakeTool{name: "record", resp: fantasy.NewTextResponse("earlier successful result")}
+			sa := testSessionAgent(env, model, &finishStreamModel{text: "title"}, "test", tool).(*sessionAgent)
+			readHooks := recordingHooks(t, sa, turnEvents...)
+			sess, err := env.sessions.Create(t.Context(), "settlement failure")
+			require.NoError(t, err)
+			var completed []notify.RunComplete
+			_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "do work", OnComplete: func(event notify.RunComplete) { completed = append(completed, event) }})
+			require.ErrorIs(t, err, persistenceErr)
+			require.ErrorIs(t, err, io.ErrUnexpectedEOF)
+			require.Equal(t, 1, messages.failures)
+			require.Equal(t, 2, model.calls)
+			require.True(t, tool.called)
+			require.False(t, sa.HasPendingWork(sess.ID))
+			require.Len(t, completed, 1)
+			require.Contains(t, completed[0].Error, persistenceErr.Error())
+			lines := readHooks()
+			require.Equal(t, "TurnStart", lines[0])
+			var endings int
+			for _, line := range lines[1:] {
+				if strings.HasPrefix(line, "StopFailure ") {
+					endings++
+				}
+				require.NotEqual(t, "Interrupt", line)
+				require.False(t, strings.HasPrefix(line, "TurnEnd"))
+			}
+			require.Equal(t, 1, endings)
+			require.Contains(t, strings.Join(lines, "\n"), persistenceErr.Error())
+			msgs, err := stored.List(t.Context(), sess.ID)
+			require.NoError(t, err)
+			var users int
+			results := make(map[string]message.ToolResult)
+			for _, msg := range msgs {
+				if msg.Role == message.User {
+					users++
+				}
+				for _, result := range msg.ToolResults() {
+					_, duplicate := results[result.ToolCallID]
+					require.False(t, duplicate)
+					results[result.ToolCallID] = result
+				}
+			}
+			require.Equal(t, 1, users)
+			require.Equal(t, "earlier successful result", results["completed-tool"].Content)
+			require.False(t, results["completed-tool"].IsError)
+			if failUpdate {
+				require.Zero(t, messages.settlementCreates)
+				require.Len(t, results, 1)
+			} else {
+				require.Equal(t, 2, messages.settlementCreates)
+				require.Len(t, results, 2)
+				require.Equal(t, failedToolCallResult, results["pending-first"].Content)
+				require.True(t, results["pending-first"].IsError)
+			}
+		})
+	}
+}
