+++ b/internal/permission/activity_test.go
@@ -0,0 +1,68 @@
+package permission
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/charmbracelet/crush/internal/activity"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPermissionActivity(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0o700))
+	tracker, err := activity.Open(dir)
+	require.NoError(t, err)
+	defer tracker.Close()
+	end := tracker.Run("session")
+	defer end()
+	state := func() string {
+		files, err := filepath.Glob(filepath.Join(dir, "*", "*.json"))
+		require.NoError(t, err)
+		require.Len(t, files, 1)
+		data, err := os.ReadFile(files[0])
+		require.NoError(t, err)
+		var record activity.Record
+		require.NoError(t, json.Unmarshal(data, &record))
+		return record.State
+	}
+	svc := NewPermissionService(t.TempDir(), []string{"allowed"}, nil, tracker)
+	granted, err := svc.Request(t.Context(), CreatePermissionRequest{SessionID: "session", ToolName: "allowed"})
+	require.NoError(t, err)
+	require.True(t, granted)
+	require.Equal(t, "working", state())
+	for _, resolve := range []string{"grant", "deny", "cancel"} {
+		ctx, cancel := context.WithCancel(t.Context())
+		requests := svc.Subscribe(ctx)
+		done := make(chan error, 1)
+		go func() {
+			_, err := svc.Request(ctx, CreatePermissionRequest{SessionID: "session", ToolName: "blocked", Path: "/tmp"})
+			done <- err
+		}()
+		select {
+		case event := <-requests:
+			require.Equal(t, "waiting_owner", state())
+			switch resolve {
+			case "grant":
+				require.True(t, svc.Grant(event.Payload))
+			case "deny":
+				require.True(t, svc.Deny(event.Payload))
+			case "cancel":
+				cancel()
+			}
+		case <-time.After(time.Second):
+			t.Fatal("missing permission")
+		}
+		if resolve == "cancel" {
+			require.ErrorIs(t, <-done, context.Canceled)
+		} else {
+			require.NoError(t, <-done)
+		}
+		cancel()
+		require.Equal(t, "working", state())
+	}
+}
diff --git a/internal/permission/admin_cancellation_test.go b/internal/permission/admin_cancellation_test.go
new file mode 100644
--- /dev/null
+++ b/internal/permission/admin_cancellation_test.go
@@ -0,0 +1,187 @@
+package permission
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func adminRequest(t *testing.T, svc Service, ctx context.Context, session string) <-chan error {
+	t.Helper()
+	done := make(chan error, 1)
+	go func() {
+		_, err := svc.Request(ctx, CreatePermissionRequest{SessionID: session, ToolCallID: "call", ToolName: "admin_step", Action: "admin", Path: "/tmp"})
+		done <- err
+	}()
+	return done
+}
+
+func adminResult(t *testing.T, done <-chan error, state AdminState, cause error) {
+	t.Helper()
+	select {
+	case err := <-done:
+		var admin *AdminError
+		require.ErrorAs(t, err, &admin)
+		require.Equal(t, state, admin.State)
+		require.ErrorIs(t, err, cause)
+	case <-time.After(time.Second):
+		t.Fatal("administrator request did not return")
+	}
+}
+
+func TestAdminCanceledBeforeClaim(t *testing.T) {
+	for _, preCanceled := range []bool{false, true} {
+		svc := NewPermissionService(t.TempDir(), nil, nil)
+		requests := svc.Subscribe(t.Context())
+		ctx, cancel := context.WithCancel(t.Context())
+		defer cancel()
+		if preCanceled {
+			cancel()
+		}
+		done := adminRequest(t, svc, ctx, "owner")
+		var req PermissionRequest
+		if !preCanceled {
+			select {
+			case event := <-requests:
+				req = event.Payload
+			case <-time.After(time.Second):
+				t.Fatal("missing approval")
+			}
+			cancel()
+			req.Description = "terminal-token"
+			require.False(t, svc.GrantPersistent(req))
+		}
+		adminResult(t, done, AdminNotStarted, context.Canceled)
+		require.Empty(t, svc.ActiveRequests())
+		require.False(t, svc.Grant(req))
+		require.False(t, svc.GrantPersistent(req))
+		select {
+		case <-requests:
+			t.Fatal("canceled request left a prompt")
+		default:
+		}
+	}
+}
+
+func TestAdminDeadlineBeforeClaim(t *testing.T) {
+	svc := NewPermissionService(t.TempDir(), nil, nil)
+	requests := svc.Subscribe(t.Context())
+	ctx, cancel := context.WithTimeout(t.Context(), 100*time.Millisecond)
+	defer cancel()
+	done := adminRequest(t, svc, ctx, "owner")
+	var req PermissionRequest
+	select {
+	case event := <-requests:
+		req = event.Payload
+	case <-time.After(time.Second):
+		t.Fatal("missing approval")
+	}
+	adminResult(t, done, AdminNotStarted, context.DeadlineExceeded)
+	require.Empty(t, svc.ActiveRequests())
+	req.Description = "stale-token"
+	require.False(t, svc.GrantPersistent(req))
+	require.False(t, svc.Grant(req))
+	require.False(t, svc.Deny(req))
+	select {
+	case <-requests:
+		t.Fatal("expired request left a prompt")
+	default:
+	}
+}
+
+func TestAdminCanceledClaimRetainsScopeUntilOriginalReceipt(t *testing.T) {
+	for _, deadline := range []bool{false, true} {
+		svc := NewPermissionService(t.TempDir(), []string{"admin_step", "admin_step:admin"}, nil)
+		svc.SetSessionScope(func(_ context.Context, session string) string {
+			if session == "child" {
+				return "owner"
+			}
+			return session
+		})
+		svc.SetPermissionMode(PermissionModeSysadmin)
+		svc.AutoApproveSession("owner")
+		requests := svc.Subscribe(t.Context())
+		ctx, cancel := context.WithCancel(t.Context())
+		cause := context.Canceled
+		if deadline {
+			cancel()
+			ctx, cancel = context.WithTimeout(t.Context(), 100*time.Millisecond)
+			cause = context.DeadlineExceeded
+		}
+		done := adminRequest(t, svc, WithHookApproval(ctx, "call"), "owner")
+		var req PermissionRequest
+		select {
+		case event := <-requests:
+			req = event.Payload
+		case <-time.After(time.Second):
+			t.Fatal("missing fresh approval")
+		}
+		req.Description = "original-token"
+		require.True(t, svc.GrantPersistent(req))
+		if !deadline {
+			cancel()
+		}
+		adminResult(t, done, AdminMayBeRunning, cause)
+		cancel()
+		require.Empty(t, svc.ActiveRequests())
+		retry := adminRequest(t, svc, t.Context(), "child")
+		select {
+		case err := <-retry:
+			var admin *AdminError
+			require.ErrorAs(t, err, &admin)
+			require.Equal(t, AdminBusy, admin.State)
+		case <-time.After(time.Second):
+			t.Fatal("busy request waited or published")
+		}
+		select {
+		case <-requests:
+			t.Fatal("busy request published a prompt")
+		default:
+		}
+		wrong := req
+		wrong.Description = "wrong-token"
+		require.False(t, svc.Grant(wrong))
+		require.False(t, svc.Deny(wrong))
+		require.False(t, svc.GrantPersistent(req))
+		require.True(t, svc.Grant(req))
+		require.False(t, svc.Grant(req))
+		require.False(t, svc.Deny(req))
+		fresh := adminRequest(t, svc, WithHookApproval(t.Context(), "call"), "owner")
+		select {
+		case event := <-requests:
+			require.NotEqual(t, req.ID, event.Payload.ID)
+			claim := event.Payload
+			claim.Description = "new-token"
+			require.True(t, svc.GrantPersistent(claim))
+			require.True(t, svc.Deny(claim))
+		case <-time.After(time.Second):
+			t.Fatal("missing fresh approval after receipt")
+		}
+		require.NoError(t, <-fresh)
+		require.Empty(t, svc.ActiveRequests())
+	}
+}
+
+func TestAdminDefaultBusyScopeIsSessionLocal(t *testing.T) {
+	svc := NewPermissionService(t.TempDir(), nil, nil)
+	requests := svc.Subscribe(t.Context())
+	ctx, cancel := context.WithCancel(t.Context())
+	done := adminRequest(t, svc, ctx, "first")
+	req := (<-requests).Payload
+	req.Description = "token"
+	require.True(t, svc.GrantPersistent(req))
+	cancel()
+	adminResult(t, done, AdminMayBeRunning, context.Canceled)
+	other := adminRequest(t, svc, t.Context(), "second")
+	select {
+	case event := <-requests:
+		require.True(t, svc.Deny(event.Payload))
+	case <-time.After(time.Second):
+		t.Fatal("unrelated session blocked")
+	}
+	require.NoError(t, <-other)
+	require.True(t, svc.Deny(req))
+	require.False(t, svc.Deny(req))
+}
