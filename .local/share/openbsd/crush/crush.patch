+++ b/internal/ui/model/terminal_theme.go
@@ -0,0 +1,80 @@
+package model
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"image/color"
+	"os"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"charm.land/lipgloss/v2"
+	"github.com/charmbracelet/crush/internal/ui/common"
+	"github.com/charmbracelet/crush/internal/ui/styles"
+)
+
+type terminalThemeTick struct{}
+
+type terminalThemeLoaded struct {
+	foreground color.Color
+	background color.Color
+	hash       [32]byte
+	seq        uint64
+	styles     styles.Styles
+	err        error
+}
+
+func terminalThemeTimer() tea.Cmd {
+	return tea.Tick(2*time.Second, func(time.Time) tea.Msg { return terminalThemeTick{} })
+}
+
+func (m *UI) followsTerminal() bool {
+	return common.ThemeNameFromConfig(m.com.Config()) == "terminal" && !m.userThemeSelected && !m.hostTheme.active
+}
+
+func (m *UI) updateTerminalTheme() tea.Cmd {
+	if !m.followsTerminal() || m.terminalBackground == nil || m.terminalForeground == nil {
+		return nil
+	}
+	foreground, background := m.terminalForeground, m.terminalBackground
+	previous, seq := m.terminalThemeHash, m.hostTheme.seq
+	return func() tea.Msg {
+		name := "vertrice-day"
+		if (tea.BackgroundColorMsg{Color: background}).IsDark() {
+			name = "vertrice-night"
+		}
+		path, err := styles.FindThemeFile(name)
+		if err != nil {
+			return nil
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return nil
+		}
+		hash := sha256.Sum256(append(data, []byte(fmt.Sprintf("%v:%v", foreground, background))...))
+		if hash == previous {
+			return nil
+		}
+		next, err := styles.LoadTheme(name)
+		if err == nil {
+			next.Background = background
+			base := lipgloss.NewStyle().Foreground(foreground)
+			next.Editor.Textarea.Focused.Base = base
+			next.Editor.Textarea.Focused.Text = base
+			next.Editor.Textarea.Focused.CursorLine = base
+			next.Editor.Textarea.Blurred.Base = base
+			next.Editor.Textarea.Blurred.Text = base
+			next.Editor.Textarea.Blurred.CursorLine = base
+		}
+		return terminalThemeLoaded{foreground: foreground, background: background, hash: hash, seq: seq, styles: next, err: err}
+	}
+}
+
+func sameTerminalColor(first, second color.Color) bool {
+	if first == nil || second == nil {
+		return first == second
+	}
+	red, green, blue, alpha := first.RGBA()
+	otherRed, otherGreen, otherBlue, otherAlpha := second.RGBA()
+	return red == otherRed && green == otherGreen && blue == otherBlue && alpha == otherAlpha
+}
