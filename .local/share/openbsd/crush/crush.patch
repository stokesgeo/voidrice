+// tab-bearing line really exercises is a wide whitespace run.
+func TestSelectionInvertsOnTabExpandedLine(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "a\tb\tc")
+	if got := ta.Value(); got != "a    b    c" {
+		t.Fatalf("tab expansion changed: %q", got)
+	}
+	v.SetPosition(0, 1)
+	press(t, v, ta, "v")
+	pressAll(t, v, ta, "lll")
+	if got := ta.SelectedText(); got != "    " {
+		t.Errorf("tab-expanded selection: %q, want four spaces", got)
+	}
+}
+
+// PositionAt is viewport-relative, so a selection made below the
+// scroll offset is the case that catches an inversion that forgot it.
+func TestSelectionInvertsInScrolledViewport(t *testing.T) {
+	v, ta := newTestModal(t)
+	ta.SetWidth(12)
+	ta.SetHeight(2)
+	seedNormal(t, v, ta, "aaaa bbbb cccc\nsecond line here\nthird line here\nfourth line wraps here")
+	v.SetPosition(3, 0)
+	if ta.ScrollYOffset() == 0 {
+		t.Fatalf("viewport never scrolled; test proves nothing")
+	}
+	press(t, v, ta, "v")
+	press(t, v, ta, "$")
+	if got := ta.SelectedText(); got != "fourth line wraps here" {
+		t.Errorf("scrolled wrapped selection: %q", got)
+	}
+	start, end, ok := ta.Selection()
+	if !ok || start.Row != 3 || start.Col != 0 || end.Row != 3 || end.Col != 22 {
+		t.Errorf("scrolled wrapped range: %v %v %v", start, end, ok)
+	}
+}
+
+// Linewise VISUAL is a mode, not a cursor position: `V` leaves the
+// cursor on its line so a following motion extends by whole rows
+// instead of walking back over a displaced head.
+func TestLinewiseVisualKeepsCursorOnItsLine(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "one\ntwo\nthree")
+	v.SetPosition(1, 2)
+	before, beforeCol := v.Position()
+	press(t, v, ta, "V")
+	row, col := v.Position()
+	if row != before || col != beforeCol {
+		t.Errorf("cursor after V: (%d,%d), want (%d,%d)", row, col, before, beforeCol)
+	}
+	if !ta.HasSelection() {
+		t.Error("V left no selection")
+	}
+}
+
+func TestLinewiseVisualExtendsUpward(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "one\ntwo\nthree")
+	v.SetPosition(1, 1)
+	press(t, v, ta, "V")
+	press(t, v, ta, "k")
+	press(t, v, ta, "d")
+	if got := ta.Value(); got != "three" {
+		t.Errorf("Vkd from row 1: %q, want three", got)
+	}
+	if v.Mode() != Normal {
+		t.Errorf("Vkd mode: %s, want Normal", v.Mode())
+	}
+}
+
+func TestLinewiseVisualExtendsDownward(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "one\ntwo\nthree")
+	v.SetPosition(1, 1)
+	press(t, v, ta, "V")
+	press(t, v, ta, "j")
+	press(t, v, ta, "d")
+	if got := ta.Value(); got != "one" {
+		t.Errorf("Vjd from row 1: %q, want one", got)
+	}
+}
+
+func TestLinewiseVisualYankAndPaste(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "one\ntwo\nthree")
+	press(t, v, ta, "V")
+	pressAll(t, v, ta, "jj")
+	press(t, v, ta, "y")
+	if v.register != "one\ntwo\nthree" {
+		t.Fatalf("register after Vjjy: %q, want the whole buffer", v.register)
+	}
+	if got := ta.Value(); got != "one\ntwo\nthree" {
+		t.Errorf("Vjjy edited the buffer: %q", got)
+	}
+	if row, _ := v.Position(); row != 0 {
+		t.Errorf("cursor row after Vjjy: %d, want 0", row)
+	}
+	press(t, v, ta, "p")
+	// `p` is charwise: the three lines land after the cursor, which y
+	// left at the start of the last row.
+	if got := ta.Value(); got != "one\none\ntwo\nthree\ntwo\nthree" {
+		t.Errorf("after p: %q", got)
+	}
+}
+
+func TestLinewiseVisualSwitchesToCharwise(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "one\ntwo")
+	v.SetPosition(0, 0)
+	press(t, v, ta, "V")
+	press(t, v, ta, "v") // linewise → charwise, still VISUAL
+	if v.Mode() != Visual {
+		t.Fatalf("v from linewise: mode=%s, want Visual", v.Mode())
+	}
+	press(t, v, ta, "l")
+	press(t, v, ta, "d")
+	if got := ta.Value(); got != "e\ntwo" {
+		t.Errorf("Vvld: %q, want \"ne\\ntwo\"", got)
+	}
+}
+
+// Growing upward from the last row hits both branches at once: the
+// range spans rows and there is no trailing newline to take.
+func TestLinewiseVisualUpwardFromLastRow(t *testing.T) {
+	v, ta := newTestModal(t)
+	seedNormal(t, v, ta, "one\ntwo\nthree")
+	press(t, v, ta, "G")
+	press(t, v, ta, "V")
+	press(t, v, ta, "k")
+	press(t, v, ta, "d")
+	if got := ta.Value(); got != "one" {
+		t.Errorf("GVkd: %q, want one", got)
+	}
+}
