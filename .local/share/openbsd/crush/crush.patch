+package vimbubble_test
+
+import (
+	"charm.land/bubbles/v2/textarea"
+	tea "charm.land/bubbletea/v2"
+	vimbubble "github.com/guygrigsby/vimbubble/v2"
+)
+
+// Example shows the typical wiring inside a Bubble Tea Update loop:
+// route key presses through the Modal first, fall back to the textarea
+// for anything it doesn't consume.
+func Example() {
+	ta := textarea.New()
+	vim := vimbubble.New(&ta)
+	vim.SetEnabled(true) // off by default; opt in.
+
+	update := func(msg tea.KeyPressMsg) tea.Cmd {
+		if consumed, cmd := vim.Update(msg); consumed {
+			return cmd
+		}
+		var cmd tea.Cmd
+		ta, cmd = ta.Update(msg)
+		return cmd
+	}
+
+	_ = update
+}
+
+// ExampleNew shows that a Modal starts disabled. Every key flows
+// through to the textarea untouched until SetEnabled(true).
+func ExampleNew() {
+	ta := textarea.New()
+	vim := vimbubble.New(&ta)
+
+	// Disabled by default: vim.Update never consumes, so the host
+	// textarea handles every key.
+	consumed, _ := vim.Update(tea.KeyPressMsg{Code: 'h', Text: "h"})
+	_ = consumed // always false until SetEnabled(true).
+}
+
+// ExampleModal_SetEnabled toggles vim mode on and off, e.g. backing
+// a /vim slash command in the host app. Enabling lands the composer
+// in NORMAL; disabling clears any pending chord/operator state.
+func ExampleModal_SetEnabled() {
+	ta := textarea.New()
+	vim := vimbubble.New(&ta)
+
+	vim.SetEnabled(true)  // enters NORMAL.
+	vim.SetEnabled(false) // back to pass-through.
+}
+
+// ExampleModal_Update demonstrates the (consumed, cmd) contract.
+// When consumed is true, the caller must NOT forward the key to its
+// textarea — vim has already handled it (and possibly synthesised
+// key events into the textarea on the caller's behalf).
+func ExampleModal_Update() {
+	ta := textarea.New()
+	vim := vimbubble.New(&ta)
+	vim.SetEnabled(true)
+
+	// In NORMAL mode, 'h' moves the textarea cursor left through the
+	// public cursor API. consumed=true so we stop here.
+	consumed, cmd := vim.Update(tea.KeyPressMsg{Code: 'h', Text: "h"})
+	if consumed {
+		// Run any command vim emitted (rare today).
+		_ = cmd
+		return
+	}
+	// Not consumed: hand the key to the textarea as usual.
+	ta, _ = ta.Update(tea.KeyPressMsg{Code: 'h', Text: "h"})
+	_ = ta
+}
+
+// ExampleModal_Mode shows the visual-mode label a host would render
+// next to the composer.
+func ExampleModal_Mode() {
+	ta := textarea.New()
+	ta.SetValue("hello world")
+	vim := vimbubble.New(&ta)
+	vim.SetEnabled(true)
+	vim.SetPosition(0, 0)
+
+	vim.Update(tea.KeyPressMsg{Code: 'v', Text: "v"}) // enter VISUAL
+	vim.Update(tea.KeyPressMsg{Code: 'w', Text: "w"}) // extend over "hello "
+	_ = vim.ModeLabel()                               // "-- VISUAL --"
+}
