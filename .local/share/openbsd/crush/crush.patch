@@ -0,0 +1,26 @@
+package model
+
+import (
+	"strings"
+
+	"github.com/charmbracelet/x/ansi"
+)
+
+func sessionIdentityLine(title, id string, width int) string {
+	if width <= 0 {
+		return ""
+	}
+	shortID := id
+	if len(shortID) > 8 {
+		shortID = shortID[:8]
+	}
+	title = strings.Join(strings.Fields(ansi.Strip(title)), " ")
+	if title == "" {
+		title = "Untitled session"
+	}
+	prefix := shortID + " · "
+	if ansi.StringWidth(prefix) >= width {
+		return ansi.Truncate(shortID, width, "")
+	}
+	return prefix + ansi.Truncate(title, width-ansi.StringWidth(prefix), "…")
+}
