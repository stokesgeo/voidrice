diff --git a/internal/activity/activity.go b/internal/activity/activity.go
new file mode 100644
--- /dev/null
+++ b/internal/activity/activity.go
@@ -0,0 +1,235 @@
+package activity
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+	"time"
+)
+
+type Record struct {
+	Version    int       `json:"version"`
+	InstanceID string    `json:"instance_id"`
+	SessionID  string    `json:"session_id"`
+	PID        int       `json:"pid"`
+	State      string    `json:"state"`
+	Sequence   uint64    `json:"sequence"`
+	ObservedAt time.Time `json:"observed_at"`
+}
+
+type counts struct {
+	runs  int
+	waits int
+}
+
+type Tracker struct {
+	mu       sync.Mutex
+	root     *os.Root
+	instance string
+	sessions map[string]counts
+	sequence uint64
+	closed   bool
+	stop     chan struct{}
+	done     chan struct{}
+	lastErr  error
+}
+
+func Open(directory string) (*Tracker, error) {
+	if directory == "" {
+		return nil, nil
+	}
+	root, err := os.OpenRoot(directory)
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	info, err := root.Stat(".")
+	if err != nil {
+		return nil, err
+	}
+	if !info.IsDir() || info.Mode().Perm() != 0o700 {
+		return nil, errors.New("activity directory must have mode 0700")
+	}
+	if err := checkOwner(root); err != nil {
+		return nil, err
+	}
+	var token [16]byte
+	if _, err := rand.Read(token[:]); err != nil {
+		return nil, err
+	}
+	instance := hex.EncodeToString(token[:])
+	if err := root.Mkdir(instance, 0o700); err != nil {
+		return nil, err
+	}
+	child, err := root.OpenRoot(instance)
+	if err != nil {
+		return nil, err
+	}
+	t := &Tracker{root: child, instance: instance, sessions: make(map[string]counts), stop: make(chan struct{}), done: make(chan struct{})}
+	go func() {
+		defer close(t.done)
+		ticker := time.NewTicker(2 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-t.stop:
+				return
+			case <-ticker.C:
+				t.mu.Lock()
+				if !t.closed {
+					for id := range t.sessions {
+						t.publish(id)
+					}
+				}
+				t.mu.Unlock()
+			}
+		}
+	}()
+	return t, nil
+}
+
+func (t *Tracker) Observe(sessionID string) {
+	if t == nil || sessionID == "" {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	if _, exists := t.sessions[sessionID]; !exists {
+		t.sessions[sessionID] = counts{}
+	}
+	t.publish(sessionID)
+}
+
+func (t *Tracker) Run(sessionID string) func() {
+	return t.begin(sessionID, false)
+}
+
+func (t *Tracker) Wait(sessionID string) func() {
+	return t.begin(sessionID, true)
+}
+
+func (t *Tracker) begin(id string, wait bool) func() {
+	if t == nil || id == "" {
+		return func() {}
+	}
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		return func() {}
+	}
+	c := t.sessions[id]
+	if wait {
+		c.waits++
+	} else {
+		c.runs++
+	}
+	t.sessions[id] = c
+	t.publish(id)
+	t.mu.Unlock()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			t.mu.Lock()
+			defer t.mu.Unlock()
+			if t.closed {
+				return
+			}
+			c := t.sessions[id]
+			if wait {
+				c.waits--
+			} else {
+				c.runs--
+			}
+			t.sessions[id] = c
+			t.publish(id)
+		})
+	}
+}
+
+func (t *Tracker) publish(id string) {
+	state := "idle"
+	c := t.sessions[id]
+	if c.runs > 0 {
+		state = "working"
+	}
+	if c.waits > 0 {
+		state = "waiting_owner"
+	}
+	if t.closed {
+		state = "unknown"
+	}
+	t.sequence++
+	record := Record{Version: 1, InstanceID: t.instance, SessionID: id, PID: os.Getpid(), State: state, Sequence: t.sequence, ObservedAt: time.Now().UTC()}
+	data, err := json.Marshal(record)
+	if err != nil {
+		t.lastErr = err
+		return
+	}
+	hash := sha256.Sum256([]byte(id))
+	name := hex.EncodeToString(hash[:])
+	temp := name + ".tmp"
+	file, err := t.root.OpenFile(temp, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		t.lastErr = err
+		return
+	}
+	defer t.root.Remove(temp)
+	_, err = file.Write(data)
+	closeErr := file.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = t.root.Rename(temp, name+".json")
+	}
+	t.lastErr = err
+}
+
+func (t *Tracker) Close() error {
+	if t == nil {
+		return nil
+	}
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		<-t.done
+		return nil
+	}
+	t.closed = true
+	close(t.stop)
+	for id := range t.sessions {
+		t.publish(id)
+	}
+	err := t.lastErr
+	t.mu.Unlock()
+	<-t.done
+	if closeErr := t.root.Close(); err == nil {
+		err = closeErr
+	}
+	return err
+}
+
+func (r Record) Current(now time.Time) string {
+	age := now.Sub(r.ObservedAt)
+	if r.Version != 1 || r.InstanceID == "" || r.SessionID == "" || r.PID <= 0 || r.Sequence == 0 || age < 0 || age > 10*time.Second {
+		return "unknown"
+	}
+	switch r.State {
+	case "working", "waiting_owner", "idle":
+		return r.State
+	default:
+		return "unknown"
+	}
+}
+
+func ownerError() error {
+	return fmt.Errorf("activity directory must be owned by the current user")
+}
