+package model
+
+import (
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/charmbracelet/crush/internal/config"
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/charmbracelet/crush/internal/session"
+	"github.com/charmbracelet/crush/internal/ui/attachments"
+	"github.com/charmbracelet/crush/internal/ui/completions"
+	uv "github.com/charmbracelet/ultraviolet"
+	vim "github.com/guygrigsby/vimbubble/v2"
+	"github.com/stretchr/testify/require"
+)
+
+func viUI() *UI {
+	u := newSelectionTestUI()
+	u.keyMap = DefaultKeyMap()
+	u.com.Workspace = &testWorkspace{cfg: &config.Config{Options: &config.Options{TUI: &config.TUIOptions{Vi: true}}}}
+	return u
+}
+func viKeys(u *UI, text string) {
+	for _, r := range text {
+		u.Update(tea.KeyPressMsg{Code: r, Text: string(r)})
+	}
+}
+func TestViBangExitAndMultilineArrows(t *testing.T) {
+	u := viUI()
+	viKeys(u, "!abc")
+	require.True(t, u.bangMode)
+	for i := 0; i < 3; i++ {
+		u.Update(tea.KeyPressMsg{Code: tea.KeyBackspace})
+	}
+	require.True(t, u.bangWasEmpty)
+	u.Update(tea.KeyPressMsg{Code: tea.KeyBackspace})
+	require.False(t, u.bangMode)
+	u.Update(openEditorMsg{Text: "one\ntwo"})
+	u.textarea.MoveToBegin()
+	u.textarea.CursorEnd()
+	u.Update(tea.KeyPressMsg{Code: tea.KeyRight})
+	require.Equal(t, 1, u.textarea.Line())
+	require.Equal(t, 0, u.textarea.Column())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyLeft})
+	require.Equal(t, 0, u.textarea.Line())
+	require.Equal(t, 3, u.textarea.Column())
+}
+func TestViAttachmentEscapePriority(t *testing.T) {
+	u := viUI()
+	sty := u.com.Styles.Attachments
+	u.attachments = attachments.New(attachments.NewRenderer(sty), attachments.Keymap{DeleteMode: u.keyMap.Editor.AttachmentDeleteMode, DeleteAll: u.keyMap.Editor.DeleteAllAttachments, Escape: u.keyMap.Editor.Escape})
+	u.attachments.Update(message.Attachment{})
+	u.session = &session.Session{ID: "busy"}
+	u.agentReady = true
+	u.agentBusyCache.set(true)
+	u.Update(tea.KeyPressMsg{Code: 'r', Mod: tea.ModCtrl})
+	require.True(t, u.attachments.Deleting())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	require.False(t, u.attachments.Deleting())
+	require.False(t, u.isCanceling)
+	viKeys(u, "r")
+	require.Len(t, u.attachments.List(), 1)
+	require.Equal(t, "r", u.textarea.Value())
+}
+func TestViEditingFlow(t *testing.T) {
+	u := viUI()
+	viKeys(u, "one two")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	require.NotNil(t, u.vi)
+	require.Equal(t, vim.Normal, u.vi.Mode())
+	require.False(t, u.isCanceling)
+	u.textarea.MoveToBegin()
+	viKeys(u, "cwXYZ")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	require.Equal(t, "XYZ two", u.textarea.Value())
+	viKeys(u, "u")
+	require.Equal(t, "one two", u.textarea.Value())
+	u.Update(tea.KeyPressMsg{Code: 'r', Mod: tea.ModCtrl})
+	require.Equal(t, "XYZ two", u.textarea.Value())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEnter, Mod: tea.ModShift})
+	require.Equal(t, "XYZ two", u.textarea.Value())
+	require.Empty(t, u.com.Workspace.(*testWorkspace).runPrompts)
+	viKeys(u, "v")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEnter, Mod: tea.ModShift})
+	require.Equal(t, "XYZ two", u.textarea.Value())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	require.Equal(t, vim.Normal, u.vi.Mode())
+}
+func TestViExternalPasteAndReset(t *testing.T) {
+	u := viUI()
+	viKeys(u, "base")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	u.Update(openEditorMsg{Text: "external 👨‍👩‍👧‍👦"})
+	require.Equal(t, vim.Insert, u.vi.Mode())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "base", u.textarea.Value())
+	u.Update(tea.PasteMsg{Content: " literal dd"})
+	require.Contains(t, u.textarea.Value(), "literal dd")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "base", u.textarea.Value())
+	viKeys(u, "d")
+	u.Update(tea.BlurMsg{})
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "d")
+	require.Equal(t, "base", u.textarea.Value())
+	u.session = &session.Session{ID: "next"}
+	u.Update(tea.FocusMsg{})
+	require.Equal(t, vim.Insert, u.vi.Mode())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "base", u.textarea.Value())
+}
+func TestViDefaultOff(t *testing.T) {
+	u := newSelectionTestUI()
+	u.keyMap = DefaultKeyMap()
+	viKeys(u, "hello")
+	require.Nil(t, u.vi)
+	require.Equal(t, "hello", u.textarea.Value())
+}
+
+func TestViBusyEscapeAndSend(t *testing.T) {
+	u := viUI()
+	u.session = &session.Session{ID: "busy"}
+	u.agentReady = true
+	u.agentBusyCache.set(true)
+	viKeys(u, "draft")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	require.False(t, u.isCanceling)
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape, Mod: tea.ModAlt})
+	require.True(t, u.isCanceling)
+	require.Equal(t, "enter", u.ShortHelp()[0].Help().Key)
+	u.agentBusyCache.set(false)
+	u.isCanceling = false
+	require.False(t, u.handleViKey(tea.KeyPressMsg{Code: tea.KeyEnter, Mod: tea.ModAlt}))
+}
+func TestViBangBoundaryClearsUndo(t *testing.T) {
+	u := viUI()
+	viKeys(u, "ordinary draft")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	u.Update(openEditorMsg{Text: "!echo synthetic"})
+	require.True(t, u.bangMode)
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "echo synthetic", u.textarea.Value())
+	u.Update(openEditorMsg{Text: "ordinary again"})
+	require.False(t, u.bangMode)
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "ordinary again", u.textarea.Value())
+	require.False(t, u.bangMode)
+}
+func TestViCompletionBackspaceCloses(t *testing.T) {
+	u := viUI()
+	sty := u.com.Styles.Completions
+	u.completions = completions.New(sty.Normal, sty.Focused, sty.Match)
+	viKeys(u, "@")
+	require.True(t, u.completionsOpen)
+	u.Update(tea.KeyPressMsg{Code: tea.KeyBackspace})
+	require.False(t, u.completionsOpen)
+	require.Empty(t, u.textarea.Value())
+}
+func TestViKeyboardSelection(t *testing.T) {
+	u := viUI()
+	viKeys(u, "hello")
+	u.textarea.MoveToBegin()
+	u.Update(tea.KeyPressMsg{Code: tea.KeyRight, Mod: tea.ModShift})
+	u.Update(tea.KeyPressMsg{Code: tea.KeyRight, Mod: tea.ModShift})
+	require.Equal(t, "he", u.textarea.SelectedText())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyBackspace})
+	require.Equal(t, "llo", u.textarea.Value())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "hello", u.textarea.Value())
+}
+
+type viTerminalProbe struct {
+	ui   *UI
+	done bool
+}
+
+func (p *viTerminalProbe) Init() tea.Cmd {
+	return tea.Tick(8*time.Second, func(time.Time) tea.Msg { return "timeout" })
+}
+func (p *viTerminalProbe) View() tea.View {
+	return tea.NewView(p.ui.vi.ModeLabel() + "\n" + p.ui.textarea.View())
+}
+func (p *viTerminalProbe) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
+	if key, ok := msg.(tea.KeyPressMsg); ok && key.String() == "ctrl+q" {
+		p.done = true
+		return p, tea.Quit
+	}
+	if msg == "timeout" {
+		return p, tea.Quit
+	}
+	switch msg.(type) {
+	case tea.KeyPressMsg, tea.PasteMsg:
+		p.ui.Update(msg)
+	}
+	return p, nil
+}
+func TestViNativePTY(t *testing.T) {
+	if os.Getenv("CRUSH_VI_PTY") != "1" {
+		t.Skip("opt-in synthetic PTY probe")
+	}
+	u := viUI()
+	u.prepareVi(nil)
+	p := &viTerminalProbe{ui: u}
+	_, err := tea.NewProgram(p).Run()
+	require.NoError(t, err)
+	require.True(t, p.done)
+	require.Equal(t, "aabbc", u.textarea.Value())
+	require.Equal(t, vim.Normal, u.vi.Mode())
+	fmt.Println("VI_PTY_PASS")
+}
+func TestViNativeTerminalGestures(t *testing.T) {
+	decoder := uv.EventDecoder{}
+	for _, tc := range []struct{ wire, want string }{{"\x1b\r", "alt+enter"}, {"\x1b\x1b", "alt+esc"}, {"\r", "enter"}} {
+		_, event := decoder.Decode([]byte(tc.wire))
+		keyEvent, ok := event.(uv.KeyPressEvent)
+		require.True(t, ok, "%T", event)
+		require.Equal(t, tc.want, tea.KeyPressMsg(keyEvent).String())
+	}
+}
+func TestViEnterSendAndShiftNewline(t *testing.T) {
+	for _, normal := range []bool{false, true} {
+		u := viUI()
+		u.session = &session.Session{ID: "synthetic"}
+		viKeys(u, "first")
+		u.Update(tea.KeyPressMsg{Code: tea.KeyEnter, Mod: tea.ModShift})
+		viKeys(u, "second")
+		require.Equal(t, "first\nsecond", u.textarea.Value())
+		if normal {
+			u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+		}
+		_, cmd := u.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
+		require.NotNil(t, cmd)
+		require.Empty(t, u.textarea.Value())
+		require.Empty(t, u.com.Workspace.(*testWorkspace).runPrompts)
+	}
+}
+
+func TestViExplicitSend(t *testing.T) {
+	u := viUI()
+	u.session = &session.Session{ID: "synthetic"}
+	viKeys(u, "send me")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	_, cmd := u.Update(tea.KeyPressMsg{Code: tea.KeyEnter, Mod: tea.ModAlt})
+	require.NotNil(t, cmd)
+	require.Empty(t, u.textarea.Value())
+	require.Empty(t, u.com.Workspace.(*testWorkspace).runPrompts)
+}
+func TestViCompletionAndMouse(t *testing.T) {
+	u := viUI()
+	sty := u.com.Styles.Completions
+	u.completions = completions.New(sty.Normal, sty.Focused, sty.Match)
+	viKeys(u, "@")
+	require.True(t, u.completionsOpen)
+	require.False(t, u.handleViKey(tea.KeyPressMsg{Code: tea.KeyTab}))
+	require.Equal(t, vim.Insert, u.vi.Mode())
+	require.True(t, u.insertCompletionText("example.go"))
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Empty(t, u.textarea.Value())
+	u.Update(openEditorMsg{Text: "hello world"})
+	u.textarea.MoveToBegin()
+	pos := u.textarea.PositionAt(0, 0)
+	offset := 0
+	for offset < u.layout.editor.Dx() && u.textarea.PositionAt(offset, 0) == pos {
+		offset++
+	}
+	x, y := u.layout.editor.Min.X+offset-1, u.layout.editor.Min.Y+1
+	u.Update(tea.MouseClickMsg(tea.Mouse{X: x, Y: y, Button: uv.MouseLeft}))
+	u.Update(tea.MouseMotionMsg(tea.Mouse{X: x + 5, Y: y, Button: uv.MouseLeft}))
+	u.Update(tea.MouseReleaseMsg(tea.Mouse{X: x + 5, Y: y, Button: uv.MouseLeft}))
+	require.Equal(t, "hello", u.textarea.SelectedText())
+}
+func TestViHistoryAndClusters(t *testing.T) {
+	u := viUI()
+	viKeys(u, "draft")
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "i")
+	u.promptHistory.messages = []string{"old prompt"}
+	u.promptHistory.index = -1
+	u.textarea.MoveToBegin()
+	u.Update(tea.KeyPressMsg{Code: tea.KeyUp})
+	require.Equal(t, "old prompt", u.textarea.Value())
+	u.Update(tea.KeyPressMsg{Code: tea.KeyEscape})
+	viKeys(u, "u")
+	require.Equal(t, "draft", u.textarea.Value())
+	u.Update(openEditorMsg{Text: "👨‍👩‍👧‍👦"})
+	u.Update(tea.KeyPressMsg{Code: tea.KeyBackspace})
+	require.Empty(t, u.textarea.Value())
+}
