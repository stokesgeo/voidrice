+	"time"
+
+	"github.com/charmbracelet/crush/internal/activity"
+	"github.com/stretchr/testify/require"
+)
+
+func TestQuestionActivityCancellation(t *testing.T) {
+	dir := t.TempDir()
+	require.NoError(t, os.Chmod(dir, 0o700))
+	tracker, err := activity.Open(dir)
+	require.NoError(t, err)
+	defer tracker.Close()
+	end := tracker.Run("session")
+	defer end()
+	svc := NewService(tracker)
+	ctx, cancel := context.WithCancel(t.Context())
+	requests := svc.Subscribe(ctx)
+	done := make(chan error, 1)
+	go func() {
+		_, err := svc.Ask(ctx, Request{SessionID: "session", Questions: []Question{{Type: TypeFreeText, Text: "Synthetic?", Description: "Synthetic test"}}})
+		done <- err
+	}()
+	select {
+	case <-requests:
+	case <-time.After(time.Second):
+		t.Fatal("missing question")
+	}
+	state := func() string {
+		files, err := filepath.Glob(filepath.Join(dir, "*", "*.json"))
+		require.NoError(t, err)
+		require.Len(t, files, 1)
+		data, err := os.ReadFile(files[0])
+		require.NoError(t, err)
+		var record activity.Record
+		require.NoError(t, json.Unmarshal(data, &record))
+		return record.State
+	}
+	require.Equal(t, "waiting_owner", state())
+	cancel()
+	require.ErrorIs(t, <-done, context.Canceled)
+	require.Equal(t, "working", state())
+	end()
+	require.Equal(t, "idle", state())
+}
