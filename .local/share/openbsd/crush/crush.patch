+package permission
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestAdminAlwaysRequiresFreshApproval(t *testing.T) {
+	svc := NewPermissionService(t.TempDir(), []string{"admin_step", "admin_step:admin"}, nil)
+	svc.SetPermissionMode(PermissionModeSysadmin)
+	svc.AutoApproveSession("owner")
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	requests := svc.Subscribe(ctx)
+	for range 2 {
+		done := make(chan bool, 1)
+		go func() {
+			granted, err := svc.Request(ctx, CreatePermissionRequest{SessionID: "owner", ToolCallID: "call", ToolName: "admin_step", Action: "admin", Path: "/tmp"})
+			if err != nil {
+				done <- false
+				return
+			}
+			done <- granted
+		}()
+		select {
+		case event := <-requests:
+			require.False(t, svc.Grant(event.Payload), "approval alone is not successful execution")
+			claim := event.Payload
+			claim.Description = "private terminal claim"
+			require.True(t, svc.GrantPersistent(claim))
+			require.False(t, svc.Deny(event.Payload), "stale dialogs must not resolve a claimed action")
+			require.False(t, svc.GrantPersistent(claim), "only one terminal may claim execution")
+			select {
+			case <-done:
+				t.Fatal("claim must not finish the tool before command execution")
+			default:
+			}
+			require.True(t, svc.Grant(claim))
+		case <-done:
+			t.Fatal("admin action bypassed explicit approval")
+		case <-time.After(time.Second):
+			t.Fatal("missing admin approval request")
+		}
+		require.True(t, <-done)
+	}
+}
