@@ -0,0 +1,62 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/permission"
+	"github.com/stretchr/testify/require"
+)
+
+func TestAdminToolCancellationAndBusyStopTurn(t *testing.T) {
+	svc := permission.NewPermissionService(t.TempDir(), nil, nil)
+	requests := svc.Subscribe(t.Context())
+	tool := NewAdminTool(svc, t.TempDir())
+	input, err := json.Marshal(AdminParams{Executable: "/bin/echo", Description: "test"})
+	require.NoError(t, err)
+	ctx, cancel := context.WithCancel(context.WithValue(t.Context(), SessionIDContextKey, "owner"))
+	done := make(chan fantasy.ToolResponse, 1)
+	go func() {
+		response, err := tool.Run(ctx, fantasy.ToolCall{ID: "call", Input: string(input)})
+		if err != nil {
+			done <- fantasy.ToolResponse{}
+			return
+		}
+		done <- response
+	}()
+	req := (<-requests).Payload
+	req.Description = "terminal-token"
+	require.True(t, svc.GrantPersistent(req))
+	cancel()
+	select {
+	case response := <-done:
+		require.True(t, response.IsError)
+		require.True(t, response.StopTurn)
+		require.Contains(t, response.Content, "may still be running")
+	case <-time.After(time.Second):
+		t.Fatal("tool did not finish")
+	}
+	response, err := tool.Run(context.WithValue(t.Context(), SessionIDContextKey, "owner"), fantasy.ToolCall{ID: "retry", Input: string(input)})
+	require.NoError(t, err)
+	require.True(t, response.IsError)
+	require.True(t, response.StopTurn)
+	require.Contains(t, response.Content, "no new command")
+	require.True(t, svc.Deny(req))
+	response, err = tool.Run(ctx, fantasy.ToolCall{ID: "canceled", Input: string(input)})
+	require.NoError(t, err)
+	require.True(t, response.StopTurn)
+	require.Contains(t, response.Content, "not started")
+}
+
+func TestAdminToolDeniedStopsTurn(t *testing.T) {
+	tool := NewAdminTool(&recordingPermissionService{allow: false}, t.TempDir())
+	input, err := json.Marshal(AdminParams{Executable: "/bin/echo", Description: "test"})
+	require.NoError(t, err)
+	response, err := tool.Run(context.WithValue(t.Context(), SessionIDContextKey, "owner"), fantasy.ToolCall{ID: "call", Input: string(input)})
+	require.NoError(t, err)
+	require.True(t, response.IsError)
+	require.True(t, response.StopTurn)
+}
