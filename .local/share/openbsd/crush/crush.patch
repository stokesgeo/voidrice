+func TestVisualSelectsAndOperates(t *testing.T) {
+	ta := textarea.New()
+	ta.SetValue("hello world")
+	v := New(&ta)
+	v.SetEnabled(true)
+	v.SetPosition(0, 0)
+	press(t, v, &ta, "v")
+	if v.Mode() != Visual {
+		t.Fatalf("mode %s", v.Mode())
+	}
+	press(t, v, &ta, "w") // selection now covers "hello "
+	start, end, ok := ta.Selection()
+	if !ok || start.Col != 0 || end.Col != 7 {
+		t.Errorf("selection %v %v %v", start, end, ok)
+	}
+	press(t, v, &ta, "d")
+	if ta.Value() != "orld" || v.Mode() != Normal {
+		t.Errorf("after d: %q %s", ta.Value(), v.Mode())
+	}
+	press(t, v, &ta, "v")
+	press(t, v, &ta, "$")
+	press(t, v, &ta, "y")
+	if v.Mode() != Normal || ta.Value() != "orld" {
+		t.Errorf("y keeps text: %q", ta.Value())
+	}
+	press(t, v, &ta, "p")
+	if ta.Value() != "oorldrld" {
+		t.Errorf("p pastes the yank: %q", ta.Value())
+	}
+	press(t, v, &ta, "V")
+	if _, _, ok := ta.Selection(); !ok || v.Mode() != Visual {
+		t.Error("V selects the line")
+	}
+	press(t, v, &ta, "escape")
+	if _, _, ok := ta.Selection(); ok || v.Mode() != Normal {
+		t.Error("escape clears the selection")
+	}
+}
