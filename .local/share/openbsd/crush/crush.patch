+++ b/internal/agent/tools/admin.go
@@ -0,0 +1,57 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"path/filepath"
+
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/permission"
+)
+
+type AdminParams struct {
+	Executable  string   `json:"executable" description:"Absolute executable path to run as root, shown verbatim for fresh owner approval"`
+	Args        []string `json:"args" description:"Exact argument vector, never include passwords or other secrets"`
+	Description string   `json:"description" description:"Why administrator access is required and what will change"`
+}
+
+func validateAdminRequest(params AdminParams) error {
+	if !filepath.IsAbs(params.Executable) || params.Description == "" {
+		return fmt.Errorf("an absolute executable and an explanation are required")
+	}
+	return nil
+}
+
+func NewAdminTool(permissions permission.Service, workingDir string) fantasy.AgentTool {
+	return fantasy.NewAgentTool("admin_step", "Request fresh owner approval for an OpenBSD administrator command. The approving local UI yields its own terminal to doas and restores Crush on exit. Passwords and command output never enter chat or logs. No popup, backgrounding, persistent approval or automatic retry. Inspect actual state before retrying an unsuccessful or interrupted action.", func(ctx context.Context, params AdminParams, call fantasy.ToolCall) (fantasy.ToolResponse, error) {
+		if err := validateAdminRequest(params); err != nil {
+			return adminErrorResponse(err.Error()), nil
+		}
+		sessionID := GetSessionFromContext(ctx)
+		if sessionID == "" {
+			return adminErrorResponse("session ID is required"), nil
+		}
+		spec, err := json.Marshal(params)
+		if err != nil {
+			return adminErrorResponse(err.Error()), nil
+		}
+		success, err := permissions.Request(ctx, permission.CreatePermissionRequest{
+			SessionID: sessionID, ToolCallID: call.ID, ToolName: "admin_step", Action: "admin", Path: workingDir,
+			Description: "Run as root in " + workingDir + ": " + params.Description, Params: string(spec),
+		})
+		if err != nil {
+			return adminErrorResponse(err.Error()), nil
+		}
+		if !success {
+			return adminErrorResponse("Administrator action was denied, interrupted, or exited unsuccessfully. Inspect actual state before retrying; no rollback or automatic retry is implied."), nil
+		}
+		return fantasy.NewTextResponse("Administrator command exited with status 0. Authentication and command output were not captured. Verify the intended postcondition."), nil
+	})
+}
+
+func adminErrorResponse(text string) fantasy.ToolResponse {
+	response := fantasy.NewTextErrorResponse(text)
+	response.StopTurn = true
+	return response
+}
