+		require.NotContains(t, text, "Don't ask questions")
+		require.NotContains(t, text, "search first, don't ask")
+		require.NotContains(t, text, "Read entire file before editing")
+		require.NotContains(t, text, "Use Agent tool")
+		require.NotContains(t, text, "underspecified but not obviously dangerous")
+		require.NotContains(t, text, "For each error, attempt at least two or three")
+	}
+	require.NotContains(t, agentDispatchToolDescription, "use `agent` instead")
+}
+
+func TestTaskContextPreservesWorkerBoundaries(t *testing.T) {
+	parsed, err := template.New("task").Parse(string(taskPromptTmpl))
+	require.NoError(t, err)
+	for _, canWrite := range []bool{false, true} {
