+package common
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"io"
+	"sync"
+
+	"github.com/alecthomas/chroma/v2"
+	"github.com/alecthomas/chroma/v2/formatters"
+	"github.com/charmbracelet/crush/internal/ui/styles"
+	"github.com/charmbracelet/crush/internal/ui/xchroma"
+)
+
+var markdownFormatters sync.Map
+
+func markdownFormatter(sty *styles.Styles) string {
+	theme := chroma.MustNewStyle("crush-markdown", sty.ChromaTheme())
+	encoded, _ := json.Marshal(sty.Markdown.CodeBlock.Chroma)
+	name := fmt.Sprintf("crush-%x", sha256.Sum256(encoded))
+	if _, loaded := markdownFormatters.LoadOrStore(name, struct{}{}); !loaded {
+		formatters.Register(name, chroma.FormatterFunc(func(writer io.Writer, _ *chroma.Style, iterator chroma.Iterator) error {
+			return xchroma.Formatter(nil, nil).Format(writer, theme, iterator)
+		}))
+	}
+	return name
+}
diff --git a/internal/ui/model/admin.go b/internal/ui/model/admin.go
new file mode 100644
--- /dev/null
+++ b/internal/ui/model/admin.go
@@ -0,0 +1,87 @@
+package model
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+
+	tea "charm.land/bubbletea/v2"
+	"github.com/charmbracelet/crush/internal/agent/tools"
+	"github.com/charmbracelet/crush/internal/permission"
+	"github.com/charmbracelet/crush/internal/ui/util"
+	"github.com/google/uuid"
+)
+
+func (m *UI) runAdminInTerminal(perm permission.PermissionRequest) tea.Cmd {
+	if runtime.GOOS != "openbsd" || os.Getenv("SSH_CONNECTION") != "" || os.Getenv("SSH_TTY") != "" {
+		m.com.Workspace.PermissionDeny(perm)
+		return util.ReportError(fmt.Errorf("administrator terminal handoff requires a local OpenBSD session"))
+	}
+	if local, ok := m.com.Workspace.(interface{ LocalAdminAvailable() bool }); ok && !local.LocalAdminAvailable() {
+		m.com.Workspace.PermissionDeny(perm)
+		return util.ReportError(fmt.Errorf("administrator terminal handoff is unavailable over remote transports"))
+	}
+	var params tools.AdminParams
+	raw, ok := perm.Params.(string)
+	if !ok || json.Unmarshal([]byte(raw), &params) != nil || !filepath.IsAbs(params.Executable) || !filepath.IsAbs(perm.Path) {
+		m.com.Workspace.PermissionDeny(perm)
+		return util.ReportError(fmt.Errorf("invalid administrator execution specification"))
+	}
+	perm.Description = uuid.NewString()
+	if !m.com.Workspace.PermissionGrantPersistent(perm) {
+		return util.ReportWarn("Administrator action is no longer pending or was claimed by another terminal")
+	}
+	args := append([]string{"--", params.Executable}, params.Args...)
+	cmd := exec.Command("/usr/bin/doas", args...)
+	cmd.Dir = perm.Path
+	execution := &adminTerminalExecution{ExecCommand: &adminProcess{Cmd: cmd}}
+	return tea.Exec(execution, func(err error) tea.Msg {
+		return execution.receipt(err, func(success bool) bool {
+			if success {
+				return m.com.Workspace.PermissionGrant(perm)
+			}
+			return m.com.Workspace.PermissionDeny(perm)
+		})
+	})
+}
+
+type adminProcess struct{ *exec.Cmd }
+
+func (c *adminProcess) SetStdin(r io.Reader)  { c.Stdin = r }
+func (c *adminProcess) SetStdout(w io.Writer) { c.Stdout = w }
+func (c *adminProcess) SetStderr(w io.Writer) { c.Stderr = w }
+
+type adminTerminalExecution struct {
+	tea.ExecCommand
+	ran    bool
+	result error
+}
+
+func (c *adminTerminalExecution) Run() error {
+	c.ran = true
+	c.result = c.ExecCommand.Run()
+	return c.result
+}
+
+func (c *adminTerminalExecution) receipt(terminalErr error, settle func(bool) bool) tea.Msg {
+	if !c.ran {
+		settle(false)
+		return util.NewInfoMsg("Administrator command was not started; terminal handoff failed")
+	}
+	if c.result != nil {
+		settle(false)
+		return util.NewInfoMsg("Administrator command returned an error; inspect actual state before retrying")
+	}
+	accepted := settle(true)
+	if terminalErr != nil {
+		return util.NewInfoMsg("Administrator command exited 0, but terminal restoration failed; verify the intended postcondition")
+	}
+	if !accepted {
+		return util.NewInfoMsg("Administrator command exited 0, but its receipt was rejected; verify actual state")
+	}
+	return util.NewInfoMsg("Administrator command exited 0")
+}
diff --git a/internal/ui/model/admin_test.go b/internal/ui/model/admin_test.go
new file mode 100644
--- /dev/null
+++ b/internal/ui/model/admin_test.go
@@ -0,0 +1,104 @@
+package model
+
+import (
+	"context"
+	"errors"
+	"io"
+	"testing"
+	"time"
+
+	"github.com/charmbracelet/crush/internal/permission"
+	"github.com/stretchr/testify/require"
+)
+
+type fakeAdminCommand struct {
+	started chan struct{}
+	finish  chan struct{}
+	err     error
+}
+
+func (c *fakeAdminCommand) Run() error {
+	if c.started != nil {
+		close(c.started)
+	}
+	if c.finish != nil {
+		<-c.finish
+	}
+	return c.err
+}
+func (*fakeAdminCommand) SetStdin(io.Reader)  {}
+func (*fakeAdminCommand) SetStdout(io.Writer) {}
+func (*fakeAdminCommand) SetStderr(io.Writer) {}
+
+func TestAdminTerminalReceiptKnownOutcome(t *testing.T) {
+	for _, tc := range []struct {
+		name        string
+		run         bool
+		processErr  error
+		terminalErr error
+		success     bool
+	}{
+		{name: "release failure", terminalErr: errors.New("release")},
+		{name: "process failure", run: true, processErr: errors.New("exit"), terminalErr: errors.New("exit")},
+		{name: "restore failure after success", run: true, terminalErr: errors.New("restore"), success: true},
+		{name: "success", run: true, success: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			execution := &adminTerminalExecution{ExecCommand: &fakeAdminCommand{err: tc.processErr}}
+			if tc.run {
+				require.ErrorIs(t, execution.Run(), tc.processErr)
+			}
+			calls := 0
+			message := execution.receipt(tc.terminalErr, func(success bool) bool {
+				calls++
+				require.Equal(t, tc.success, success)
+				return true
+			})
+			require.NotNil(t, message)
+			require.Equal(t, 1, calls)
+		})
+	}
+}
+
+func TestAdminTerminalContinuesAcrossWaiterCancellation(t *testing.T) {
+	svc := permission.NewPermissionService(t.TempDir(), nil, nil)
+	requests := svc.Subscribe(t.Context())
+	ctx, cancel := context.WithCancel(t.Context())
+	done := make(chan error, 1)
+	go func() {
+		_, err := svc.Request(ctx, permission.CreatePermissionRequest{SessionID: "owner", ToolName: "admin_step", Action: "admin", Path: "/tmp"})
+		done <- err
+	}()
+	req := (<-requests).Payload
+	req.Description = "token"
+	require.True(t, svc.GrantPersistent(req))
+	fake := &fakeAdminCommand{started: make(chan struct{}), finish: make(chan struct{})}
+	execution := &adminTerminalExecution{ExecCommand: fake}
+	exited := make(chan error, 1)
+	go func() { exited <- execution.Run() }()
+	<-fake.started
+	cancel()
+	require.ErrorIs(t, <-done, context.Canceled)
+	select {
+	case <-exited:
+		t.Fatal("command stopped with waiter")
+	default:
+	}
+	_, err := svc.Request(t.Context(), permission.CreatePermissionRequest{SessionID: "owner", Action: "admin"})
+	var admin *permission.AdminError
+	require.ErrorAs(t, err, &admin)
+	require.Equal(t, permission.AdminBusy, admin.State)
+	close(fake.finish)
+	select {
+	case err := <-exited:
+		require.NoError(t, err)
+	case <-time.After(time.Second):
+		t.Fatal("command did not complete")
+	}
+	execution.receipt(errors.New("restore"), func(success bool) bool {
+		require.True(t, success)
+		require.True(t, svc.Grant(req))
+		return true
+	})
+	require.False(t, svc.Grant(req))
+}
