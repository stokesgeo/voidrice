+# Manual, foreground mutt-wizard sync. No profile evaluation or message scanning.
+set -f
+LC_ALL=C
+export LC_ALL
+fail() { printf '%s\n' "$1" >&2; exit 1; }
+MBSYNCRC=${MBSYNCRC:-$HOME/.mbsyncrc}
+[ -f "$MBSYNCRC" ] && [ -r "$MBSYNCRC" ] || fail 'mailsync: unreadable configuration'
+# Enumerate literal Channel names only. This is not a config evaluator or a
+# replacement for the native parser. Refuse every Group (including its Channel
+# parameters): native groups hide same-named channels. No includes/quoted keys.
+accounts=$(awk '
+    /^[[:space:]]*($|#)/ { next }
+    {
+        key=tolower($1)
+        if ($1 !~ /^[A-Za-z][A-Za-z0-9]*$/ || key == "include" || key == "group") bad=1
+        if (key == "channel") {
+            if (NF != 2 || $2 !~ /^[A-Za-z0-9][A-Za-z0-9_.@+-]*$/ || seen[$2]++) bad=1
+            else print $2
+        }
+    }
+    END { if (bad) exit 1 }
+' "$MBSYNCRC") || fail 'mailsync: unsupported channel configuration'
+[ -n "$accounts" ] || fail 'mailsync: no channels configured'
+# Validate the complete request before invoking any child. No options, groups,
+# wildcard patterns or mailbox suffixes are forwarded to mbsync.
+for account do
+    case "$account" in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.@+-]*) fail 'mailsync: invalid account';; esac
