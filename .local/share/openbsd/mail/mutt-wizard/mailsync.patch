+"
+    printf 'mailsync: %s: downloading new mail...\n' "$account" >&2
+    # Native PassCmd alone retrieves credentials. Classify its/native output in
+    # memory, never store or repeat arbitrary diagnostics (which may be secret).
+    # The final wrapper record overrides any earlier matching native text.
+    if reason=$({
+        mbsync -c "$MBSYNCRC" "$account" 2>&1
+        printf '\nMW_NATIVE_EXIT=%s\n' "$?"
+    } | awk '
+        BEGIN { result=1 }
+        /^MW_NATIVE_EXIT=[0-9]+$/ { split($0, a, "="); result=a[2]; next }
+        {
+            line=tolower($0)
+            if (line ~ /operation cancel|cancelled|canceled|no password|passcmd|pass command|gpg:.*(failed|decryption)/) unlock=1
+            if (line ~ /login.*(failed|error|rejected)|auth.*(failed|error|rejected)|authentication failed/) auth=1
+            if (line ~ /certificate|ssl error|tls.*(failed|error)/) tls=1
+            if (line ~ /cannot resolve|cannot connect|connection refused|timed out|network is unreachable|socket error/) network=1
+            if (line ~ /maildir error|disk full|no space left|permission denied|cannot write/) local=1
+            if (line ~ /unknown option|unknown keyword|unknown store|unknown channel|unrecognized option|syntax error/) config=1
+        }
+        END {
+            if (result == 0) { print "download completed"; exit 0 }
+            if (unlock) print "credential unlock failed/cancelled; unlock pass/GPG and retry mw -Y"
+            else if (auth) print "authentication rejected; check account login/credential with mw"
+            else if (tls) print "TLS verification/handshake failed; check hostname, trust and clock (do not disable verification)"
+            else if (network) print "connection failed; check server/network and retry mw -Y"
+            else if (local) print "local mail/config access failed; check Maildir paths, permissions and free space"
+            else if (config) print "native configuration unsupported; review mbsyncrc and installed isync version"
+            else print "native sync failed; inspect account configuration and retry (raw diagnostics withheld)"
+            exit 1
+        }
+    '); then
+        printf 'mailsync: %s: %s\n' "$account" "$reason" >&2
+    else
+        printf 'mailsync: %s: %s\n' "$account" "$reason" >&2
+        status=1
+    fi
