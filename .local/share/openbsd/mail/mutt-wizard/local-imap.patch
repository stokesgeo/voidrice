-	s) setact add || exit 1 ; smtp="$OPTARG" ;;
-	S) setact add || exit 1 ; sport="$OPTARG" ;;
+	s|S) mw_fail 'SMTP activation deferred'; exit 1 ;;
 	u) setact add || exit 1 ; login="$OPTARG" ;;
