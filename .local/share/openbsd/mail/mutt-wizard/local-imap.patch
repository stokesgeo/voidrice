+		[ "$mw_savedpolicy" = "$mw_archivepolicy" ] && mw_owned "$mw_credstage" &&
+		    [ "$(stat -f '%d:%i' "$mw_credstage")" = "$mw_stageid" ] &&
+		    [ "$(stat -f '%d' "$mw_credstage")" = "$(stat -f '%d' "$PASSWORD_STORE_DIR")" ] &&
+		    mw_owned "$mw_credstage/.gpg-id" &&
+		    [ "$(sha256 -q "$mw_credstage/.gpg-id")" = "$mw_savedhash" ] || return 1
+		if [ "$mw_savedsig" = absent ]; then [ ! -e "$mw_credstage/.gpg-id.sig" ] || return 1;
+		else mw_owned "$mw_credstage/.gpg-id.sig" &&
+		    [ "$(sha256 -q "$mw_credstage/.gpg-id.sig")" = "$mw_savedsig" ] || return 1; fi
+		mw_originals
+	else
+		case "$mw_operation" in add|edit) mw_stage_safe;; remove|default) :;; *) return 1;; esac
+	fi
+}
+mw_stage_safe() {
+	mw_path "$mw_credstage" && [ -d "$mw_credstage" ] &&
+	    [ "$(stat -f '%d:%i' "$mw_credstage")" = "$mw_stageid" ] &&
+	    [ "$(stat -f '%d' "$mw_credstage")" = "$(stat -f '%d' "$PASSWORD_STORE_DIR")" ] &&
+	    ! git -C "$mw_credstage" rev-parse --git-dir >/dev/null 2>&1 || {
+		mw_fail 'credential staging must be unchanged, same-filesystem, outside Git'; return 1;
+	}
+	mw_policy_unchanged || return 1
+	for mw_meta in .gpg-id .gpg-id.sig; do
+		mw_path "$mw_policy/$mw_meta" && mw_path "$mw_credstage/$mw_meta" || return 1
+		if [ -f "$mw_policy/$mw_meta" ]; then
+			cmp -s "$mw_policy/$mw_meta" "$mw_credstage/$mw_meta" || return 1
+		else [ ! -e "$mw_credstage/$mw_meta" ] || return 1; fi
+	done
+}
+mw_savecredential() {
+	mw_stage_safe || return 1
+	if [ -f "$PASSWORD_STORE_DIR/$mw_ref.gpg" ] && [ "$mw_stagehash" != - ] &&
+	    [ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_existing" ]; then
+		# New ciphertext has already passed verified TLS authentication. Keep the
+		# exact old encrypted inode before guarded same-filesystem replacement.
+		mw_record verified-staged || return 1
+		mw_oldcopy=$mw_credstage/previous.gpg
+		if [ ! -e "$mw_oldcopy" ]; then
+			ln -h "$PASSWORD_STORE_DIR/$mw_ref.gpg" "$mw_oldcopy" || return 1
+		fi
+		[ "$(mw_fingerprint "$mw_oldcopy")" = "$mw_existing" ] &&
+		    [ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_existing" ] || return 1
+		mw_newdir=$(mktemp -d "$mw_policy/.mw-replace.XXXXXXXX") || return 1
+		ln -h "$mw_credstage/$fulladdr.gpg" "$mw_newdir/new.gpg" || return 1
+		[ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_existing" ] &&
+		    mv "$mw_newdir/new.gpg" "$PASSWORD_STORE_DIR/$mw_ref.gpg" || return 1
+		rmdir "$mw_newdir" || return 1
+		mw_record credential-saved || return 1
+	fi
+	if [ -f "$PASSWORD_STORE_DIR/$mw_ref.gpg" ]; then
+		if [ "$mw_stagehash" = - ]; then
+			[ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_existing" ] || return 1
+		else
+			[ "$(sha256 -q "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_stagehash" ] &&
+			    [ "$(stat -f '%d:%i' "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$(stat -f '%d:%i' "$mw_credstage/$fulladdr.gpg")" ] || return 1
+		fi
+		mw_record credential-saved
+		return $?
+	fi
+	mw_stage_safe && [ "$(sha256 -q "$mw_credstage/$fulladdr.gpg")" = "$mw_stagehash" ] &&
+	    mw_record verified-staged || return 1
+	# Absent-only publication: unchanged native ciphertext, no Git operations.
+	ln -h "$mw_credstage/$fulladdr.gpg" "$PASSWORD_STORE_DIR/$mw_ref.gpg" || return 1
+	mw_record credential-saved || return 1
+	# Readback through ordinary native pass, even though insert's exit status alone
+	# does not reliably establish its own success.
+	unset MW_SECRET
+	MW_SECRET=$(pass show "$mw_ref" 2>/dev/null) && mw_secret_valid &&
+	    [ "$(sha256 -q "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_stagehash" ] &&
+	    [ "$(stat -f '%d:%i' "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$(stat -f '%d:%i' "$mw_credstage/$fulladdr.gpg")" ] || { unset MW_SECRET; return 1; }
+	unset MW_SECRET
+	printf '%s\n' 'mw: credential-saved; unlike usual pass insert, NOT Git staged/committed.' >&2
+}
+mw_writer() { ps -p "$1" -o uid=,pid=,lstart= | sed 's/^ *//; s/  */ /g; s/ *$//'; }
+mw_acquire() {
+	mw_path "$mw_lock" || return 1
+	# Prepare a complete identity before the single atomic link. SIGKILL before
+	# link leaves only an unclaimed private tempfile, never an empty public lock.
+	mw_locktmp=$(mktemp "${muttrc%/*}/.mw-writer.XXXXXXXX") || return 1
+	mw_writer "$$" > "$mw_locktmp" || return 1
+	while ! ln -h "$mw_locktmp" "$mw_lock" 2>/dev/null; do
+		mw_owned "$mw_lock" && [ -f "$mw_lock" ] || {
+			mw_fail 'active writer record is foreign or legacy; no lock removed'; rm "$mw_locktmp"; return 1;
+		}
+		mw_stalefp=$(mw_fingerprint "$mw_lock") || return 1
+		mw_owner=$(awk 'NR==1 && NF==7 {print $1}' "$mw_lock")
+		mw_pid=$(awk 'NR==1 && NF==7 {print $2}' "$mw_lock")
+		case "$mw_pid" in ''|*[!0-9]*) rm "$mw_locktmp"; return 1;; esac
+		[ "$mw_owner" = "$(id -u)" ] || { rm "$mw_locktmp"; return 1; }
+		if [ "$(mw_writer "$mw_pid")" = "$(awk '{print}' "$mw_lock")" ]; then
+			mw_fail 'another setup writer is active; retry after it exits'; rm "$mw_locktmp"; return 1
+		fi
+		[ "$(mw_fingerprint "$mw_lock")" = "$mw_stalefp" ] || continue
+		mv "$mw_lock" "${mw_lock}.recovered.$$" || return 1
+		mw_fail 'recovered stale writer (UID/PID/start identity checked); journal retained'
+	done
+	mw_lockid=$(mw_fingerprint "$mw_lock") || return 1
+	rm "$mw_locktmp"
+}
+mw_begin() {
+	for mw_f in "$muttrc" "$mbsyncrc" "$accdir" "$msmtprc" "$mpoprc" \
+	    "${muttrc%/*}/smtp-draft.txt" "$cachedir" "$maildir" \
+	    "$PASSWORD_STORE_DIR/$mw_ref.gpg" "$PASSWORD_STORE_DIR/.gpg-id"; do
+		mw_path "$mw_f" || { mw_fail "unsafe path: $mw_f"; return 1; }
+	done
+	# These small line-oriented merges support complete lines only. Refuse
+	# before any journal/credential work instead of normalizing foreign EOF.
+	for mw_f in "$muttrc" "$mbsyncrc" "${muttrc%/*}/smtp-draft.txt" "$accdir"/*.muttrc; do
+		[ -e "$mw_f" ] || [ -L "$mw_f" ] || continue
+		mw_path "$mw_f" && [ -f "$mw_f" ] || return 1
+		if [ -s "$mw_f" ] && [ "$(tail -c 1 "$mw_f" | od -An -tu1 | tr -d '[:space:]')" -ne 10 ]; then
+			mw_fail "unsupported missing final newline; nothing edited: $mw_f"; return 1
+		fi
+	done
+	mkdir -p "${muttrc%/*}" "$accdir" "${mbsyncrc%/*}" || return 1
+	mw_pending=${muttrc%/*}/.mw-pending
+	mw_path "$mw_pending" || return 1
+	mw_lock=${muttrc%/*}/.mw-active
+	mw_acquire || { mw_lock=; return 1; }
+	trap 'mw_cleanup $?' EXIT
+	trap 'exit 130' INT
+	trap 'exit 129' HUP
+	trap 'exit 143' TERM
+	if [ -f "$mw_pending/committed" ]; then
+		# Commit-marker/archive interruption: verify all four published identities,
+		# then archive atomically, even when the next requested account is B.
+		mw_requested=$fulladdr
+		fulladdr=$(awk 'NR==2 {print}' "$mw_pending/record")
+		mw_atom "$fulladdr" && [ "$(awk 'NR==7 {print}' "$mw_pending/record")" = "$PASSWORD_STORE_DIR" ] || return 1
+		for mw_key in muttrc mbsyncrc smtp-draft.txt account; do
+			mw_target_for "$mw_key" && [ -f "$mw_pending/published-$mw_key" ] &&
+			    [ "$(mw_fingerprint "$mw_dest")" = "$(awk '{print}' "$mw_pending/published-$mw_key")" ] || return 1
+		done
+		mw_committedop=$(awk 'NR==14 {print}' "$mw_pending/record")
+		if [ "$mw_committedop" = add ] || [ "$(head -n 1 "$mw_pending/record")" = mw-pending-v2 ]; then
+			mw_inbox || { mw_fail 'setup committed; INBOX initialization failed; not inbox-ready'; return 1; }
+		fi
+		mv "$mw_pending" "${mw_pending}.complete.$fulladdr.$$" || return 1
+		if [ "$fulladdr" = "$mw_requested" ] && [ "$mw_operation" = add ] && [ "$mw_committedop" = add ]; then
+			mw_pending=; mw_recovered=yes
+			mw_fail 'Recovered completed account setup; continuing with download and inbox.'
+			return 0
+		fi
+		fulladdr=$mw_requested
+	fi
+	if [ -d "$mw_pending" ]; then
+		mw_savedemail=$(awk 'NR==2 {print}' "$mw_pending/record")
+		mw_savedoperation=$(awk 'NR==1 && $0=="mw-pending-v2" {print "add"; exit} NR==14 {print}' "$mw_pending/record")
+		if [ "$mw_savedemail" != "$fulladdr" ] || [ "$mw_savedoperation" != "$mw_operation" ]; then
+			mw_atom "$mw_savedemail" || { mw_fail 'damaged pending identity'; return 1; }
+			printf 'Incomplete setup for %s (%s).\n' "$mw_savedemail" "$mw_savedoperation"
+			mw_prompt 'Choose [resume/leaveaside/cancel]:' mw_choice || return 1
+			case "$mw_choice" in resume|leaveaside) ;; *) return 1;; esac
+			mw_requestedemail=$fulladdr; mw_requestedop=$mw_operation
+			mw_requestedimap=$imap; mw_requestedport=$iport; mw_requestedlogin=$login; mw_requestedname=$realname
+			fulladdr=$mw_savedemail; mw_operation=$mw_savedoperation
+			case "$mw_operation" in add|edit) mw_select_policy || return 1;; remove|default) unset mw_ref mw_policy mw_policyhash mw_sighash;; *) return 1;; esac
+			if ! mw_load; then
+				[ "$mw_choice" = leaveaside ] && mw_load archive-policy || {
+					mw_fail 'pending policy/recovery conflict; choose leaveaside to retain old policy evidence, or cancel'; return 1;
+				}
+			fi
+			mw_rollback && mw_originals || { mw_fail 'pending snapshot conflict; evidence retained'; return 1; }
+			if [ "$mw_choice" = leaveaside ]; then
+				mv "$mw_pending" "${mw_pending}.aside.$fulladdr.$$" || return 1
+				fulladdr=$mw_requestedemail; mw_operation=$mw_requestedop
+				imap=$mw_requestedimap; iport=$mw_requestedport; login=$mw_requestedlogin; realname=$mw_requestedname
+				mw_existing=-; mw_stagehash=-; binding=
+				case "$mw_operation" in add|edit) mw_select_policy || return 1;; esac
+				# Reenter the ordinary initializer while retaining our active lock.
+				mw_pending=
+				[ "$(mw_fingerprint "$mw_lock")" = "$mw_lockid" ] && rm "$mw_lock" || return 1
+				mw_lock=
+				mw_begin; return $?
+			fi
+		fi
+		if ! mw_load; then
+			# Never resume under changed recipients. Archive only after the full
+			# record, staged policy and live configuration snapshots validate.
+			mw_load archive-policy || { mw_fail 'pending recovery conflict; evidence retained'; return 1; }
+			mw_prompt 'Recipient policy changed. Credential/data retained. [restart/leaveaside/cancel]' mw_choice || return 1
+			case "$mw_choice" in restart|leaveaside)
+				mw_originals && mv "$mw_pending" "${mw_pending}.policy.$fulladdr.$$" || return 1
+				mw_pending=; mw_armed=no
+				[ "$mw_choice" = restart ] || return 1
+				mw_select_policy || return 1
+				mw_existing=-; mw_stagehash=-
+				[ "$(mw_fingerprint "$mw_lock")" = "$mw_lockid" ] && rm "$mw_lock" || return 1
+				mw_lock=; mw_begin; return $?;;
+			*) return 1;; esac
+		fi
+		if [ -f "$mw_pending/committed" ]; then
+			mw_fail 'committed recovery evidence requires review; no rollback'; return 1
+		fi
+		mw_armed=yes
+		mw_rollback && mw_originals || { mw_fail 'snapshot conflict; evidence retained'; return 1; }
+		# Reconcile the hardlink/phase-update gap, never delete the credential.
+		if [ -f "$PASSWORD_STORE_DIR/$mw_ref.gpg" ] && [ "$mw_stagehash" != - ] &&
+		    [ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" != "$mw_existing" ]; then
+			[ "$(sha256 -q "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$mw_stagehash" ] &&
+			    [ "$(stat -f '%d:%i' "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$(stat -f '%d:%i' "$mw_credstage/$fulladdr.gpg")" ] || return 1
+			mw_record credential-saved || return 1
+		fi
+		printf 'Resuming unfinished setup for %s after recovery checks.\n' "$fulladdr"
+		printf '%s\n' 'An earlier setup stopped before finishing. Existing mail is safe.' 'resume (or Enter) = continue from saved progress; abandon = stop this attempt and keep existing mail/credentials.' >&2
+		mw_prompt 'Recovery checkpoint. [resume/abandon]' mw_choice || return 1
+		case "$mw_choice" in
+			''|resume) ;;
+			abandon) mw_originals && mv "$mw_pending" "${mw_pending}.abandoned.$fulladdr.$$" || return 1
+				mw_pending=; mw_armed=no; return 1;;
+			*) return 1;;
+		esac
+	else
+		if [ "$mw_operation" = add ]; then
+			[ ! -e "$accdir/$fulladdr.muttrc" ] || {
+				printf 'Account already configured: %s\nRead mail: neomutt\nDownload this inbox: mw -y %s\nChange its app password or settings: mw -e %s\n' "$fulladdr" "$fulladdr" "$fulladdr" >&2
+				return 1
+			}
+		else
+			[ -f "$accdir/$fulladdr.muttrc" ] || { mw_fail 'unknown managed account'; return 1; }
+		fi
+		if [ "$mw_operation" = edit ]; then
+			[ "$(mw_fingerprint "$accdir/$fulladdr.muttrc")" = "$mw_editaccountstate" ] &&
+			    [ "$(mw_fingerprint "$mbsyncrc")" = "$mw_editsyncstate" ] || return 1
+		fi
+		# Every existing account must have exactly one matching managed block in
+		# each shared config; never infer ownership from an address regex.
+		for mw_account in "$accdir"/*.muttrc; do
+			[ -e "$mw_account" ] || [ -L "$mw_account" ] || continue
+			mw_path "$mw_account" && [ -f "$mw_account" ] || return 1
+			mw_email=${mw_account##*/}; mw_email=${mw_email%.muttrc}
+			for mw_f in "$muttrc" "$mbsyncrc" "${muttrc%/*}/smtp-draft.txt"; do
+				[ -f "$mw_f" ] && awk -v e="$mw_email" '
+				$0=="# mw account begin " e {b++} $0=="# mw account end " e {n++}
+				END {exit b!=1 || n!=1}' "$mw_f" || { mw_fail 'legacy/ambiguous account requires review'; return 1; }
+			done
+		done
+		# Exact markers only. Legacy account definitions require manual review.
+		for mw_f in "$muttrc" "$mbsyncrc" "${muttrc%/*}/smtp-draft.txt"; do
+			if [ -f "$mw_f" ]; then
+				awk -v e="$fulladdr" -v op="$mw_operation" '
+				op=="add" && ($0=="# mw account begin " e || $0=="# mw account end " e) {bad=1}
+				/^# mw account begin / {if (inside) bad=1; inside=$0; sub(/begin /,"end ",inside); next}
+				/^# mw account end / {if ($0!=inside) bad=1; inside=""; next}
+				!inside && /^[[:space:]]*((IMAPStore|MaildirStore|Channel|source)[[:space:]]|macro[[:space:]].*switch to[[:space:]])/ {bad=1}
+				# Indirect/dynamic reader definitions cannot establish unclaimed keys
+				# by lexical inspection. Refuse rather than executing/adopting them.
+				!inside && !/^[[:space:]]*#/ && (/^[[:space:]]*(ifdef|ifndef|eval|push|exec|[a-z-]+-hook)[[:space:]]/ || index($0,";") || index($0,"`")) {bad=1}
+				END {exit bad || inside!=""}' "$mw_f" || { mw_fail 'ambiguous legacy/managed blocks'; return 1; }
+			fi
+		done
+		mw_reader_safe "$muttrc" || { mw_fail 'unsupported reader syntax; static whitelist only; nothing evaluated'; return 1; }
+		mw_managed || return 1
+		binding=; mw_n=1
+		if [ "$mw_operation" != add ]; then binding='i1<Enter>'; fi
+		while [ -z "$binding" ] && [ "$mw_n" -le 999 ]; do
+			# Reuse the static tokenizer; reserve numeric prefixes regardless of
+			# suffix, not just one spelling of Enter. No foreign bytes change.
+			if mw_reader_safe "$muttrc" "$mw_n"; then binding="i$mw_n<Enter>"; break; fi
+			mw_n=$((mw_n + 1))
+		done
+		[ -n "$binding" ] || { mw_fail 'no unclaimed selector; use explicit source account path'; return 1; }
+		# Initialize privately. The public pending name always denotes a ready
+		# record plus all snapshots, never a partially initialized transaction.
+		mw_ready=$mw_pending
+		mw_init=$(mktemp -d "${muttrc%/*}/.mw-init.XXXXXXXX") || return 1
+		mw_initid=$(stat -f '%d:%i' "$mw_init") || return 1
+		mw_pending=$mw_init
+		mw_credstage=-; mw_stageid=-; mw_stagehash=-
+		case "$mw_operation" in add|edit)
+			mw_credstage=$(mktemp -d "${PASSWORD_STORE_DIR%/*}/.mw-credential.XXXXXXXX") || return 1
+			mw_initcred=$mw_credstage
+			mw_stageid=$(stat -f '%d:%i' "$mw_credstage")
+			for mw_meta in .gpg-id .gpg-id.sig; do
+				mw_path "$mw_policy/$mw_meta" || return 1
+				[ ! -f "$mw_policy/$mw_meta" ] || cp "$mw_policy/$mw_meta" "$mw_credstage/$mw_meta" || return 1
+			done
+			mw_stage_safe || return 1;;
+		esac
+		printf '%s\n' mw-peers-v2 > "$mw_pending/peers" || return 1
+		for mw_file in "$accdir"/*.muttrc; do
+			[ -f "$mw_file" ] || continue
+			[ "$mw_file" != "$accdir/$fulladdr.muttrc" ] || continue
+			mw_peerstate=$(mw_fingerprint "$mw_file") || return 1
+			printf '%s\n%s\n' "$mw_file" "$mw_peerstate" >> "$mw_pending/peers" || return 1
+		done
+		mw_record collecting || return 1
+		for mw_key in muttrc mbsyncrc smtp-draft.txt account; do
+			mw_target_for "$mw_key" || return 1
+			mw_fingerprint "$mw_dest" > "$mw_pending/state-$mw_key" || return 1
+			if [ -f "$mw_dest" ]; then cp -p "$mw_dest" "$mw_pending/original-$mw_key";
+			else : > "$mw_pending/original-$mw_key"; fi || return 1
+		done
+		mw_originals && [ ! -e "$mw_ready" ] && [ ! -L "$mw_ready" ] || return 1
+		# The active lock serializes cooperating writers. Recheck the absent
+		# destination; never remove somebody else's pending directory.
+		mv "$mw_init" "$mw_ready" || return 1
+		mw_pending=$mw_ready
+		mw_init=; mw_initcred=
+	fi
+	mw_armed=yes
+	mw_originals
+}
+mw_peers_intact() {
+	# Older enrollment journals have no peer inventory. New journals guard every
+	# account source that native validation can read, not only the edited one.
+	[ -f "$mw_pending/peers" ] || return 0
+	if [ "$(head -n 1 "$mw_pending/peers")" = mw-peers-v2 ]; then
+		{
+			IFS= read -r mw_inventory
+			while IFS= read -r mw_peer; do
+				IFS= read -r mw_peerstate || return 1
+				mw_currentpeer=$(mw_fingerprint "$mw_peer") && [ "$mw_currentpeer" = "$mw_peerstate" ] || return 1
+			done
+		} < "$mw_pending/peers"
+	else
+		while IFS=' ' read -r mw_peer mw_peerstate; do
+			mw_currentpeer=$(mw_fingerprint "$mw_peer") && [ "$mw_currentpeer" = "$mw_peerstate" ] || return 1
+		done < "$mw_pending/peers"
+	fi
+}
+mw_originals() {
+	for mw_key in muttrc mbsyncrc smtp-draft.txt account; do
+		mw_target_for "$mw_key" || return 1
+		mw_now=$(mw_fingerprint "$mw_dest") || return 1
+		[ "$mw_now" = "$(awk '{print}' "$mw_pending/state-$mw_key")" ] || return 1
+	done
+	mw_peers_intact
+}
+mw_publish() {
+	mw_stage=$1; mw_target=$2
+	case "$mw_target" in
+		"$live_muttrc") mw_key=muttrc;; "$live_mbsyncrc") mw_key=mbsyncrc;;
+		"$live_draft") mw_key=smtp-draft.txt;; "$live_accdir/$fulladdr.muttrc") mw_key=account;; *) return 1;;
+	esac
+	mw_now=$(mw_fingerprint "$mw_target") &&
+	    [ "$mw_now" = "$(awk '{print}' "$mw_pending/state-$mw_key")" ] || return 1
+	mw_replace=$(mktemp "${mw_target%/*}/.mw-publish.XXXXXXXX") || return 1
+	cp "$mw_stage" "$mw_replace" && chmod 600 "$mw_replace" || return 1
+	mw_fingerprint "$mw_replace" > "$mw_pending/published-$mw_key-ready" &&
+	    mv "$mw_pending/published-$mw_key-ready" "$mw_pending/published-$mw_key" || return 1
+	# Recheck immediately before rename; POSIX rename has no compare-and-swap.
+	[ "$(mw_fingerprint "$mw_target")" = "$mw_now" ] && mv "$mw_replace" "$mw_target"
+}
+mw_intact() {
+	for mw_key in account mbsyncrc smtp-draft.txt muttrc; do
+		case "$mw_key" in account) mw_f=$live_accdir/$fulladdr.muttrc;; mbsyncrc) mw_f=$live_mbsyncrc;;
+		    smtp-draft.txt) mw_f=$live_draft;; muttrc) mw_f=$live_muttrc;; esac
+		if [ -f "$mw_pending/published-$mw_key" ]; then mw_state=$mw_pending/published-$mw_key;
+		else mw_state=$mw_pending/state-$mw_key; fi
+		[ "$(mw_fingerprint "$mw_f")" = "$(awk '{print}' "$mw_state")" ] || return 1
+	done
+	mw_peers_intact
+}
+mw_rollback() {
+	[ ! -f "$mw_pending/committed" ] || { mw_fail 'committed; rollback forbidden'; return 1; }
+	mw_conflict=no
+	for mw_key in muttrc smtp-draft.txt mbsyncrc account; do
+		[ -f "$mw_pending/published-$mw_key" ] || continue
+		mw_target_for "$mw_key" || return 1
+		mw_now=$(mw_fingerprint "$mw_dest") || { mw_conflict=yes; continue; }
+		if [ "$mw_now" = "$(awk '{print}' "$mw_pending/published-$mw_key")" ]; then
+			if [ "$mw_key" = account ] && [ -f "$mw_pending/removed-account" ]; then
+				mw_tomb=$(awk '{print}' "$mw_pending/removed-account")
+				mw_path "$mw_tomb" &&
+				    [ "$(mw_fingerprint "$mw_tomb")" = "$(awk '{print}' "$mw_pending/state-account")" ] &&
+				    ln "$mw_tomb" "$mw_dest" && rm "$mw_tomb" || return 1
+			elif [ "$(awk '{print}' "$mw_pending/state-$mw_key")" = absent ]; then
+				rm "$mw_dest" || return 1
+			else
+				mw_restore=$(mktemp "${mw_dest%/*}/.mw-restore.XXXXXXXX") || return 1
+				cp -p "$mw_pending/original-$mw_key" "$mw_restore" && mv "$mw_restore" "$mw_dest" || return 1
+			fi
+			mw_fingerprint "$mw_dest" > "$mw_pending/state-$mw_key-ready" &&
+			    mv "$mw_pending/state-$mw_key-ready" "$mw_pending/state-$mw_key" || return 1
+		elif [ "$mw_now" != "$(awk '{print}' "$mw_pending/state-$mw_key")" ]; then
+			mw_conflict=yes; continue
+		fi
+		mv "$mw_pending/published-$mw_key" "$mw_pending/restored-$mw_key" || return 1
+	done
+	[ "$mw_conflict" = no ]
+}
+mw_cleanup() {
+	mw_rc=$1
+	[ "${mw_echo_off:-no}" != yes ] || stty "$mw_tty_state" <&3
+	unset MW_SECRET mw_escaped info
+	if [ -n "$mw_pending" ] && [ -f "$mw_pending/committed" ]; then
+		mw_fail 'committed; housekeeping/INBOX initialization may be pending; next invocation rechecks; no rollback'
+	fi
+	if [ "$mw_armed" = yes ] && [ -n "$mw_pending" ] && [ ! -f "$mw_pending/committed" ]; then
+		# Generator variables may still name staging paths.
+		[ -z "$live_muttrc" ] || { muttrc=$live_muttrc; accdir=$live_accdir; mbsyncrc=$live_mbsyncrc; }
+		mw_rollback || mw_fail 'configuration conflict; evidence retained'
+		mw_checkpoint=no
+		case "$mw_phase" in verified-staged|credential-saved|config-pending|complete)
+			if [ "$mw_stagehash" = - ]; then
+				[ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" != "$mw_existing" ] || mw_checkpoint=yes
+			elif [ -f "$PASSWORD_STORE_DIR/$mw_ref.gpg" ] &&
+			    [ "$(mw_fingerprint "$PASSWORD_STORE_DIR/$mw_ref.gpg")" = "$(mw_fingerprint "$mw_credstage/$fulladdr.gpg")" ]; then mw_checkpoint=yes; fi;;
+		esac
+		if [ "$mw_checkpoint" = yes ]; then mw_fail "credential-saved; setup unfinished: $mw_pending";
+		else mw_fail "setup unfinished; staged/recovery evidence retained: $mw_pending"; fi
+	fi
+	# Delete only our unpublished allocation, qualified by its identity. A
+	# signal after rename leaves the ready public journal for ordinary resume.
+	if [ -n "$mw_init" ] && [ -d "$mw_init" ] && [ ! -L "$mw_init" ] &&
+	    [ "$(stat -f '%d:%i' "$mw_init")" = "$mw_initid" ]; then
+		rm -rf "$mw_init"
+		if [ -n "$mw_initcred" ] && [ -d "$mw_initcred" ] && [ ! -L "$mw_initcred" ] &&
+		    [ "$(stat -f '%d:%i' "$mw_initcred")" = "$mw_stageid" ]; then rm -rf "$mw_initcred"; fi
+	fi
+	if [ -n "$mw_lock" ] && [ "$(mw_fingerprint "$mw_lock")" = "$mw_lockid" ]; then rm -f "$mw_lock"; fi
+	trap - EXIT
+	exit "$mw_rc"
+}
+# Supported reader boundary, intentionally not a general NeoMutt parser:
+# static set/unset/alias/macro/bind only; source only for the exact managed
+# account default. No expansion, continuation, command separator, hooks or
+# conditionals. Unknown grammar is refused BEFORE any native parser probe.
+# Foreign static bytes are never rewritten. Quotes contain literal bytes only.
+mw_reader_safe() {
+	mw_scan=$1; mw_selector=${2:-}
+	[ -f "$mw_scan" ] || return 0
+	set -- "$mw_scan"
+	# Check account sources too, not merely the top-level source statement.
+	for mw_dir in "$accdir" "${live_accdir:-$accdir}"; do
+		for mw_file in "$mw_dir"/*.muttrc; do
+			[ -e "$mw_file" ] || [ -L "$mw_file" ] || continue
+			mw_path "$mw_file" && [ -f "$mw_file" ] || return 1
+			set -- "$@" "$mw_file"
+		done
+	done
+	awk -v reader="$mw_scan" -v selector="$mw_selector" -v a="$accdir" -v l="${live_accdir:-$accdir}" '
+	BEGIN {for(arg=1;arg<ARGC;arg++) if(ARGV[arg]!=reader) allowed[ARGV[arg]]=1}
+	function fail() {bad=1}
+	function tokens(s,    i,c,q,v,started) {
+		n=0; q=""; v=""; started=0
+		for(i=1;i<=length(s);i++) {
+			c=substr(s,i,1)
+			if(q!="") {
+				if(c=="\\" && q=="\042") {
+					c=substr(s,++i,1); if(c !~ /[\\\\\042$`]/) return 0; v=v c
+				} else if(c==q) q="";
+				else {if(q=="\042" && (c=="$" || c=="`")) return 0; v=v c}
+				continue
+			}
+			if(c=="\042" || c=="\047") {if(started) return 0; q=c; started=1; continue}
+			if(c ~ /[[:space:]]/ || c=="=") {
+				if(started) {t[++n]=v; v=""; started=0}
+				if(c=="=") t[++n]="="
+				continue
+			}
+			if(c=="#" && !started) break
+			if(c !~ /[a-zA-Z0-9_@.,\/+!<>:-]/) return 0
+			v=v c; started=1
+		}
+		if(q!="") return 0
+		if(started) t[++n]=v
+		return 1
+	}
+	FNR==1 {inside=""; prefix=0}
+	/^# mw shared selector prefix$/ {prefix=FNR; next}
+	/^bind index,pager i noop$/ {if(FILENAME==reader && prefix>0 && FNR==prefix+1) next}
+	/^# mw account begin / {inside=$5; next}
+	/^# mw account end / {inside=""; next}
+	/^[[:space:]]*(#|$)/ {next}
+	{
+		# Expansion is forbidden even inside quotes; never probe executable input.
+		if(!tokens($0)) {fail(); next}
+		if(!n) next
+		if(t[1]=="set") {
+			if(t[2] !~ /^[a-zA-Z_][a-zA-Z0-9_]*$/ || !(n==2 || (n==4 && t[3]=="="))) fail()
+		} else if(t[1]=="unset") {
+			if(n<2) fail()
+			for(j=2;j<=n;j++) if(t[j] !~ /^[a-zA-Z_][a-zA-Z0-9_]*$/) fail()
+		} else if(t[1]=="auto_view") {
+			if(n!=2 || t[2]!="text/html") fail()
+		} else if(t[1]=="alternative_order") {
+			if(n!=3 || t[2]!="text/plain" || t[3]!="text/html") fail()
+		} else if(t[1]=="macro" || t[1]=="bind") {
+			if(t[2] !~ /^[a-z-]+(,[a-z-]+)*$/ || t[3]=="") fail()
+			# Narrow key grammar: printable ASCII plus Enter/Return/CR tokens
+			# (ASCII case insensitive), and quoted ^J/^M. No native escapes,
+			# unknown angle tokens, key lists or other caret decoding.
+			k=t[3]; gsub(/\^J|\^M/,"<enter>",k)
+			while(match(k,/<[^<>]*>/)) {
+				key=tolower(substr(k,RSTART,RLENGTH))
+				if(key!="<enter>" && key!="<return>" && key!="<cr>") fail()
+				k=substr(k,1,RSTART-1) "!" substr(k,RSTART+RLENGTH)
+			}
+			if(k !~ /^[!-~]+$/ || k ~ /[<>^,\047\042]/) fail()
+			# Generic falls back into index/pager too. Match whole menu names,
+			# using tokenized fields regardless of outer quotes/whitespace.
+			if(selector!="" && ("," t[2] ",") ~ /,(index|pager|generic),/) {
+				k=t[3]
+				if(k=="i") claimed=1
+				if(match(k,/^i[0-9]+/)) {
+					key=substr(k,2,RLENGTH-1)
+					if("x" key=="x" selector ||
+					    (RLENGTH==length(k) && index(selector,key)==1)) claimed=1
+				}
+			}
+			if(t[1]=="macro" && n!=4 && n!=5) fail()
+			if(t[1]=="bind" && n!=4) fail()
+		} else if(t[1]=="mailboxes") {
+			# Literal absolute Maildir paths only, not commands or expansions.
+			if(n<2) fail()
+			for(j=2;j<=n;j++) if(t[j] !~ /^\// || t[j] ~ /(^|\/)\.\.?($|\/)/) fail()
+		} else if(t[1]=="alias") {if(n<3) fail()
+		} else if(t[1]=="source") {
+			if(FILENAME!=reader || inside=="" || n!=2 ||
+			    (!allowed[t[2]] && !(t[2]==l "/" inside ".muttrc" && allowed[a "/" inside ".muttrc"])) ||
+			    (t[2]!=a "/" inside ".muttrc" && t[2]!=l "/" inside ".muttrc")) fail()
+		} else fail()
+	}
+	END {exit bad || claimed}' "$@"
+}
+mw_transport() {
+	# Seed inherited state, then evaluate the ACTUAL merged reader in order.
+	# Check all disabling values, not merely parser success or false sendmail.
+	# Canonical mailboxes cannot parse before postcommit Maildir creation.
+	# Project only those exact registrations to a synthetic parser Maildir;
+	# keep all settings (especially transport) and source order unchanged.
+	mkdir -p "$mw_pending/parser-mail/INBOX/cur" "$mw_pending/parser-mail/INBOX/new" \
+	    "$mw_pending/parser-mail/INBOX/tmp" "$mw_pending/parser-accounts/stage" \
+	    "$mw_pending/parser-accounts/live" || return 1
+	: > "$mw_pending/parser-sources"
+	for mw_dir in "$accdir" "${live_accdir:-$accdir}"; do
+		mw_side=live; [ "$mw_dir" != "$accdir" ] || mw_side=stage
+		for mw_file in "$mw_dir"/*.muttrc; do
+			[ -f "$mw_file" ] || continue
+			mw_email=${mw_file##*/}; mw_email=${mw_email%.muttrc}
+			mw_copy="$mw_pending/parser-accounts/$mw_side/$mw_email.muttrc"
+			awk -v old="mailboxes \"$maildir/$mw_email/INBOX\"" \
+			    -v new="mailboxes \"$mw_pending/parser-mail/INBOX\"" \
+			    '{if($0==old) print new; else print}' "$mw_file" > "$mw_copy" || return 1
+			printf '%s\n%s\n' "$mw_file" "$mw_copy" >> "$mw_pending/parser-sources"
+		done
+	done
+	mw_probe_source=$1
+	if [ "${2:-}" = account ]; then
+		mw_side=live; [ "${1%/*}" != "$accdir" ] || mw_side=stage
+		mw_probe_source="$mw_pending/parser-accounts/$mw_side/${1##*/}"
+	else
+		awk 'FILENAME==ARGV[1] {old=$0; getline new; m["source \"" old "\""]="source \"" new "\""; next}
+		    {if($0 in m) print m[$0]; else print}' "$mw_pending/parser-sources" "$1" \
+		    > "$mw_pending/parser-reader" || return 1
+		mw_probe_source=$mw_pending/parser-reader
+	fi
+	printf '%s\n' 'set smtp_url="smtps://inherited.invalid"' 'set smtp_pass="inherited"' \
+	    'set smtp_oauth_refresh_command="/usr/bin/false"' "source \"$mw_probe_source\"" \
+	    > "$mw_pending/effective.muttrc" || return 1
+	# NeoMutt -Q can exit zero after source parse errors. Account probes
+	# must also be diagnostic-free; reader binding warnings remain separate.
+	if [ "${2:-}" = account ]; then
+		mw_effective=$(neomutt -F "$mw_pending/effective.muttrc" -Q smtp_url -Q smtp_pass \
+		    -Q smtp_oauth_refresh_command -Q sendmail </dev/null 2>"$mw_pending/account-diagnostics") || return 1
+		if [ -s "$mw_pending/account-diagnostics" ]; then
+			mw_fail 'native account parser diagnostics; refusing publication'
+			cat "$mw_pending/account-diagnostics" >&2; return 1
+		fi
+	else
+		mw_effective=$(neomutt -F "$mw_pending/effective.muttrc" -Q smtp_url -Q smtp_pass \
+		    -Q smtp_oauth_refresh_command -Q sendmail </dev/null) || return 1
+	fi
+	[ "$mw_effective" = 'set smtp_url = ""
+set smtp_pass = ""
+set smtp_oauth_refresh_command = ""
+set sendmail = "/usr/bin/false"' ] || { mw_fail 'effective reader transport conflict; foreign settings preserved'; return 1; }
+}
+mw_validate() {
+	mw_reader_safe "$muttrc" || return 1
+	# Lexical safety is not native validity. Probe EVERY surviving source,
+	# including nondefault untouched peers, with inherited SMTP seeded. The
+	# target comes from staging; removed targets must not be sourced at all.
+	for mw_peer in "$live_accdir"/*.muttrc; do
+		[ -f "$mw_peer" ] || continue
+		[ "$mw_peer" != "$live_accdir/$fulladdr.muttrc" ] || continue
+		mw_transport "$mw_peer" account || return 1
+	done
+	if [ "$mw_operation" != remove ]; then
+		mw_transport "$accdir/$fulladdr.muttrc" account || return 1
+	fi
+	# Replace only the staged Maildir path in a parser-only copy. Select LOCAL
+	# store, never IMAP: no network, PassCmd, sync or owner Maildir side effect.
+	mkdir -p "$mw_pending/parser-mail/INBOX/cur" "$mw_pending/parser-mail/INBOX/new" \
+	    "$mw_pending/parser-mail/INBOX/tmp" || return 1
+	awk -v p="$mw_pending/parser-mail/" '
+	    /^Path / {print "Path \"" p "\""; next}
+	    /^Inbox / {print "Inbox \"" p "INBOX\""; next} {print}
+	' "$mbsyncrc" > "$mw_pending/parser.mbsync" || return 1
+	# Parse whole merged reader, pointing the new default source at staging.
+	awk -v old="source \"$live_accdir/$fulladdr.muttrc\"" -v new="source \"$accdir/$fulladdr.muttrc\"" \
+	    '{if ($0==old) print new; else print}' "$muttrc" > "$mw_pending/merged.muttrc" || return 1
+	mw_reader_safe "$mw_pending/merged.muttrc" &&
+	mw_transport "$mw_pending/merged.muttrc" || return 1
+	# Probe a surviving local store/draft only. Last removal has no accounts.
+	mw_probe=$fulladdr
+	if [ "$mw_operation" = remove ]; then mw_probe=$mw_next; fi
+	if [ -n "$mw_probe" ]; then
+		mbsync -c "$mw_pending/parser.mbsync" --list-stores "$mw_probe-local" </dev/null >/dev/null &&
+		msmtp --file="$msmtprc" --account="$mw_probe" --pretend recipient@example.invalid </dev/null >/dev/null
+	else
+		# Native parsers still see the complete empty/foreign merged files;
+		# only parser copies gain a disposable, local-only probe account.
+		printf '\nMaildirStore mw-empty-probe\nPath "%s/parser-mail/"\nInbox "%s/parser-mail/INBOX"\n' \
+		    "$mw_pending" "$mw_pending" >> "$mw_pending/parser.mbsync" || return 1
+		cp "$msmtprc" "$mw_pending/parser.msmtp" &&
+		printf '\naccount mw-empty-probe\nhost smtp.invalid\nauth off\n' >> "$mw_pending/parser.msmtp" &&
+		mbsync -c "$mw_pending/parser.mbsync" --list-stores mw-empty-probe </dev/null >/dev/null &&
+		msmtp --file="$mw_pending/parser.msmtp" --account=mw-empty-probe --pretend recipient@example.invalid </dev/null >/dev/null
+	fi
+}
