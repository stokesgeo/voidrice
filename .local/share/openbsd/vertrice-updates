#!/bin/ksh

# vertrice-updates: count what is waiting to be updated, for the status bar.
# Runs as root from root's crontab (vertrice-install's system stage adds the
# line and installs this file as /usr/local/sbin/vertrice-updates). It only
# looks; it installs nothing. It writes one world-readable file, which the
# user's sb-updates block reads. Root never touches the X session.
#
# The file, $out, is key=value lines:
#	base=N		base errata waiting (syspatch -c); "snapshot" on a
#			snapshot (-current or -beta), where syspatch does not
#			run and the update is sysupgrade -s
#	packages=N	packages pkg_add -u would update
#	checked=DATE	when this ran
# A count that could not be taken (no network, a mirror error) is "?".
#
# Voidrice's cron/checkup did this as the user with sudo pacman -Syuw and
# notify-send. Here root counts and the user side shows; nothing is
# downloaded ahead of time.

# Every tool here is base; root's crontab sets PATH to the base
# directories, and doas gives root's default PATH.
out=${VERTRICE_UPDATES:-/var/db/vertrice-updates}

[ "$(id -u)" = 0 ] || { print -u2 "vertrice-updates: run as root"; exit 1; }

# The release suffix, as syspatch reads it (usr.sbin/syspatch/syspatch.sh):
# "OpenBSD 7.8 (GENERIC.MP)" has none; "OpenBSD 7.8-current (...)" has
# "-current". syspatch runs only on a release.
suffix=$(sysctl -n kern.version |
	sed -n '1s/^OpenBSD [1-9][0-9]*\.[0-9]\([^ ]*\).*/\1/p')

if [ -n "$suffix" ]; then
	base=snapshot
elif patches=$(syspatch -c 2>/dev/null); then
	# syspatch -c prints one missing patch per line, nothing when none.
	base=$(print -r -- "$patches" | grep -c .)
else
	base='?'
fi

# pkg_add -u -n -v: pretend, and name each update set "old->new" (read in
# pkg_add's OpenBSD/UpdateSet.pm print and PkgAdd.pm tweak_header; not yet
# run on the machine). Count the distinct "->" names.
if list=$(pkg_add -u -n -v 2>/dev/null); then
	packages=$(print -r -- "$list" |
		awk '{ for (i = 1; i <= NF; i++) if ($i ~ /->/) print $i }' |
		sort -u | grep -c .)
else
	packages='?'
fi

# Written beside the file and renamed over it, so the bar never reads a
# half-written file.
tmp=$(mktemp "$out.XXXXXXXXXX") || exit 1
if ! {
	print "base=$base"
	print "packages=$packages"
	print "checked=$(date '+%Y-%m-%d %H:%M')"
} >"$tmp" || ! chmod 0644 "$tmp" || ! mv -f "$tmp" "$out"; then
	rm -f "$tmp"
	exit 1
fi
