# The staff login class (login.conf(5)) with room for a browser: more memory,
# open files and processes. tc=default stays last: it supplies the rest.
staff:\
	:datasize-cur=4096M:\
	:datasize-max=infinity:\
	:openfiles-cur=4096:\
	:openfiles-max=8192:\
	:maxproc-max=512:\
	:maxproc-cur=256:\
	:ignorenologin:\
	:requirehome@:\
	:tc=default:
