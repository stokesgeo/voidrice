#!/bin/ksh

# check: test, on the OpenBSD machine itself, every assumption the port made
# that could not be tested off the machine. Prints one PASS/FAIL/SKIP line
# per assumption and exits nonzero if anything failed. Changes nothing:
# the one write, a brightness step of +0, leaves the value as it was.
#
# Run as the desktop user, inside the X session for the X items:
#	~/.local/share/openbsd/check

fails=0
pass() { print "PASS  $1"; }
fail() { print "FAIL  $1${2:+  -- $2}"; fails=$((fails + 1)); }
skip() { print "SKIP  $1${2:+  -- $2}"; }
try() {	# try "label" command ...: PASS if the command succeeds
	typeset label=$1; shift
	if "$@" >/dev/null 2>&1; then pass "$label"; else fail "$label"; fi
}
num() { [[ $1 == +([0-9]) ]]; }

print "== system facts the port relies on"
kill -l | grep -q RTMIN && fail "no real-time signals (sbar design assumes none)" "RTMIN exists" ||
	pass "no real-time signals, so sbar/sb-refresh is needed"
try "no setsid(1), so detach is needed" eval '! command -v setsid'
try "pgrep -f and pgrep -xn accepted (sb-music, sysact)" eval 'pgrep -f "nonexis[t]ent-xyz"; [ $? -eq 1 ] && { pgrep -xn nonexistent-xyz; [ $? -eq 1 ]; }'
try "mktemp -d" eval 'd=$(mktemp -d) && rmdir "$d"'
try "rm -P (otp wipes its temp file with it)" eval 'f=$(mktemp) && rm -P "$f"'
try "sort -R (setbg shuffle)" eval 'printf "a\nb\n" | sort -R'
try "stat -f %Sm -t (block cache dates)" eval 'stat -f %Sm -t %Y-%m-%d /etc/passwd'
try "stat -f %m (doppler age)" eval 'num $(stat -f %m /etc/passwd)'
try "md5 on stdin prints only the digest (lf cache key)" eval '[[ $(echo x | md5) == +([0-9a-f]) ]]'
try "file -bi gives a MIME type" eval '[[ $(file -bi /etc/passwd) == text/* ]]'
try "awk [[:space:]] classes (shortcuts)" eval 'echo "a  #c" | awk "{gsub(\"[[:space:]]*#.*\$\",\"\"); exit \$0 != \"a\"}"'
try "sed BSD word bounds [[:<:]] (sb-clock)" eval '[ "$(echo "a 5 55" | sed "s/[[:<:]]5[[:>:]]/X/")" = "a X 55" ]'
try "route -n get default (network-up test)" route -n get default

print "== status block sources"
v=$(apm -l 2>/dev/null); num "$v" && pass "apm -l percent ($v)" || fail "apm -l percent" "$v"
v=$(apm -a 2>/dev/null); num "$v" && pass "apm -a AC state ($v)" || fail "apm -a AC state" "$v"
v=$(apm -b 2>/dev/null); num "$v" && pass "apm -b battery state ($v)" || fail "apm -b battery state" "$v"
v=$(wsconsctl -n display.brightness 2>&1) && pass "wsconsctl reads brightness ($v)" ||
	fail "wsconsctl reads brightness" "$v (log in on the console so fbtab gives you ttyC0)"
try "wsconsctl += syntax (battery-block scroll)" wsconsctl display.brightness+=0
v=$(sysctl -n hw.sensors.cpu0.temp0 2>/dev/null || sysctl -n hw.sensors.acpitz0.temp0 2>/dev/null)
[ -n "$v" ] && pass "CPU temperature sensor ($v)" || fail "CPU temperature sensor" "neither cpu0.temp0 nor acpitz0.temp0"
v=$(sysctl -n kern.cp_time2.0 2>/dev/null)
[ "$(print "$v" | awk -F, '{print NF}')" = 6 ] && pass "kern.cp_time2.0 has 6 fields" || fail "kern.cp_time2.0 has 6 fields" "$v"
v=$(sndioctl -n output.level 2>&1) && pass "sndioctl output.level ($v)" || fail "sndioctl output.level" "$v"
v=$(sndioctl -n output.mute 2>&1) && pass "sndioctl output.mute ($v)" || fail "sndioctl output.mute" "$v"
try "top -b prints a Memory: Real line" eval 'top -b -d 1 | grep -q "^Memory: Real"'
try "netstat -ibn has <Link> rows" eval 'netstat -ibn | grep -q "<Link>"'
ifconfig wlan >/dev/null 2>&1 && pass "a wireless interface exists (wlan group)" ||
	skip "a wireless interface exists (wlan group)" "no Wi-Fi card attached"

print "== daemons and tools"
try "sndiod is running" pgrep -x sndiod
try "apmd is running (zzz/ZZZ need it)" pgrep -x apmd
try "apmd runs without -A/-L/-H (obsdfreqd owns CPU speed)" eval '! pgrep -lf "apmd.* -[ALH]"'
try "obsdfreqd is running" pgrep -x obsdfreqd
try "obsdfreqd has AC,battery flags" eval 'rcctl get obsdfreqd flags | grep -q ,'
try "IBM Plex Mono is the monospace font" eval 'fc-match monospace | grep -q "IBM Plex Mono"'
try "theme palettes present" eval '[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/x11/themes/day" ] && [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/x11/themes/night" ]'
try "ntpd is running (otp time)" pgrep -x ntpd
try "hotplugd is running (USB notices)" pgrep -x hotplugd
try "/etc/hotplug/attach is installed" test -x /etc/hotplug/attach
try "xidle is installed (idle lock)" command -v xidle
try "openrsync is installed (rsync alias)" command -v openrsync
try "xlock is installed (sysact lock)" command -v xlock
try "cwm accepts ~/.config/cwm/cwmrc" cwm -n -c "${XDG_CONFIG_HOME:-$HOME/.config}/cwm/cwmrc"
try "xterm is installed (default TERMINAL)" command -v xterm
try "NEXINIT points at the vi exrc" eval '[ -r "${NEXINIT#source }" ]'
try "ext, mounter, unmounter are on PATH" eval 'command -v ext && command -v mounter && command -v unmounter'
[ -f /etc/doas.conf ] && pass "/etc/doas.conf exists" || fail "/etc/doas.conf exists" "see OPENBSD.md"
[ "$(sysctl -n kern.audio.record)" = 1 ] && pass "kern.audio.record=1" ||
	skip "kern.audio.record=0" "dmenurecord audio records silence until it is 1"

print "== packages"
list=${0%/*}/pkglist
if [ -r "$list" ]; then
	while read -r p; do
		pkg_info -qe "$p-*" && pass "package $p" || fail "package $p" "not installed, or the name differs in ports"
	done <"$list"
else
	skip "packages" "no pkglist beside this script"
fi

print "== blocks (each should print something)"
if [ -n "$DISPLAY" ]; then
	for b in sb-battery sb-brightness sb-cpu sb-cpubars sb-internet sb-memory sb-nettraf sb-volume sb-clock sb-disk; do
		v=$("$b" 2>&1) && [ -n "$v" ] && pass "$b: $v" || fail "$b" "$v"
	done
	try "sbar is on PATH" command -v sbar
else
	skip "blocks" "run inside the X session"
fi

print "== $fails failed"
[ "$fails" -eq 0 ]
