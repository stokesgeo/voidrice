#!/bin/sh

# hotplug-attach: install as /etc/hotplug/attach (root, mode 0755) and
# enable hotplugd(8): rcctl enable hotplugd && rcctl start hotplugd.
# hotplugd runs it as root with the device class and name, e.g. "2 sd1".
#
# Root does one thing here: it writes the name of a newly attached disk to
# a file anyone may read. It does not touch the user's X session or D-Bus;
# the user's own hotplug-watch sees the file change and sends the
# notification. Nothing is mounted automatically: mounting stays a choice
# (Super+F9).

DEVCLASS=$1
DEVNAME=$2

case $DEVCLASS in
2)	# disk
	echo "$DEVNAME" > /var/run/hotplug-disk
	chmod 644 /var/run/hotplug-disk
	;;
esac
