+// Qualified compatibility envelope, not an updater or a generation-name allowlist.
+import { readFileSync, realpathSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { createRequire } from "node:module";
+import { join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const source = fileURLToPath(new URL("../../", import.meta.url));
+export const compatibility = JSON.parse(readFileSync(new URL("./compatibility.json", import.meta.url), "utf8"));
+const json = path => JSON.parse(readFileSync(path, "utf8"));
+const hash = path => createHash("sha256").update(readFileSync(path)).digest("hex");
+const require = createRequire(import.meta.url);
+
+// Fixture contracts are explicit arguments to this isolated helper only. The CLI
+// below always uses the installed, stored baseline; no environment override.
+export function assertCompatibility(home, { hostPackage, hostEntry, contract = compatibility } = {}) {
