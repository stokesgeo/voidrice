+import assert from "node:assert/strict";
+import test, { after } from "node:test";
+import { mkdtempSync, mkdirSync, readFileSync, writeFileSync, symlinkSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import ts from "typescript";
+
+// Exercise the real TS components without starting sockets or an interactive editor.
+const dir = mkdtempSync(join(tmpdir(), "board-ui-test-"));
+mkdirSync(join(dir, "ui"));
+writeFileSync(join(dir, "package.json"), '{"type":"module"}');
+for (const [name, target] of [["core", "src/core"], ["node_modules", "node_modules"]]) symlinkSync(resolve(target), join(dir, name));
+symlinkSync(resolve("src/ui/dashboard-evidence.mjs"), join(dir, "ui/dashboard-evidence.mjs"));
+for (const name of ["dashboard", "pty-attach"]) {
+ const source = readFileSync(`src/ui/${name}.ts`, "utf8");
+ writeFileSync(join(dir, `ui/${name}.mjs`), ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2022 } }).outputText);
+}
+const { DashboardComponent } = await import(pathToFileURL(join(dir, "ui/dashboard.mjs")));
+const { PtyAttachComponent } = await import(pathToFileURL(join(dir, "ui/pty-attach.mjs")));
+after(() => rmSync(dir, { recursive: true, force: true }));
+const theme = { fg: (_c, s) => s, bold: s => s };
+function board() {
+ return Object.assign(Object.create(DashboardComponent.prototype), {
+  theme, focusGeneration: 0, tui: { terminal: { rows: 18 }, requestRender() {} }, helpScrollTop: 0, helpMaxScroll: 0, helpReturnMode: "list", mode: "help",
+ });
+}
+
+test("reserved detach never inspects or forwards child draft/dialog; Left is conditional", () => {
+ for (const empty of [true, false]) {
+  const calls = [];
+  const c = Object.assign(Object.create(PtyAttachComponent.prototype), {
+   detach: () => calls.push("detach"), childInputLooksEmpty: () => { calls.push("inspect"); return empty; },
+   clearPendingClick() {}, clearSelection() {}, scrollToBottom() {}, send: m => calls.push(m),
+  });
+  c.handleInput("\x1d");
+  assert.deepEqual(calls, ["detach"]);
+  calls.length = 0;
+  c.handleInput("\x1b[D");
+  assert.deepEqual(calls, empty ? ["inspect", "detach"] : ["inspect", { type: "input", data: "\x1b[D" }]);
+  calls.length = 0;
+  c.handleInput("\x07");
+  assert.deepEqual(calls, [{ type: "input", data: "\x07" }]);
+ }
+});
+
+test("narrow help wraps, bounds height, reaches every line, and retains navigation", () => {
+ const c = board();
+ const seen = new Set();
+ for (let n = 0; n < 100; n++) {
+  const lines = c.renderHelp(32);
+  assert.equal(lines.length, 18);
+  for (const line of lines) assert.ok(line.length <= 32, `overwidth: ${line}`);
+  for (const line of lines.slice(1, -1)) seen.add(line);
+  assert.equal(lines.at(-1), "esc back · ↑↓ scroll · Home/End");
+  c.handleInput("\x1b[B");
+ }
+ const full = board(); full.tui.terminal.rows = 500;
+ const allLines = full.renderHelp(32).slice(1, -1).filter(Boolean);
