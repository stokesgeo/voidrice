+ assert.throws(()=>claimHost(root,'one'),/Unknown prior/); assert(existsSync(socket));
+ rmSync(socket);
+ for(const data of ['not json', JSON.stringify({state:'alive',runnerPid:999999}), JSON.stringify({state:'exited',endedAt:1,childPid:42})]) {
+  writeFileSync(P.hostPath(root,'one'),data); assert.throws(()=>claimHost(root,'one'),/Unknown prior/);
+ }
+});
