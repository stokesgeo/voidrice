+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPromptTracker } from '../src/core/prompt-tracker.mjs';
+test('custom screen needs both recognized live tool and one-shot explicit bridge',()=>{
+ const p=createPromptTracker();
+ const arm={phase:'arm',toolName:'admin_step',toolCallId:'a'};
+ p.bridge(arm); assert.equal(p.start({kind:'custom'}),null); assert.equal(p.end(true),null);
+ p.tool({type:'tool_execution_start',toolName:'admin_step',toolCallId:'a',args:{goal:'PRIVATE'}});
+ assert.equal(p.start({kind:'custom'}),null); // generic dashboard during a tool is NOT evidence
+ p.bridge(arm);
+ assert.deepEqual(p.start({kind:'custom',title:'PRIVATE'}),{type:'ui_prompt_start'});
+ assert.deepEqual(p.end(false),{type:'ui_prompt_end',idle:false});
+ assert.equal(p.start({kind:'custom'}),null); // consumed
+ p.bridge(arm); p.tool({type:'tool_execution_end',toolCallId:'a'});
+ assert.equal(p.start({kind:'custom'}),null);
+});
+test('native select/editor attention excludes titles and unmatched ends',()=>{
+ const p=createPromptTracker();
+ for(const kind of ['select','editor']) {
+  assert.deepEqual(p.start({kind,title:'PRIVATE'}),{type:'ui_prompt_start'});
+  assert.deepEqual(p.end(true),{type:'ui_prompt_end',idle:true});
+  assert.equal(p.end(true),null);
+ }
+});
