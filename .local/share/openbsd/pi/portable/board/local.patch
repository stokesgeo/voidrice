diff --git a/src/core/attention.mjs b/src/core/attention.mjs
new file mode 100644
index 0000000..8c77915
--- /dev/null
+++ b/src/core/attention.mjs
@@ -0,0 +1,40 @@
+// Shared advisory projection. Process presence is not work, and output is not
+// an owner decision. No session text, tool arguments or inferred questions here.
+export function attention(row) {
+ const state = row.state;
+ const response = state?.response;
+ const ack = row.acknowledgement;
+ const decisions = state?.processState === "alive" ? state?.ownerDecisions ?? [] : [];
+ return {
+  working: state?.processState === "alive" && state?.semanticState === "working" && decisions.length === 0 && !state?.uiWaiting,
+  needsDecision: decisions.some(item => item.category !== "admin_terminal"),
+  terminalHandoff: decisions.some(item => item.category === "admin_terminal"),
+  uiWaiting: state?.processState === "alive" && Boolean(state?.uiWaiting),
+  unseen: Boolean(response && (!ack || ack.revision !== response.revision || ack.id !== response.id)),
+ };
+}
+
+export function attentionCounts(rows) {
+ const counts = { working: 0, decisions: 0, unseen: 0, terminal: 0, ui: 0 };
+ for (const row of rows) {
+  const item = attention(row);
+  counts.working += Number(item.working);
+  counts.decisions += Number(item.needsDecision);
+  counts.unseen += Number(item.unseen);
+  counts.terminal += Number(item.terminalHandoff);
+  counts.ui += Number(item.uiWaiting);
+ }
+ return counts;
+}
+
+export function attentionLabel(counts) {
+ return `working:${counts.working} decision:${counts.decisions} new:${counts.unseen}${counts.terminal ? ` terminal:${counts.terminal}` : ""}${counts.ui ? ` ui:${counts.ui}` : ""}`;
+}
+
+// Cooperative event, deliberately an allowlist rather than a spread of tool data.
+export function decisionEvent(event) {
+ if (!event || !["start", "end"].includes(event.phase) ||
+     !["ask_user", "admin_approval", "admin_terminal"].includes(event.category) ||
+     typeof event.id !== "string" || !/^[a-zA-Z0-9_-]{1,128}$/.test(event.id)) return null;
+ return { type: "owner_decision", category: event.category, phase: event.phase, id: event.id };
+}
