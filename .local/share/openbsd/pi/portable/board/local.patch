new file mode 100644
index 0000000..d205523
--- /dev/null
+++ b/src/core/host-claim.mjs
@@ -0,0 +1,41 @@
+// Lifetime claim, deliberately NOT an age/PID-based lease. A crashed host may
+// leave a live child; unknown claims require offline owner recovery, never theft.
+import { mkdirSync, readFileSync, writeFileSync, rmdirSync, unlinkSync, lstatSync } from "node:fs";
+import { randomUUID } from "node:crypto";
+import { ensureDir, readJson } from "./atomic.mjs";
+import * as P from "./paths.mjs";
+
+const claimPath = (root, id) => P.viewLockPath(root, id, "host");
+function present(path) {
+	try { lstatSync(path); return true; } catch (e) { if (e.code === "ENOENT") return false; throw e; }
+}
+export function claimHost(root, id) {
+	ensureDir(P.viewDir(root, id));
+	const path = claimPath(root, id);
+	try { mkdirSync(path, { mode: 0o700 }); }
+	catch (e) { if (e.code === "EEXIST") throw new Error("Host already claimed; stale/unknown ownership requires offline recovery"); throw e; }
+	const token = randomUUID();
+	// A socket or nonterminal legacy record is unknown ownership, not stale proof.
+	const host = readJson(P.hostPath(root, id), null);
+	if (present(P.controlSocketPath(root, id)) ||
+		(present(P.hostPath(root, id)) && (!host || !["exited", "failed"].includes(host.state) || host.childPid != null || !host.endedAt))) {
+		rmdirSync(path);
+		throw new Error("Unknown prior host/socket; offline recovery required");
+	}
+	writeFileSync(`${path}/token`, token, { mode: 0o600, flag: "wx" });
+	return token;
+}
+export function enterHost(root, id, token) {
+	const path = claimPath(root, id);
+	if (!token || readFileSync(`${path}/token`, "utf8") !== token) throw new Error("Host claim mismatch");
+	// Even replaying the exact launch config cannot start a second child.
+	mkdirSync(`${path}/running`, { mode: 0o700 });
+}
+export function releaseHost(root, id, token, entered = false) {
+	const path = claimPath(root, id);
+	if (readFileSync(`${path}/token`, "utf8") !== token) throw new Error("Host claim mismatch on release");
+	if (entered) rmdirSync(`${path}/running`);
+	else if (present(`${path}/running`)) throw new Error("Runner owns host claim");
+	unlinkSync(`${path}/token`);
+	rmdirSync(path);
+}
