+
+function fixture(t) { const root=mkdtempSync(join(tmpdir(),'claim-')); t.after(()=>rmSync(root,{recursive:true,force:true})); return root; }
+test('exclusive launch claim, replay refusal, orderly cleanup and restart', t=>{
+ const root=fixture(t), token=claimHost(root,'one');
+ assert.throws(()=>claimHost(root,'one'),/already claimed/);
+ assert.throws(()=>enterHost(root,'one','wrong'),/mismatch/);
+ enterHost(root,'one',token);
+ assert.throws(()=>enterHost(root,'one',token),/EEXIST/);
+ assert.throws(()=>releaseHost(root,'one',token),/Runner owns/);
+ releaseHost(root,'one',token,true);
+ const next=claimHost(root,'one'); assert.notEqual(token,next); releaseHost(root,'one',next);
+});
+test('stale, empty and malformed claims are never stolen by age or PID', t=>{
+ const root=fixture(t); mkdirSync(P.viewDir(root,'one'),{recursive:true});
+ const lock=P.viewLockPath(root,'one','host'); mkdirSync(lock);
+ for(const token of ['', '{"pid":999999,"at":0}', 'unknown']) {
+  writeFileSync(lock+'/token',token);
+  assert.throws(()=>claimHost(root,'one'),/already claimed/);
+  assert(existsSync(lock));
+ }
+});
