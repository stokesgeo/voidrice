diff --git a/test/reconcile-snapshot.test.mjs b/test/reconcile-snapshot.test.mjs
new file mode 100644
index 0000000..ad9f711
--- /dev/null
+++ b/test/reconcile-snapshot.test.mjs
@@ -0,0 +1,140 @@
+import assert from 'node:assert/strict';
+import fs, { mkdtempSync, rmSync } from 'node:fs';
+import { syncBuiltinESMExports } from 'node:module';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import * as S from '../src/core/store.mjs';
+import { createService } from '../src/runtime/service.mjs';
+import { readFollowUpQueue } from '../src/core/follow-up-queue.mjs';
+
+// Count actual roster reads, not calls to the API under test. Only the synthetic
+// root is observed; restore named builtin imports even when an assertion throws.
+function measure(root, scans, fn) {
+ const read = fs.readFileSync;
+ let actual = 0;
+ fs.readFileSync = function(path, ...args) {
+  if (path === join(root, 'roster.json')) actual++;
+  return read.call(this, path, ...args);
+ };
+ syncBuiltinESMExports();
+ try { const result = fn(); assert.equal(actual, scans, 'full roster scans'); return result; }
+ finally { fs.readFileSync = read; syncBuiltinESMExports(); }
+}
+
+function fixture(fn, options = {}) {
+ const root = mkdtempSync(join(tmpdir(), 'board-snapshot-'));
+ let launches = 0;
+ const svc = createService({ root, defaultCwd: root, runnerScript: '/never', piCommand: '/never', piArgsPrefix: [], persistentPeers: true,
+  env: { AGENT_BOARD_AUTO_STATE: 'off' }, ptySupport: () => ({ok:false}),
+  launch: () => { launches++; if (options.failLaunch) throw new Error('synthetic launch failure'); return {pid:null}; } });
+ const add = (id, extra = {}) => {
+  S.createView(root, {id, name:id, cwd:root});
+  S.writeState(root, {...S.readState(root,id), semanticState:'idle', processState:'exited', ...extra});
+ };
+ try { fn({root, svc, add, launches:() => launches}); }
+ finally { rmSync(root, {recursive:true, force:true}); }
+}
+
+test('snapshot is call-local: empty, missing, newly created and archived records', () => fixture(({root,svc,add}) => {
+ assert.deepEqual(svc.reconcileSnapshot(), {fixed:0,rows:[]});
+ S.addToRoster(root,'missing');
+ add('new');
+ assert.deepEqual(svc.reconcileSnapshot().rows.map(r=>r.meta.id), ['new']);
+ const m = S.readMeta(root,'new'); S.writeMeta(root,{...m,archived:true});
+ assert.deepEqual(svc.reconcileSnapshot().rows, []);
+ add('later');
+ assert.deepEqual(svc.reconcileSnapshot().rows.map(r=>r.meta.id), ['later']);
+}));
+
+test('crashed host recovery is visible in returned projection on the same call', () => fixture(({root,svc,add}) => {
+ add('crash',{semanticState:'working',processState:'alive'});
+ S.writeHost(root,{viewId:'crash',state:'failed',runnerPid:null,exitCode:1,error:'fixture crash'});
+ const result = measure(root,2,()=>svc.reconcileSnapshot());
+ assert.equal(result.fixed,1);
+ assert.equal(result.rows[0].state.semanticState,'failed');
+ assert.equal(result.rows[0].state.processState,'exited');
+ assert.ok(result.rows[0].state.diagnostics.errorCount > 0);
+ const reconcile = svc.reconcile;
+ assert.equal(measure(root,1,()=>reconcile()),0);
+}));
+
+test('runner recovery and queued followup dispatch refresh after both writes', () => fixture(({root,svc,add,launches}) => {
+ add('run',{currentRunId:'dead',semanticState:'working',processState:'exited'});
+ S.writeStatus(root,{viewId:'run',runId:'dead',endedAt:1,semanticState:'idle',processState:'exited',summary:'finished',lastActivityAt:1});
+ assert.equal(svc.queueFollowUp('run','synthetic continuation').ok,true);
+ const result = measure(root,3,()=>svc.reconcileSnapshot());
+ assert.equal(launches(),1);
+ assert.equal(result.fixed,2);
+ assert.equal(result.rows[0].state.semanticState,'queued');
+ assert.notEqual(result.rows[0].state.currentRunId,'dead');
+ assert.equal(result.rows[0].followUps.queuedCount,0);
+}));
+
+test('failed drain after claim/release is not a stale artifact projection', () => fixture(({root,svc,add}) => {
+ add('external');
+ const meta = S.readMeta(root,'external'); S.writeMeta(root,{...meta,sessionFile:join(root,'external.jsonl')});
+ svc.queueFollowUp('external','synthetic');
+ const result = measure(root,2,()=>svc.reconcileSnapshot());
+ assert.equal(result.fixed,0);
+ assert.equal(result.rows[0].followUps.queuedCount,1);
+ assert.ok(result.rows[0].diagnostics.warningCount > 0);
+ assert.deepEqual(result.rows[0].followUps, S.loadRow(root,'external').followUps);
+ assert.equal(readFollowUpQueue(root,'external').items[0].status,'queued');
+ assert.equal(readFollowUpQueue(root,'external').items[0].attempts,1);
+}));
+
+test('quiet snapshots and receiver-free numeric reconciliation need only one scan', () => fixture(({root,svc,add}) => {
+ for (let i=0;i<12;i++) add('v'+i);
+ const snapshot = measure(root,1,()=>svc.reconcileSnapshot());
+ assert.equal(snapshot.fixed,0);
+ assert.equal(snapshot.rows.length,12);
+ const reconcile = svc.reconcile;
+ assert.equal(measure(root,1,()=>reconcile()),0);
+}));
+
+test('launch failure releases claim, refreshes diagnostics and can retry next call', () => fixture(({root,svc,add,launches}) => {
+ add('retry');
+ svc.queueFollowUp('retry','synthetic continuation');
+ for (let attempt=1;attempt<=2;attempt++) {
+  const result = measure(root,2,()=>svc.reconcileSnapshot());
+  assert.equal(result.fixed,0);
+  assert.equal(launches(),attempt);
+  assert.equal(result.rows[0].state.semanticState,'idle');
+  assert.equal(result.rows[0].followUps.queuedCount,1);
+  assert.equal(result.rows[0].followUps.claimedCount,0);
+  assert.equal(result.rows[0].diagnostics.errorCount,attempt);
+  assert.deepEqual(result.rows[0].followUps,S.loadRow(root,'retry').followUps);
+  const item = readFollowUpQueue(root,'retry').items[0];
+  assert.equal(item.status,'queued');
+  assert.equal(item.claimedAt,null);
+  assert.equal(item.attempts,attempt);
+ }
+}, {failLaunch:true}));
+
+test('dead runner without terminal status fails once and never drains its queue', () => fixture(({root,svc,add,launches}) => {
+ // Persisted processState=alive is conservatively treated as live by the
+ // store even without a PID. Exercise the established dead-runner boundary.
+ add('lost',{currentRunId:'missing-run',semanticState:'working',processState:'exited'});
+ svc.queueFollowUp('lost','must not launch');
+ const result = measure(root,2,()=>svc.reconcileSnapshot());
+ assert.equal(result.fixed,1);
+ assert.equal(result.rows[0].state.semanticState,'failed');
+ assert.equal(result.rows[0].state.processState,'exited');
+ assert.match(result.rows[0].state.error,/Runner exited/);
+ assert.equal(result.rows[0].followUps.queuedCount,1);
+ assert.equal(launches(),0);
+ assert.deepEqual(result.rows[0].followUps,S.loadRow(root,'lost').followUps);
+ assert.equal(measure(root,1,()=>svc.reconcileSnapshot()).fixed,0);
+}));
+
+test('settlement followup launch is never overwritten by foreground snapshot reuse', () => fixture(({root,svc,add,launches}) => {
+ add('event');
+ svc.syncForegroundEvent(S.readMeta(root,'event').sessionFile,{type:'agent_start'});
+ svc.queueFollowUp('event','next');
+ svc.syncForegroundEvent(S.readMeta(root,'event').sessionFile,{type:'agent_end'});
+ const result = svc.reconcileSnapshot();
+ assert.equal(launches(),1);
+ assert.equal(result.rows[0].state.semanticState,'queued');
+ assert.equal(result.rows[0].followUps.queuedCount,0);
+}));
