+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { createServer } from 'node:net';
+import { once } from 'node:events';
+import { join } from 'node:path';
+import { createService } from '../src/runtime/service.mjs';
+import { createView, writeHost, writeState } from '../src/core/store.mjs';
+
+for (const scenario of [
+ {name:'explicit persistent peers bypass TTL and pool pruning', persistentPeers:true, age:660000, env:{}, count:6, expected:0},
+ {name:'upstream default still prunes expired idle hosts', age:660000, env:{}, count:1, expected:1},
+ {name:'upstream default still prunes excess warm hosts', age:0, env:{}, count:5, expected:1},
+ {name:'scoped warm pool and TTL settings override global defaults', age:660000, env:{AGENT_BOARD_MAX_WARM_HOSTS:'10',AGENT_BOARD_WARM_HOST_TTL_MS:'0'}, count:6, expected:0},
+ {name:'scoped legacy warm settings work', age:660000, env:{AGENT_VIEW_MAX_WARM_HOSTS:'10',AGENT_VIEW_WARM_HOST_TTL_MS:'0'}, count:6, expected:0},
+]) test(scenario.name,async()=>{
+ const root=mkdtempSync('/tmp/ab-warm.');const messages=[];const sockets=new Set();
+ const server=createServer(socket=>{sockets.add(socket);socket.on('close',()=>sockets.delete(socket));let buf='';socket.on('data',data=>{buf+=data;let i;while((i=buf.indexOf('\n'))>=0){messages.push(JSON.parse(buf.slice(0,i)));buf=buf.slice(i+1);}});});
+ try {
+  const socketPath=join(root,'probe.sock');server.listen(socketPath);await once(server,'listening');
+  for(let n=0;n<scenario.count;n++) {
+   const id='idle-'+n;createView(root,{id,name:id,cwd:root});
+   writeState(root,{viewId:id,semanticState:'idle',processState:'idle',lastActivityAt:Date.now()-scenario.age});
+   writeHost(root,{viewId:id,state:'alive',runnerPid:process.pid,socketPath,attachedClients:0,startedAt:Date.now()-scenario.age});
+  }
+  const next=createView(root,{id:'trigger',name:'trigger',cwd:root});writeFileSync(next.sessionFile,'');
+  const service=createService({root,env:scenario.env,persistentPeers:scenario.persistentPeers,defaultCwd:root,
+   piCommand:process.execPath,piArgsPrefix:[],runnerScript:'unused',ptySupport:()=>({ok:true}),launchHost:()=>({pid:null})});
+  assert.equal(service.ensureHost(next.id).ok,true);
+  // Socket delivery is asynchronous under full-suite load; bound observation,
+  // rather than assuming a fixed scheduling delay. No real TTL wait.
+  const until=Date.now()+5000;
+  do { await new Promise(r=>setTimeout(r,25)); }
+  while(Date.now()<until && messages.filter(m=>m.type==='terminate').length<scenario.expected);
+  if(scenario.expected===0) await new Promise(r=>setTimeout(r,200));
+  assert.equal(messages.filter(m=>m.type==='terminate').length,scenario.expected);
+ } finally {for(const socket of sockets)socket.destroy();await new Promise(r=>server.close(r));rmSync(root,{recursive:true,force:true});}
+});
