+test('runtime boundary accepts verified API under its own name; refuses version/API/identity/ABI drift without workspace writes', () => {
+ const home = mkdtempSync('/tmp/board-compat.');
+ const runtime = realpathSync(join(process.env.HOME, '.local/share/vertrice-pi/current'));
+ const c = compatibility;
+ const generation = join(home, '.local/share/vertrice-pi/generations/local-patch-not-a-pin');
+ const modules = join(generation, 'node_modules');
+ const pkg = join(modules, '@earendil-works/pi-coding-agent');
+ const put = (path, text) => { mkdirSync(dirname(path), { recursive: true }); writeFileSync(path, text); };
+ try {
+  for (const file of new Set([...Object.keys(c.apiFiles), ...Object.keys(c.executedRuntime.files)])) {
+   const path = join(modules, file); mkdirSync(dirname(path), { recursive: true }); symlinkSync(join(runtime, 'node_modules', file), path);
+  }
+  const packageJson = version => JSON.stringify({ version, ...c.executedRuntime.packageRouting });
+  for (const [name, version] of Object.entries(c.packages)) put(join(modules, name, 'package.json'), name === '@earendil-works/pi-coding-agent' ? packageJson(version) : JSON.stringify({ version }));
+  mkdirSync(join(modules, '.bin'));
+  symlinkSync('../' + c.executedRuntime.bin, join(modules, '.bin/pi'));
+  const cli = join(modules, c.executedRuntime.bin);
+  symlinkSync('generations/local-patch-not-a-pin', join(home, '.local/share/vertrice-pi/current'));
+  const before = JSON.stringify(process.env);
+  assert.equal(assertCompatibility(home, { hostPackage: pkg, hostEntry: cli }).generation, generation);
+  // Unrelated local patch bytes do not alter the qualified API envelope.
+  put(join(pkg, 'local-presentation-patch.txt'), 'benign fixture delta');
+  assert.equal(assertCompatibility(home).cli, cli);
+  assert.throws(() => assertCompatibility(home, { hostPackage: pkg }), /loaded Pi entry differs/);
+  put(join(pkg, 'dist/cli.js'), '// unreviewed alternate child entry');
+  assert.throws(() => assertCompatibility(home, { hostPackage: pkg, hostEntry: join(pkg, 'dist/cli.js') }), /loaded Pi entry differs/);
+  for (const file of [c.executedRuntime.bin, '@earendil-works/pi-coding-agent/dist/bundle/cli-runtime.js', Object.keys(c.executedRuntime.files).find(p => p.includes('/chunks/'))]) {
+   const path = join(modules, file), bytes = readFileSync(path);
+   unlinkSync(path); put(path, Buffer.concat([bytes, Buffer.from('\n// unqualified executed delta\n')]));
+   assert.throws(() => assertCompatibility(home), /unqualified executed runtime/);
+   writeFileSync(path, bytes);
+  }
+  unlinkSync(join(modules, '.bin/pi')); symlinkSync('../@earendil-works/pi-coding-agent/dist/cli.js', join(modules, '.bin/pi'));
+  assert.throws(() => assertCompatibility(home), /native bin route changed/);
+  unlinkSync(join(modules, '.bin/pi')); symlinkSync('../' + c.executedRuntime.bin, join(modules, '.bin/pi'));
+  put(join(pkg, 'package.json'), JSON.stringify({ version: c.piVersion, type: 'module', bin: { pi: 'dist/cli.js' } }));
+  assert.throws(() => assertCompatibility(home), /entry routing changed/);
+  put(join(pkg, 'package.json'), packageJson(c.piVersion));
+  assert.throws(() => assertCompatibility(home, { hostPackage: join(runtime, 'node_modules/@earendil-works/pi-coding-agent') }), /loaded Pi and selected child runtime differ/);
+  assert.throws(() => inlineOptions(home), /requires loaded Pi package identity/);
+  for (const version of ['1.5.2', '1.6.1', '2.0.0', '1.6.0-local']) {
+   put(join(pkg, 'package.json'), packageJson(version));
+   assert.throws(() => assertCompatibility(home), /version changed/);
+  }
+  put(join(pkg, 'package.json'), packageJson(c.piVersion));
+  for (const [name, version] of Object.entries(c.packages)) {
+   if (name === '@earendil-works/pi-coding-agent') continue;
+   const path = join(modules, name, 'package.json');
+   put(path, JSON.stringify({ version: '1.5.2' }));
+   assert.throws(() => assertCompatibility(home), /version changed/);
+   put(path, JSON.stringify({ version }));
+  }
+  const api = join(pkg, 'dist/core/extensions/types.d.ts');
+  const bytes = readFileSync(api); unlinkSync(api); put(api, Buffer.concat([bytes, Buffer.from('\n// incompatible fixture\n')]));
+  assert.throws(() => assertCompatibility(home), /unqualified API\/layout/);
+  writeFileSync(api, bytes);
+  const descriptor = Object.getOwnPropertyDescriptor(process.versions, 'modules');
+  try {
+   Object.defineProperty(process.versions, 'modules', { value: '999', configurable: true });
+   assert.throws(() => assertCompatibility(home), /platform\/Node ABI/);
+  } finally { Object.defineProperty(process.versions, 'modules', descriptor); }
+  assert.equal(JSON.stringify(process.env), before);
+  assert.throws(() => readFileSync(join(home, '.local/state/pi-agent-board')), /ENOENT/);
+ } finally { rmSync(home, { recursive: true, force: true }); }
+});
