+ await Promise.resolve(); assert.equal(marked.length, 0, 'modal invalidates queued visit');
+ assert.match(c.render(80).join('\n'), /RENDERED RESPONSE BODY/);
+ snapshot = { revision: 2, id: 'late' };
+ await Promise.resolve(); assert.deepEqual(marked, [{ revision: 1, id: 'rendered' }]);
