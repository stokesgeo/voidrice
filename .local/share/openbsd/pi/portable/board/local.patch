+  theme, focusGeneration: 0, receivedOutput: true, connected: true, status: 'attached', acknowledgementNotice: '',
+  resizeIfNeeded() {}, bodyHeight: () => 3, project: () => ['RENDERED RESPONSE BODY'], scheduleRender() {},
+  opts: { title: 'fixture', responseSnapshot: () => snapshot, markSeen: response => { marked.push(response); return { ok: !fail }; } },
+ });
+ c.render(80); await Promise.resolve(); assert.equal(marked.length, 0, 'background');
+ c.focused = true; c.connected = false;
+ c.render(80); await Promise.resolve(); assert.equal(marked.length, 0, 'disconnected');
+ c.connected = true; c.receivedOutput = false; c.renderLoading = () => ['loading'];
+ c.render(80); await Promise.resolve(); assert.equal(marked.length, 0, 'loading');
