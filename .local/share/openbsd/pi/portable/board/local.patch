--- /dev/null
+++ b/src/core/prompt-tracker.mjs
@@ -0,0 +1,32 @@
+// Pi coalesces nested UI into an outer span and does not expose a custom UI's
+// origin. Custom attention therefore needs a cooperative, one-shot bridge in
+// addition to a recognized executing tool. Never retain titles/args/results.
+export function createPromptTracker() {
+	const tools = new Map();
+	let armed = null;
+	let waiting = false;
+	return {
+		tool(event) {
+			if (event.type === "tool_execution_start" && ["ask_user", "admin_step"].includes(event.toolName)) tools.set(event.toolCallId, event.toolName);
+			if (event.type === "tool_execution_end") {
+				tools.delete(event.toolCallId);
+				if (armed?.toolCallId === event.toolCallId) armed = null;
+			}
+		},
+		bridge(event) {
+			if (event?.phase === "arm" && tools.get(event.toolCallId) === event.toolName && ["ask_user", "admin_step"].includes(event.toolName)) {
+				armed = { toolCallId: event.toolCallId, toolName: event.toolName };
+			} else if (event?.phase === "disarm") armed = null;
+		},
+		start(event) {
+			waiting = event.kind !== "custom" || armed !== null;
+			armed = null;
+			return waiting ? { type: "ui_prompt_start" } : null;
+		},
+		end(idle) {
+			const result = waiting ? { type: "ui_prompt_end", idle } : null;
+			waiting = false;
+			return result;
+		},
+	};
+}
