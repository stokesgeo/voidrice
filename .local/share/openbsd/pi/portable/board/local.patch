+  assert.deepEqual(resolvePiInvocation(), { piCommand: process.execPath, piArgsPrefix: [argv[1], ...flags] });
+  process.argv = [process.execPath, argv[1], ...flags, '--session', '/child-session'];
+  assert.deepEqual(resolvePiInvocation().piArgsPrefix, [argv[1], ...flags]);
+  for (const invalid of ['', 'null', '{}', 'pi -e x', JSON.stringify(['-e', board]), JSON.stringify([...flags, '--resume']), JSON.stringify(['--no-extensions', '-e', '/fixture.ts'])]) {
+   process.env.AGENT_BOARD_PI_ARGS = invalid;
