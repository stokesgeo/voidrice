#!/bin/sh

# mount(8) mock. With no arguments it lists $VT_STATE/mounts, created from
# the defaults below on first use, in mount(8)'s form "/dev/sd1a on / type
# ffs (local)" (known). With arguments it logs the call and succeeds, or
# exits with $VT_STATE/rc.mount. A lone "DUID.part" argument (an fstab
# lookup) succeeds only if that line is in $VT_STATE/fstab.

f=$VT_STATE/mounts
[ -f "$f" ] || cat >"$f" <<'EOF'
/dev/sd1a on / type ffs (local)
/dev/sd1k on /home type ffs (local, nodev, nosuid)
/dev/sd1d on /tmp type ffs (local, nodev, nosuid)
/dev/sd1f on /usr type ffs (local, nodev, wxallowed)
/dev/sd1e on /var type ffs (local, nodev, nosuid)
EOF

[ $# -eq 0 ] && { cat "$f"; exit 0; }
echo "mount $*" >>"$VT_STATE/log"
if [ $# -eq 1 ]; then
	case $1 in
	[0-9a-f]*.[a-p])
		grep -qx -- "$1" "$VT_STATE/fstab" 2>/dev/null || {
			echo "mount: can't find fstab entry for $1." >&2; exit 1; }
		;;
	esac
fi
exit "$(cat "$VT_STATE/rc.mount" 2>/dev/null || echo 0)"
