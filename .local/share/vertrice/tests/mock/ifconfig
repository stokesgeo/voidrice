#!/bin/sh

# ifconfig(8) mock: prints $VT_STATE/ifconfig, else the X220 below: wired
# em0 unplugged, iwn0 joined at 71%, wg0 up. The layout follows ifconfig(8)
# output on OpenBSD 7.x (known in outline: the flags line, "media:",
# "status:", and the "ieee80211: join ... NN% ..." line; the exact order of
# the words after the signal is from memory).

if [ -f "$VT_STATE/ifconfig" ]; then cat "$VT_STATE/ifconfig"; exit 0; fi
cat <<'EOF'
lo0: flags=2008049<UP,LOOPBACK,RUNNING,MULTICAST,LRO> mtu 32768
	index 3 priority 0 llprio 3
	groups: lo
	inet 127.0.0.1 netmask 0xff000000
em0: flags=8802<BROADCAST,SIMPLEX,MULTICAST> mtu 1500
	lladdr f0:de:f1:00:00:01
	index 1 priority 0 llprio 3
	media: Ethernet autoselect (none)
	status: no carrier
iwn0: flags=a48843<UP,BROADCAST,RUNNING,SIMPLEX,MULTICAST,INET6_NOPRIVACY,AUTOCONF6TEMP,AUTOCONF4> mtu 1500
	lladdr 00:24:d7:00:00:02
	index 2 priority 4 llprio 3
	groups: wlan egress
	media: IEEE802.11 autoselect (OFDM54 mode 11g)
	status: active
	ieee80211: join homenet chan 6 bssid 00:11:22:33:44:55 71% wpakey wpaprotos wpa2 wpaakms psk wpaciphers ccmp wpagroupcipher ccmp
	inet 192.168.1.20 netmask 0xffffff00 broadcast 192.168.1.255
wg0: flags=80c3<UP,BROADCAST,RUNNING,NOARP,MULTICAST> mtu 1420
	index 5 priority 0 llprio 3
	wgport 51820
	groups: wg
EOF
