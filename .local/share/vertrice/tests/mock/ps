#!/bin/sh

# ps(1) mock. `ps -U UID -o tty=` (theme, finding your terminals) prints
# $VT_STATE/ttys: one terminal per line as ps(1) names them, "ttyp3" for
# /dev/ttyp3, "ttyC0" for the console, "??" for none, each padded to eight
# (bin/ps: the tty keyword is devname(3) printed "%-8s"; tt drops "tty").
# Anything else goes to the real ps, which sbar and sb-refresh use to look
# at a live pid.

case $* in
*tty=*) cat "$VT_STATE/ttys" 2>/dev/null ;;
*) exec "$VT_REAL_PS" "$@" ;;
esac
