# cases: the tests for @NAME@, read by tests/run. Not a script of its
# own: run sources it (the . command), so these functions join run's.
#
# A case is a function named t_SOMETHING. It runs in a scratch directory
# ($T), with $prog as the full path of @NAME@. It passes when it returns
# 0; every check is `... || return 1`, so the first failure ends it.
#
# The pattern for each case: set up input, run $prog, capture what it
# printed ($(...) takes standard output; 2>&1 adds errors) and its exit
# status ($? right after), compare with eq.

# This one tests the skeleton: an unknown option prints the usage line on
# standard error and exits 1. Keep it true as the script grows.
t_usage() {
	# Redirections apply left to right: 2>&1 points errors where
	# standard output goes now (into $out), then >/dev/null sends
	# standard output away. So $out holds only what went to stderr.
	out=$("$prog" -Z 2>&1 >/dev/null)
	eq "exit status" 1 "$?" || return 1
	case $out in
	*"usage: @NAME@"*) ;;
	*) fail "no usage line on standard error: $out" || return 1 ;;
	esac
}

