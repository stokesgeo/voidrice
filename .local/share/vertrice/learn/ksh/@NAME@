#!/bin/ksh

# @NAME@: say in one line what this script does.
#
# usage: @NAME@ [-v] [file ...]
#
# The comments below say what each line is for; delete them as the lines
# become obvious. ksh(1) is the reference for everything here, and
# /usr/sbin/sysupgrade and /etc/rc are real scripts in this style (more
# in ~/.local/share/vertrice/learn/reading).
#
# Lines starting "# shellcheck" are for shellcheck, a linter from
# packages. This one, before the first command, holds for the whole file:
# it stops the warning that verbose is set but not used, which stays true
# until you write the code that reads it.
# shellcheck disable=SC2034

# set -u: expanding a variable that was never set is an error, and the
# script stops. It catches misspelt names ($fiel for $file) where the shell
# would otherwise quietly give an empty string. What it does not catch: a
# variable that is set but empty (x= passes). What it costs: a missing
# argument is an error too, so write ${1-} ("$1, or nothing if unset")
# where an argument may be absent, and ${x:-default} for a fallback. "$@"
# with no arguments is fine under set -u in OpenBSD's ksh.
#
# There is no set -e here, on purpose: it is skipped inside functions
# called from `if`, `&&` and `||`, so it protects less than it seems.
# Check the commands that matter yourself: cmd || exit 1.
set -u

# A function, in the POSIX form (ksh also has `function name {`; ksh(1)
# says how the two differ). print -u2 writes to standard error (file descriptor 2), where
# messages belong, so they do not mix into the output. ${0##*/} is the
# script's name without its directory: ## removes the longest match of
# "*/" from the front.
usage() {
	print -u2 "usage: ${0##*/} [-v] [file ...]"
	exit 1
}

# getopts reads the options one letter at a time into $opt. "v" is the
# list of letters it accepts; "v:" would mean -v takes an argument, found
# in $OPTARG. An unknown letter gives "?", which ends in usage.
verbose=0
while getopts v opt; do
	case $opt in
	v)	verbose=1 ;;
	*)	usage ;;
	esac
done
# OPTIND is the number of the first argument that is not an option; shift
# drops the options, so "$@" is now only the operands (the files).
shift $((OPTIND - 1))

